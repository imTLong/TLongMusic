            window.TLongPlayer.isPlaying = true;
            updatePlayPauseButton();
        }).catch((err) => {
            console.warn("Direct audio play note:", err);
            startBeatSynthesizer();
            window.TLongPlayer.isPlaying = true;
            updatePlayPauseButton();
        });

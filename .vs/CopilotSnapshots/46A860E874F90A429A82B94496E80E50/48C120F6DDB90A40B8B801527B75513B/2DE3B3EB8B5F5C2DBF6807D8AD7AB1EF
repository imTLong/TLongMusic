@model TLongMusic.Models.EditProfileViewModel
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="me-3">
                            <img id="avatarPreview" src="@(Model.AvatarUrl ?? "/images/logo.png")" alt="Avatar" class="rounded-circle" style="width:96px; height:96px; object-fit:cover; border:3px solid #f8f9fa; box-shadow:0 4px 18px rgba(0,0,0,0.15);" />
                        </div>
                        <div>
                            <h4 class="mb-0">@Model.FullName</h4>
                            <small class="text-muted">@Model.Username</small>
                        </div>
                        <div class="ms-auto text-end">
                            <a class="btn btn-outline-secondary btn-sm" href="/">← Quay về</a>
                        </div>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-5">
                                <div class="card border-0 bg-light p-3 text-center">
                                    <h6 class="mb-3">Hình đại diện</h6>
                                    <img id="avatarPreviewCard" src="@(Model.AvatarUrl ?? "/images/logo.png")" alt="Avatar" class="rounded-circle mb-3" style="width:140px; height:140px; object-fit:cover;" />
                                    <div class="mb-2">
                                        <label asp-for="AvatarUrl" class="form-label small">URL Avatar</label>
                                        <input asp-for="AvatarUrl" class="form-control form-control-sm" placeholder="https://.../avatar.jpg" />
                                        <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                                    </div>
                                    <div class="d-flex justify-content-center gap-2">
                                        <button type="button" id="clearAvatarBtn" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        <button type="button" id="restoreDefaultAvatar" class="btn btn-sm btn-outline-primary">Mặc định</button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-7">
                                <div class="card border-0 p-3">
                                    <div class="mb-3">
                                        <label class="form-label">Tên đăng nhập</label>
                                        <input class="form-control" value="@Model.Username" disabled />
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                                        <input asp-for="FullName" class="form-control" />
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label">Email</label>
                                        <input asp-for="Email" class="form-control" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                                        <input asp-for="PhoneNumber" class="form-control" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                    </div>

                                    <hr />
                                    <h6 class="mb-3">Đổi mật khẩu (tùy chọn)</h6>
                                    <div class="mb-3">
                                        <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                                        <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                                            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ConfirmNewPassword" class="form-label">Xác nhận mật khẩu</label>
                                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" />
                                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2 mt-4">
                                        <a href="/" class="btn btn-outline-secondary">Hủy</a>
                                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="text-center mt-3 text-muted small">Bạn có thể thay đổi tất cả thông tin có thể chỉnh sửa ở đây. Vai trò và trạng thái tài khoản quản lý bởi Admin.</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
            const avatarInput = document.getElementById('AvatarUrl');
            const preview = document.getElementById('avatarPreview');
            const previewCard = document.getElementById('avatarPreviewCard');
            const clearBtn = document.getElementById('clearAvatarBtn');
            const restoreBtn = document.getElementById('restoreDefaultAvatar');

            function setPreview(url){
                const src = url && url.trim() ? url.trim() : '/images/logo.png';
                if(preview) preview.src = src;
                if(previewCard) previewCard.src = src;
            }

            if(avatarInput){
                avatarInput.addEventListener('input', e => setPreview(e.target.value));
            }
            if(clearBtn){
                clearBtn.addEventListener('click', () => { if(avatarInput) { avatarInput.value = ''; setPreview(''); } });
            }
            if(restoreBtn){
                restoreBtn.addEventListener('click', () => { if(avatarInput) { avatarInput.value = '/images/logo.png'; setPreview('/images/logo.png'); } });
            }
        })();
    </script>
}

@{
    ViewData["Title"] = "Đăng Tải Nonstop Dài (Set Mix) - Studio Producer - TLongMusic";
}

<div class="container-fluid px-3 px-xl-5 py-4" style="max-width: 1720px;">
    <!-- HEADER HERO PRODUCER STUDIO -->
    <div class="p-4 p-md-5 rounded-4 mb-4 position-relative overflow-hidden border border-warning border-opacity-50"
         style="background: linear-gradient(135deg, rgba(255, 209, 102, 0.12) 0%, rgba(15, 16, 28, 0.96) 100%); backdrop-filter: blur(25px); box-shadow: 0 0 50px rgba(255, 209, 102, 0.2);">
        
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 position-relative" style="z-index: 2;">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.75rem;">
                        <i class="fas fa-fire-flame-curved me-1"></i> NGHIỆP VỤ 2: ĐĂNG TẢI NONSTOP DÀI (30 - 90 PHÚT)
                    </span>
                    <span class="badge bg-dark border border-secondary text-info small" id="producerStudioRoleBadge">
                        <i class="fas fa-certificate text-warning me-1"></i> Nghệ Sĩ Đã Xác Thực
                    </span>
                </div>
                <h2 class="text-white fw-bold mb-1 display-6">STUDIO ĐĂNG TẢI NONSTOP</h2>
                <p class="text-dim mb-2" style="max-width: 820px;">
                    Dành riêng cho <strong>Nonstop / Set Mix dài (30 - 90 phút)</strong>: Tải lên mượt mà các file dung lượng lớn (100MB - 500MB). <strong>Hoàn toàn không cần quét Key & BPM</strong>, tự động gắn nhãn SET MIX.
                </p>
                <div class="d-flex flex-wrap align-items-center gap-3 text-dim small" id="producerHeaderInfo">
                    <span id="producerStudioStageName"><i class="fas fa-user-tie text-warning me-1"></i> DJ / Producer: <strong>Đang nạp...</strong></span>
                    <span id="producerStudioBankSnippet"><i class="fas fa-wallet text-info me-1"></i> STK nhận tiền: <strong>Đang nạp...</strong></span>
                </div>
            </div>

            <!-- NÚT CHUYỂN NHANH QUA TRANG TRACK -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a href="/Producer/UploadTrack" class="btn btn-outline-info rounded-pill px-3 py-2 fw-bold shadow" style="border-width: 2px;">
                    <i class="fas fa-compact-disc me-1 text-info"></i> 👉 Chuyển Sang Trang Đăng Track Lẻ
                </a>
                <a href="/Profile" class="btn btn-outline-light rounded-pill px-3 py-2">
                    <i class="fas fa-pen-to-square me-1"></i> Đổi STK
                </a>
                <a href="/" class="btn btn-glass-crystal rounded-pill px-3 py-2 text-white">
                    <i class="fas fa-arrow-left me-1"></i> Về Trang Chủ
                </a>
            </div>
        </div>
    </div>

    <!-- MAIN TWO COLUMNS LAYOUT -->
    <div class="row g-4 mb-5">
        <!-- CỘT 1: FORM ĐĂNG TẢI NONSTOP MỚI -->
        <div class="col-xl-6 col-lg-6">
            <div class="p-4 rounded-4 border border-warning border-opacity-25 h-100"
                 style="background: rgba(18, 19, 32, 0.95); backdrop-filter: blur(25px); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
                
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                    <span class="badge p-2 fs-5 rounded-circle" style="background: #ffd166; color: #000; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="fas fa-fire-flame-curved fs-5"></i>
                    </span>
                    <div>
                        <h5 class="text-white fw-bold mb-0" style="letter-spacing: 0.5px; font-size: 1.15rem;">ĐĂNG TẢI BẢN NONSTOP DÀI</h5>
                        <small class="text-dim" style="font-size: 0.85rem;">Phân loại Nonstop Lọt / Nonstop Nhóm / Nonstop Slot • Không cần đọc Key và BPM</small>
                    </div>
                </div>

                <form id="producerNonstopUploadForm" method="post" enctype="multipart/form-data" onsubmit="event.preventDefault(); submitProducerNonstopUpload(this);">
                    <input type="hidden" name="sourceType" value="DirectFile" />
                    <input type="hidden" name="durationSeconds" id="nonstopDurationInput" value="3600" />
                    <input type="hidden" name="type" value="Nonstop" />
                    <!-- ÉP CỨNG BPM = 0 VÀ KEY = Nonstop CHO NONSTOP -->
                    <input type="hidden" name="bpm" value="0" />
                    <input type="hidden" name="musicalKey" value="Nonstop" />
                    <input type="file" id="nonstopAudioFileInput" name="audioFile" accept="audio/*,.mp3,.wav,.flac,.m4a,.ogg" class="d-none" onchange="handleNonstopAudioFileSelect(this)" />

                    <!-- DROP ZONE FILE NONSTOP -->
                    <div class="mb-4">
                        <!-- Khi chưa chọn file -->
                        <div class="p-4 text-center rounded-4 border border-secondary border-opacity-50" 
                             id="nonstopAudioDropZone"
                             style="background: rgba(255, 209, 102, 0.03); border: 2px dashed rgba(255, 209, 102, 0.3) !important; cursor: pointer; transition: all 0.3s ease;"
                             onclick="document.getElementById('nonstopAudioFileInput').click()">
                            <i class="fas fa-cloud-arrow-up text-warning fa-3x mb-3" style="filter: drop-shadow(0 0 10px rgba(255, 209, 102, 0.5));"></i>
                            <h6 class="text-white fw-bold mb-1">Bấm để chọn file Nonstop dài hoặc kéo thả vào đây</h6>
                            <small class="text-dim d-block mb-3">Hỗ trợ các file set mix dài: <strong>MP3 (320kbps), WAV Lossless (24-bit), FLAC</strong> (Tối đa 500MB)</small>
                            <span class="btn btn-sm btn-outline-warning rounded-pill px-4 py-2 fw-bold">
                                <i class="fas fa-folder-open me-1"></i> Chọn File Nonstop Từ Máy Tính
                            </span>
                        </div>

                        <!-- Khung thông tin file khi đã chọn -->
                        <div id="nonstopFileSelectedInfo" class="d-none p-3 rounded-3" style="background: #141622; border: 1px solid rgba(255, 209, 102, 0.25);">
                            <div class="d-flex align-items-center justify-content-between p-1">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background: rgba(255, 209, 102, 0.2); width: 44px; height: 44px;">
                                        <i class="fas fa-fire-flame-curved text-warning fs-3"></i>
                                    </div>
                                    <div>
                                        <div class="text-white fw-bold fs-6 mb-1" id="nonstopSelectedFileName">filename.mp3</div>
                                        <small class="text-dim" id="nonstopSelectedFileSize">0 MB • audio/mpeg</small>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm px-3 py-1 rounded-2" onclick="clearNonstopSelectedAudioFile();" style="border: 1px solid rgba(239, 68, 68, 0.5); color: #ef4444; background: transparent;">
                                    ✕ Đổi file khác
                                </button>
                            </div>

                            <audio id="nonstopAudioPreviewElement" controls class="w-100 mt-3 d-none" style="border-radius: 20px; outline: none;"></audio>

                            <!-- THÔNG BÁO NONSTOP (KHÔNG ĐỌC KEY & BPM) -->
                            <div class="mt-3 p-3 rounded-3" style="background: #0c0d14; border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">
                                            <i class="fas fa-layer-group me-1"></i> NONSTOP SET MIX
                                        </span>
                                        <span class="badge border py-1.5 px-3 text-white font-monospace rounded-pill" id="nonstopDetectedDurationBadge" style="font-size: 0.85rem; background: #1e2029; border-color: rgba(255, 255, 255, 0.15) !important;">
                                            Thời lượng: Đang tính...
                                        </span>
                                    </div>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1 small">
                                        ✓ Tải siêu tốc
                                    </span>
                                </div>
                                <small class="text-dim d-block mt-2" style="font-size: 0.78rem;">
                                    <i class="fas fa-check-circle text-warning me-1"></i> Bản Nonstop được hệ thống tối ưu xử lý luồng lớn, bỏ qua quét Key & BPM để đảm bảo trình duyệt luôn mượt mà.
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- METADATA FIELDS -->
                    <div class="row g-3">
                        <!-- Hàng 1 -->
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white small">Tiêu Đề Bản Nonstop: <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="nonstopTitleInput" class="form-control bg-dark text-white border-secondary" placeholder="Ví dụ: Nonstop Vinahouse 2026 - Đẳng Cấp Dân Bay (DJ TLong)..." required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white small">Nghệ Sĩ / DJ Mix: <span class="text-danger">*</span></label>
                            <input type="text" name="artist" id="nonstopArtistInput" class="form-control bg-dark text-white border-secondary" value="DJ TLong (Producer)" required />
                        </div>

                        <!-- Hàng 2: Thể loại -->
                        <div class="col-12 col-md-12">
                            <label class="form-label text-white small">Thể Loại Nonstop:</label>
                            <select name="genre" id="nonstopGenreSelect" class="form-select bg-dark text-white border-secondary">
                                <option value="Vinahouse" selected>Vinahouse Việt Mix</option>
                                <option value="Electro House">Electro House Set</option>
                                <option value="Melbourne Bounce">Melbourne Bounce Nonstop</option>
                                <option value="Progressive House">Progressive House Mixtape</option>
                                <option value="Dubplate / VIP">Dubplate VIP Mix</option>
                                <option value="Trance">Trance Journey</option>
                            </select>
                        </div>

                        <!-- Hàng 3: Phân cấp Nonstop & Chất lượng -->
                        <div class="col-12 col-md-6">
                            <label class="form-label text-white small">Phân Cấp Nonstop (Chỉ nhận gói Nonstop): <span class="text-danger">*</span></label>
                            <select name="categoryCode" id="nonstopCategorySelect" class="form-select bg-dark text-white border-secondary" required>
                                <option value="NonstopLot">🎵 Nonstop Lọt (Khách nghe full miễn phí, Tải Free)</option>
                                <option value="NonstopNhom" selected>💎 Nonstop Nhóm (Standard & Premium VIP tải được)</option>
                                <option value="NonstopSlot">👑 Nonstop Slot / Bản Đặt VIP (Chỉ Premium tải, Demo 30s)</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-white small">Chất Lượng Âm Thanh Công Bố:</label>
                            <select name="qualityAvailable" id="nonstopQualitySelect" class="form-select bg-dark text-white border-secondary">
                                <option value="MP3 320kbps">MP3 320kbps (Chuẩn phòng thu)</option>
                                <option value="WAV Lossless 24-Bit">WAV Lossless 24-Bit (Master Club)</option>
                                <option value="FLAC 24-Bit Lossless">FLAC 24-Bit Lossless</option>
                            </select>
                        </div>

                        <!-- Hàng 4: Ảnh bìa Nonstop -->
                        <div class="col-12">
                            <label class="form-label text-white small">Ảnh Bìa Nonstop (Cover Art - Tùy chọn):</label>
                            <div class="input-group">
                                <input type="file" name="coverFile" accept="image/*" class="form-control bg-dark text-white border-secondary" />
                                <input type="url" name="coverUrl" class="form-control bg-dark text-white border-secondary" placeholder="Hoặc dán URL ảnh https://..." />
                            </div>
                        </div>
                    </div>

                    <!-- FOOTER ACTIONS -->
                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill text-white" onclick="clearNonstopSelectedAudioFile(); document.getElementById('producerNonstopUploadForm').reset();" style="background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.2);">
                            Hủy bỏ
                        </button>
                        <button type="submit" id="nonstopUploadSubmitBtn" class="btn px-4 py-2 rounded-pill fw-bold text-white shadow" style="background: linear-gradient(135deg, #ffd166, #ff9f1c); color: #000 !important; border: none;">
                            <i class="fas fa-cloud-arrow-up me-2"></i> Đăng Bản Nonstop Vào Kho Nhạc
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- CỘT 2: KHO BẢN NONSTOP CÁ NHÂN CỦA PRODUCER -->
        <div class="col-xl-6 col-lg-6">
            <div class="p-4 rounded-4 border border-secondary border-opacity-25 h-100"
                 style="background: rgba(18, 19, 32, 0.95); backdrop-filter: blur(25px); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
                
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                    <div>
                        <h5 class="text-white fw-bold mb-0">
                            <i class="fas fa-fire-flame-curved text-warning me-2"></i>Kho Bản Nonstop Đã Đăng Của Bạn
                        </h5>
                        <small class="text-dim">Chỉ hiển thị các bản Nonstop dài (30 - 90 phút) do chính bạn tải lên</small>
                    </div>
                    <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill" id="producerNonstopsCountBadge">
                        0 bản Nonstop
                    </span>
                </div>

                <div class="table-responsive rounded-4 border border-secondary border-opacity-25" id="producerNonstopsTableContainer">
                    <div class="p-5 text-center text-dim">
                        <i class="fas fa-spinner fa-spin fa-2x mb-2 text-warning"></i>
                        <br />Đang tải danh sách bản Nonstop cá nhân...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let nonstopAudioFile = null;

    document.addEventListener('DOMContentLoaded', function() {
        // Phân quyền Producer chặt chẽ
        setTimeout(function() {
            const user = window.TLongPlayer ? window.TLongPlayer.currentUser : null;
            if (!user) {
                fetch('/Auth/Me').then(r => r.json()).then(data => {
                    const u = data.user;
                    if (!data.success || (!u)) {
                        alert("⚠️ Vui lòng đăng nhập tài khoản Producer!");
                        window.location.href = '/';
                    } else if (u.primaryRole === 'Admin' || u.role === 'Admin') {
                        alert("⚠️ THÔNG BÁO:\nTài khoản Admin chỉ quản trị hệ thống, KHÔNG có quyền đăng nhạc!\nChức năng đăng nhạc chỉ dành riêng cho Producer.");
                        window.location.href = '/Admin';
                    } else if (u.primaryRole !== 'Producer' && u.role !== 'Producer') {
                        alert("⚠️ CẢNH BÁO BẢO MẬT:\nKhu vực Studio đăng nhạc chỉ dành riêng cho Nhà Sản Xuất (Producer)!");
                        window.location.href = '/';
                    } else {
                        initProducerNonstopStudio(u);
                    }
                }).catch(() => {
                    window.location.href = '/';
                });
            } else if (user.primaryRole === 'Admin' || user.role === 'Admin') {
                alert("⚠️ THÔNG BÁO:\nTài khoản Admin chỉ quản trị hệ thống, KHÔNG có quyền đăng nhạc!\nChức năng đăng nhạc chỉ dành riêng cho Producer.");
                window.location.href = '/Admin';
            } else if (user.primaryRole !== 'Producer' && user.role !== 'Producer') {
                alert("⚠️ CẢNH BÁO BẢO MẬT:\nKhu vực Studio đăng nhạc chỉ dành riêng cho Nhà Sản Xuất (Producer)!");
                window.location.href = '/';
            } else {
                initProducerNonstopStudio(user);
            }
        }, 150);
    });

    async function initProducerNonstopStudio(producerUser) {
        try {
            const pRes = await fetch('/Producer/Profile');
            const pJson = await pRes.json();
            if (pJson.success && pJson.data) {
                const p = pJson.data;
                document.getElementById('producerStudioStageName').innerHTML = `<i class="fas fa-user-tie text-warning me-1"></i> DJ / Producer: <strong>${p.stageName}</strong>`;
                document.getElementById('producerStudioBankSnippet').innerHTML = `<i class="fas fa-building-columns text-info me-1"></i> Ngân hàng: <strong>${p.bankName || 'Chưa cập nhật'}</strong> (${p.bankAccountNumber || '--'})`;
                
                const artistInput = document.getElementById('nonstopArtistInput');
                if (artistInput) artistInput.value = p.stageName;
            }
        } catch(e) {
            console.warn(e);
        }

        setupNonstopAudioDropZone();
        loadProducerNonstopList();
    }

    function setupNonstopAudioDropZone() {
        const dropZone = document.getElementById('nonstopAudioDropZone');
        if (!dropZone) return;

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropZone.style.borderColor = '#ffd166';
                dropZone.style.background = 'rgba(255, 209, 102, 0.15)';
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropZone.style.borderColor = 'rgba(255, 209, 102, 0.3)';
                dropZone.style.background = 'rgba(255, 209, 102, 0.03)';
            }, false);
        });

        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;
            if (files.length > 0) {
                handleNonstopAudioFile(files[0]);
            }
        }, false);
    }

    function handleNonstopAudioFileSelect(input) {
        if (input.files && input.files[0]) {
            handleNonstopAudioFile(input.files[0]);
        }
    }

    function handleNonstopAudioFile(file) {
        nonstopAudioFile = file;
        const dropZone = document.getElementById('nonstopAudioDropZone');
        const infoEl = document.getElementById('nonstopFileSelectedInfo');
        if (dropZone) dropZone.classList.add('d-none');
        if (infoEl) infoEl.classList.remove('d-none');

        document.getElementById('nonstopSelectedFileName').textContent = file.name;
        document.getElementById('nonstopSelectedFileSize').textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB • ' + (file.type || 'audio/mpeg');

        // Auto fill title
        const titleInput = document.getElementById('nonstopTitleInput');
        if (titleInput && (!titleInput.value || titleInput.value.trim() === '')) {
            let cleanName = file.name.replace(/\.[^/.]+$/, "");
            cleanName = cleanName.replace(/_/g, " ").replace(/-/g, " ");
            titleInput.value = cleanName;
        }

        // Quality detection
        const ext = file.name.split('.').pop().toLowerCase();
        const qualitySelect = document.getElementById('nonstopQualitySelect');
        if (qualitySelect) {
            if (ext === 'wav') qualitySelect.value = 'WAV Lossless 24-Bit';
            else if (ext === 'flac') qualitySelect.value = 'FLAC 24-Bit Lossless';
            else qualitySelect.value = 'MP3 320kbps';
        }

        // Preview audio
        const previewAudio = document.getElementById('nonstopAudioPreviewElement');
        if (previewAudio) {
            previewAudio.src = URL.createObjectURL(file);
            previewAudio.classList.remove('d-none');
        }

        // NONSTOP: ĐỌC THỜI LƯỢNG NHẸ NHÀNG QUA THẺ AUDIO (KHÔNG GIẢI MÃ AUDIOCONTEXT DSP)
        const durationInput = document.getElementById('nonstopDurationInput');
        const durationBadge = document.getElementById('nonstopDetectedDurationBadge');
        
        const tempAudio = new Audio();
        tempAudio.src = URL.createObjectURL(file);
        tempAudio.onloadedmetadata = function() {
            if (tempAudio.duration && isFinite(tempAudio.duration) && tempAudio.duration > 0) {
                const sec = Math.round(tempAudio.duration);
                if (durationInput) durationInput.value = sec;
                if (durationBadge) durationBadge.textContent = `Thời lượng: ${formatNonstopDuration(sec)}`;
            }
        };
    }

    function clearNonstopSelectedAudioFile() {
        nonstopAudioFile = null;
        const fileInput = document.getElementById('nonstopAudioFileInput');
        if (fileInput) fileInput.value = '';

        const dropZone = document.getElementById('nonstopAudioDropZone');
        const infoEl = document.getElementById('nonstopFileSelectedInfo');
        if (dropZone) dropZone.classList.remove('d-none');
        if (infoEl) infoEl.classList.add('d-none');

        const durationBadge = document.getElementById('nonstopDetectedDurationBadge');
        if (durationBadge) durationBadge.textContent = 'Thời lượng: --:--';

        const previewAudio = document.getElementById('nonstopAudioPreviewElement');
        if (previewAudio) {
            previewAudio.pause();
            previewAudio.src = '';
            previewAudio.classList.add('d-none');
        }
    }

    function formatNonstopDuration(sec) {
        if (!sec || isNaN(sec)) return "00:00";
        const h = Math.floor(sec / 3600);
        const m = Math.floor((sec % 3600) / 60);
        const s = Math.floor(sec % 60);
        if (h > 0) {
            return `${h}:${m < 10 ? '0' + m : m}:${s < 10 ? '0' + s : s}`;
        }
        return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
    }

    // Submit dedicated Nonstop Upload
    async function submitProducerNonstopUpload(form) {
        const submitBtn = document.getElementById('nonstopUploadSubmitBtn');
        const audioFile = nonstopAudioFile || document.getElementById('nonstopAudioFileInput')?.files?.[0];

        if (!audioFile) {
            showToastNotification("⚠️ Vui lòng chọn 1 file Nonstop âm thanh (MP3/WAV/FLAC)!");
            return;
        }

        const originalBtnHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Đang tải Nonstop lên Kho dữ liệu...';

        try {
            const formData = new FormData(form);
            formData.set('sourceType', 'DirectFile');
            formData.set('type', 'Nonstop'); // STRICTLY NONSTOP
            formData.set('bpm', '0'); // Nonstop has 0 bpm
            formData.set('musicalKey', 'Nonstop'); // Nonstop has Nonstop key
            formData.set('audioFile', audioFile);

            const res = await fetch('/Producer/UploadNonstop', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            if (res.ok && data.success) {
                showToastNotification(data.message || "🎧 Đăng tải bản Nonstop thành công!");
                form.reset();
                clearNonstopSelectedAudioFile();
                loadProducerNonstopList();
                return;
            }

            showToastNotification("❌ " + (data.message || "Đăng tải Nonstop thất bại!"));
        } catch(e) {
            console.error(e);
            showToastNotification("❌ Lỗi kết nối khi tải bản Nonstop lên máy chủ!");
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
        }
    }

    // Load ONLY Nonstop List (Type == "Nonstop")
    async function loadProducerNonstopList() {
        const container = document.getElementById('producerNonstopsTableContainer');
        const badge = document.getElementById('producerNonstopsCountBadge');
        if (!container) return;

        try {
            const res = await fetch('/Producer/MyTracks?type=Nonstop');
            const data = await res.json();

            if (!data.success || !data.data || data.data.length === 0) {
                container.innerHTML = `
                    <div class="p-5 text-center text-dim">
                        <i class="fas fa-fire-flame-curved fa-3x mb-3 text-warning opacity-50"></i>
                        <h6 class="text-white">Chưa có bản Nonstop nào được đăng tải</h6>
                        <small>Hãy sử dụng biểu mẫu bên trái để tải lên bản Set Mix Nonstop đầu tiên của bạn!</small>
                    </div>
                `;
                if (badge) badge.textContent = "0 bản Nonstop";
                return;
            }

            const nonstops = data.data;
            if (badge) badge.textContent = `${nonstops.length} bản Nonstop`;

            container.innerHTML = `
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="text-dim small border-bottom border-secondary border-opacity-25 font-monospace">
                            <th style="width: 50px;">Phát</th>
                            <th>Bản Nonstop</th>
                            <th>Thời Lượng</th>
                            <th>Phân Cấp</th>
                            <th class="text-end">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${nonstops.map(t => {
                            const isSlot = t.categoryCode && t.categoryCode.includes('Slot');
                            const isNhom = t.categoryCode && t.categoryCode.includes('Nhom');
                            const catBadge = isSlot ? '<span class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i>Slot VIP</span>'
                                : (isNhom ? '<span class="badge badge-standard-red"><i class="fas fa-certificate me-1"></i>Nhóm VIP</span>'
                                : '<span class="badge bg-secondary">Hàng Lọt</span>');

                            return `
                                <tr>
                                    <td>
                                        <button class="btn btn-sm btn-outline-warning rounded-circle d-flex align-items-center justify-content-center p-0" 
                                                style="width: 32px; height: 32px;"
                                                onclick='playTrack({
                                                    id: "${t.musicId}",
                                                    title: "${t.title.replace(/"/g, '\\"')}",
                                                    artist: "${(t.artist || '').replace(/"/g, '\\"')}",
                                                    coverUrl: "${t.coverUrl || ''}",
                                                    audioUrl: "${t.sourceUrl}",
                                                    bpm: 0,
                                                    key: "Nonstop",
                                                    durationSeconds: ${t.durationSeconds || 3600},
                                                    categoryCode: "${t.categoryCode || 'NonstopLot'}"
                                                })'>
                                            <i class="fas fa-play" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white" style="font-size: 0.9rem;">${t.title}</div>
                                        <small class="text-dim">${t.artist || 'DJ TLong'}</small>
                                    </td>
                                    <td class="text-dim small font-monospace">${formatNonstopDuration(t.durationSeconds)}</td>
                                    <td>${catBadge}</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger px-2 py-1 rounded-2" onclick="deleteProducerNonstop('${t.musicId}', '${t.title.replace(/'/g, "\\'")}')" title="Xóa bản Nonstop">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </td>
                                </tr>
                            `;
                        }).join('')}
                    </tbody>
                </table>
            `;
        } catch(e) {
            console.error(e);
            container.innerHTML = `<div class="p-4 text-center text-danger">Lỗi khi tải kho Nonstop cá nhân!</div>`;
        }
    }

    async function deleteProducerNonstop(id, title) {
        if (!confirm(`⚠️ Bạn có chắc chắn muốn xóa bản Nonstop '${title}' khỏi hệ thống?`)) return;

        try {
            const res = await fetch(`/Producer/DeleteTrack/${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                showToastNotification("🗑️ " + data.message);
                loadProducerNonstopList();
            } else {
                showToastNotification("❌ " + (data.message || "Xóa thất bại!"));
            }
        } catch(e) {
            console.error(e);
            showToastNotification("❌ Lỗi kết nối khi xóa bản Nonstop!");
        }
    }
</script>
}

                        <div class="studio-thumb-wrapper">
                            <img src="${cover}" class="studio-thumb-img" alt="${item.title}" />
                            <div class="studio-play-overlay" title="Nghe thử ngay" onclick="previewProducerTrack('${item.musicId}')">
                                <i class="fas fa-play ${playBtnColor}" style="font-size: 0.95rem;"></i>
                            </div>
                        </div>
                        <div class="overflow-hidden" style="max-width: 360px;">

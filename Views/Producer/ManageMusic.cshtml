// ------------------------------------------
// HÀM TIỆN ÍCH SẮP XẾP
// ------------------------------------------
function sortItems(arr, sortMode) {
    const list = [...arr];
    switch (sortMode) {
        case 'OLDEST':
            return list.sort((a, b) => new Date(a.createdAt || 0) - new Date(b.createdAt || 0));
        case 'MOST_PLAYS':
            return list.sort((a, b) => (b.playsCount || 0) - (a.playsCount || 0));
        case 'MOST_DOWNLOADS':
            return list.sort((a, b) => (b.downloadsCount || 0) - (a.downloadsCount || 0));
        case 'TITLE_AZ':
            return list.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
        case 'NEWEST':
        default:
            return list.sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));
    }
}

// ------------------------------------------
// 3. NGHE THỬ TÁC PHẨM TRỰC TIẾP
// ------------------------------------------
function previewProducerTrack(musicId) {
    const track = allProducerMusics.find(m => m.musicId === musicId);
    if (!track) return;

    if (typeof playTrackDirect === 'function') {
        playTrackDirect({
            id: track.musicId,
            title: track.title,
            artist: track.artist,
            coverUrl: track.coverUrl || '/images/logo.png',
            audioUrl: track.sourceUrl || `/Music/Play/${track.musicId}`,
            bpm: track.bpm,
            key: track.musicalKey,
            quality: track.qualityAvailable || '320kbps',
            durationSeconds: track.durationSeconds || 240,
            categoryCode: track.categoryCode,
            type: track.type
        });
        showToastNotification(`🎧 Đang phát kiểm âm: ${track.title}`);
    } else {
        window.location.href = `/Track/Detail/${track.musicId}`;
    }
}

// ------------------------------------------
// 4. CHỈNH SỬA TÁC PHẨM (EDIT)
// ------------------------------------------
function openEditModal(musicId) {
    const track = allProducerMusics.find(m => m.musicId === musicId);
    if (!track) return;

    document.getElementById('editMusicId').value = track.musicId;
    document.getElementById('editMusicType').value = track.type || 'Track';
    document.getElementById('editTitle').value = track.title || '';
    document.getElementById('editArtist').value = track.artist || '';
    document.getElementById('editGenre').value = track.genre || 'Vinahouse';
    document.getElementById('editStatus').value = track.status || 'Published';

    const isNonstop = track.type === 'Nonstop';
    const catSelect = document.getElementById('editCategoryCode');
    const bpmGroup = document.getElementById('editBpmGroup');
    const keyGroup = document.getElementById('editKeyGroup');
    const headerTitle = document.getElementById('editModalHeaderTitle');

    if (isNonstop) {
        if (headerTitle) headerTitle.textContent = 'Chỉnh Sửa Bản Mix Nonstop';
        if (bpmGroup) bpmGroup.style.display = 'none';
        if (keyGroup) keyGroup.style.display = 'none';
        catSelect.innerHTML = `
            <option value="NonstopSlot">⭐️ Nonstop Slot (VIP Độc Quyền - Viền Vàng)</option>
            <option value="NonstopNhom">💎 Nonstop Nhóm (VIP Hội Viên - Viền Đỏ)</option>
            <option value="NonstopLot">🎵 Nonstop Lọt (Phổ Thông Free - Viền Xanh)</option>
        `;
    } else {
        if (headerTitle) headerTitle.textContent = 'Chỉnh Sửa Bản Phối Track Lẻ';
        if (bpmGroup) bpmGroup.style.display = '';
        if (keyGroup) keyGroup.style.display = '';
        document.getElementById('editBpm').value = track.bpm || 140;
        document.getElementById('editMusicalKey').value = track.musicalKey || '8A';
        catSelect.innerHTML = `
            <option value="TrackSlot">⭐️ Track Slot (VIP Độc Quyền - Viền Vàng)</option>
            <option value="TrackNhom">💎 Track Nhóm (VIP Hội Viên - Viền Đỏ)</option>
            <option value="TrackLot">🎵 Track Lọt (Phổ Thông Free - Viền Xanh)</option>
        `;
    }

    catSelect.value = track.categoryCode || (isNonstop ? 'NonstopNhom' : 'TrackNhom');

    const modal = new bootstrap.Modal(document.getElementById('modalEditProducerTrack'));
    modal.show();
}

async function submitEditTrack(e) {
    e.preventDefault();
    const musicId = document.getElementById('editMusicId').value;
    const isNonstop = document.getElementById('editMusicType').value === 'Nonstop';

    const payload = {
        title: document.getElementById('editTitle').value.trim(),
        artist: document.getElementById('editArtist').value.trim(),
        genre: document.getElementById('editGenre').value,
        categoryCode: document.getElementById('editCategoryCode').value,
        status: document.getElementById('editStatus').value,
        bpm: isNonstop ? null : parseInt(document.getElementById('editBpm').value) || 140,
        musicalKey: isNonstop ? null : document.getElementById('editMusicalKey').value
    };

    const saveBtn = document.getElementById('btnSaveTrackEdit');
    if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang lưu...';
    }

    try {
        const res = await fetch(`/Producer/UpdateTrack/${musicId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const json = await res.json();

        if (res.ok && json.success) {
            showToastNotification('🎉 ' + json.message);
            const modalEl = document.getElementById('modalEditProducerTrack');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            // Cập nhật lại trong mảng local
            const index = allProducerMusics.findIndex(m => m.musicId === musicId);
            if (index !== -1) {
                allProducerMusics[index] = {
                    ...allProducerMusics[index],
                    title: payload.title,
                    artist: payload.artist,
                    genre: payload.genre,
                    categoryCode: payload.categoryCode,
                    status: payload.status,
                    bpm: payload.bpm || allProducerMusics[index].bpm,
                    musicalKey: payload.musicalKey || allProducerMusics[index].musicalKey
                };
            }
            renderTracksTable();
            renderNonstopTable();
        } else {
            showToastNotification('❌ ' + (json.message || 'Không thể lưu thay đổi!'));
        }
    } catch (err) {
        console.error('Error saving track edit:', err);
        showToastNotification('❌ Lỗi kết nối khi lưu bài hát!');
    } finally {
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fas fa-check me-1"></i> Lưu Thay Đổi';
        }
    }
}

// ------------------------------------------
// 5. BẬT/TẮT ẨN BÀI HÁT (TOGGLE STATUS)
// ------------------------------------------
async function toggleTrackStatus(musicId) {
    try {
        const res = await fetch(`/Producer/ToggleStatus/${musicId}`, { method: 'POST' });
        const json = await res.json();

        if (res.ok && json.success) {
            showToastNotification('⚡ ' + json.message);
            const item = allProducerMusics.find(m => m.musicId === musicId);
            if (item) {
                item.status = json.status;
            }
            renderTracksTable();
            renderNonstopTable();
        } else {
            showToastNotification('❌ ' + (json.message || 'Không thể thay đổi trạng thái!'));
        }
    } catch (err) {
        console.error('Error toggling status:', err);
        showToastNotification('❌ Lỗi kết nối máy chủ!');
    }
}

// ------------------------------------------
// 6. XÓA VĨNH VIỄN TÁC PHẨM (DELETE)
// ------------------------------------------
function openDeleteModal(musicId, encodedTitle) {
    const title = decodeURIComponent(encodedTitle);
    document.getElementById('deleteMusicId').value = musicId;
    document.getElementById('deleteTrackTitlePreview').textContent = title;

    const modal = new bootstrap.Modal(document.getElementById('modalDeleteProducerTrack'));
    modal.show();
}

async function confirmDeleteTrack() {
    const musicId = document.getElementById('deleteMusicId').value;
    const btn = document.getElementById('btnConfirmDelete');

    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang xóa...';
    }

    try {
        const res = await fetch(`/Producer/DeleteTrack/${musicId}`, { method: 'POST' });
        const json = await res.json();

        if (res.ok && json.success) {
            showToastNotification('🗑️ ' + json.message);
            const modalEl = document.getElementById('modalDeleteProducerTrack');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            allProducerMusics = allProducerMusics.filter(m => m.musicId !== musicId);
            calculateProducerStats();
            renderTracksTable();
            renderNonstopTable();
        } else {
            showToastNotification('❌ ' + (json.message || 'Không thể xóa bài hát!'));
        }
    } catch (err) {
        console.error('Error deleting track:', err);
        showToastNotification('❌ Lỗi kết nối máy chủ!');
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-trash me-1"></i> Đồng Ý Xóa';
        }
    }
}
</script>

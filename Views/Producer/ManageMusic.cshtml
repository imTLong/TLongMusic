<script>
let allProducerMusics = [];

document.addEventListener('DOMContentLoaded', () => {
    loadProducerMusicData();
});

async function loadProducerMusicData() {
    const refreshIcon = document.getElementById('refreshProducerIcon');
    if (refreshIcon) refreshIcon.classList.add('fa-spin');

    try {
        const res = await fetch('/Producer/MyTracks');
        const json = await res.json();

        if (json.success && json.data) {
            allProducerMusics = json.data;
            if (json.stageName) {
                const stageNameEl = document.getElementById('producerStageNameBadge');
                if (stageNameEl) stageNameEl.innerHTML = `<i class="fas fa-circle-check text-warning me-1"></i> Nghệ Sĩ: ${json.stageName}`;
            }

            calculateProducerStats();
            renderTracksTable();
            renderNonstopTable();
        } else {
            showToastNotification('⚠️ ' + (json.message || 'Không thể tải dữ liệu kho nhạc'));
        }
    } catch (err) {
        console.error('Error loading producer tracks:', err);
        showToastNotification('❌ Lỗi kết nối khi tải danh sách bài hát!');
    } finally {
        if (refreshIcon) refreshIcon.classList.remove('fa-spin');
    }
}

function calculateProducerStats() {
    const singleTracks = allProducerMusics.filter(m => m.type !== 'Nonstop');
    const nonstopTracks = allProducerMusics.filter(m => m.type === 'Nonstop');

    const totalPlays = allProducerMusics.reduce((sum, m) => sum + (m.playsCount || 0), 0);
    const totalDownloads = allProducerMusics.reduce((sum, m) => sum + (m.downloadsCount || 0), 0);

    const statTotalEl = document.getElementById('statTotalTracks');
    const statSingleEl = document.getElementById('statSingleTracks');
    const statNonstopEl = document.getElementById('statNonstopTracks');
    const statPlaysEl = document.getElementById('statTotalPlays');
    const statDownloadsEl = document.getElementById('statTotalDownloads');

    const badgeTrackCount = document.getElementById('badgeTrackCount');
    const badgeNonstopCount = document.getElementById('badgeNonstopCount');

    if (statTotalEl) statTotalEl.textContent = allProducerMusics.length;
    if (statSingleEl) statSingleEl.textContent = singleTracks.length;
    if (statNonstopEl) statNonstopEl.textContent = nonstopTracks.length;
    if (statPlaysEl) statPlaysEl.textContent = totalPlays.toLocaleString();
    if (statDownloadsEl) statDownloadsEl.textContent = totalDownloads.toLocaleString();

    if (badgeTrackCount) badgeTrackCount.textContent = singleTracks.length;
    if (badgeNonstopCount) badgeNonstopCount.textContent = nonstopTracks.length;
}

// ------------------------------------------
// 1. RENDER BẢNG TRACK LẺ THEO HỆ MÀU
// ------------------------------------------
function renderTracksTable() {
    const tbody = document.getElementById('trackTableBody');
    if (!tbody) return;

    let items = allProducerMusics.filter(m => m.type !== 'Nonstop');

    // Lọc theo Search
    const searchVal = (document.getElementById('searchTrackInput')?.value || '').toLowerCase().trim();
    if (searchVal) {
        items = items.filter(m => 
            (m.title && m.title.toLowerCase().includes(searchVal)) ||
            (m.artist && m.artist.toLowerCase().includes(searchVal)) ||
            (m.genre && m.genre.toLowerCase().includes(searchVal)) ||
            (m.musicalKey && m.musicalKey.toLowerCase().includes(searchVal)) ||
            (m.bpm && m.bpm.toString().includes(searchVal))
        );
    }

    // Lọc theo Cấp độ
    const tierVal = document.getElementById('filterTrackTier')?.value || 'ALL';
    if (tierVal !== 'ALL') {
        items = items.filter(m => (m.categoryCode || '').toLowerCase() === tierVal.toLowerCase());
    }

    // Lọc theo Trạng thái
    const statusVal = document.getElementById('filterTrackStatus')?.value || 'ALL';
    if (statusVal !== 'ALL') {
        items = items.filter(m => (m.status || 'Published').toLowerCase() === statusVal.toLowerCase());
    }

    // Sắp xếp
    const sortVal = document.getElementById('sortTrackSelect')?.value || 'NEWEST';
    items = sortItems(items, sortVal);

    if (items.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="8" class="text-center py-5 text-dim">
                    <i class="fas fa-compact-disc fa-3x mb-3 text-secondary opacity-50"></i>
                    <p class="mb-2">Không tìm thấy bản Track lẻ nào phù hợp với bộ lọc!</p>
                    <a href="/Producer/UploadTrack" class="btn btn-outline-info rounded-pill btn-sm px-3 mt-1 text-decoration-none">
                        <i class="fas fa-plus me-1"></i> Đăng Track Lẻ Mới
                    </a>
                </td>
            </tr>
        `;
        return;
    }

    tbody.innerHTML = items.map((item, index) => {
        const cover = item.coverUrl || '/images/logo.png';
        const isSlot = (item.categoryCode || '').includes('Slot');
        const isNhom = (item.categoryCode || '').includes('Nhom');
        
        let catBadge = '';
        let rowColorClass = 'track-color-lot'; // Mặc định Lọt Free (Xanh)
        let playBtnColor = 'text-info';

        if (isSlot) {
            rowColorClass = 'track-color-slot'; // Slot VIP (Vàng)
            playBtnColor = 'text-warning';
            catBadge = '<span class="badge fw-bold px-2.5 py-1 rounded-pill" style="background: rgba(255, 209, 102, 0.2); color: #ffd166; border: 1px solid rgba(255, 209, 102, 0.5);"><i class="fas fa-star me-1"></i>Slot VIP</span>';
        } else if (isNhom) {
            rowColorClass = 'track-color-nhom'; // Nhóm VIP (Đỏ)
            playBtnColor = 'text-danger';
            catBadge = '<span class="badge fw-bold px-2.5 py-1 rounded-pill" style="background: rgba(255, 19, 74, 0.2); color: #ff4d6d; border: 1px solid rgba(255, 19, 74, 0.5);"><i class="fas fa-certificate me-1"></i>Nhóm VIP</span>';
        } else {
            catBadge = '<span class="badge fw-bold px-2.5 py-1 rounded-pill" style="background: rgba(0, 223, 216, 0.15); color: #00dfd8; border: 1px solid rgba(0, 223, 216, 0.4);">Lọt Free</span>';
        }

        const isPublished = (item.status || 'Published') === 'Published';
        const statusBadge = isPublished
            ? '<span class="d-inline-flex align-items-center gap-1.5 small text-success fw-bold"><span class="studio-pulse-dot dot-green"></span> Phát hành</span>'

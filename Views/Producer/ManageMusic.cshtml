@{
    ViewData["Title"] = "Studio Quản Lý Kho Nhạc - TLongMusic DJ Portal";
}

<!-- IMPORT FONT & CUSTOM STUDIO CSS -->
<style>
    /* STUDIO GLOW & AURORA PALETTE */
    .studio-dashboard-wrap {
        position: relative;
        z-index: 2;
    }

    .studio-hero-deck {
        background: radial-gradient(circle at 10% 20%, rgba(255, 19, 74, 0.15), transparent 40%),
                    radial-gradient(circle at 90% 80%, rgba(0, 223, 216, 0.12), transparent 45%),
                    linear-gradient(135deg, rgba(16, 18, 32, 0.95), rgba(10, 11, 20, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 26px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(30px);
    }

    /* MASTER METRIC STRIP (DẢI THỐNG KÊ LIỀN KHỐI BỐ CỤC NGANG CHUYÊN NGHIỆP) */
    .studio-metric-strip {
        background: linear-gradient(135deg, rgba(20, 22, 38, 0.92), rgba(12, 13, 24, 0.96));
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 22px;
        backdrop-filter: blur(30px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
        overflow: hidden;
    }

    .studio-metric-item {
        padding: 1.25rem 1.4rem;
        transition: all 0.25s ease;
        position: relative;
    }

    .studio-metric-item:hover {
        background: rgba(255, 255, 255, 0.035);
    }

    .studio-metric-item::after {
        content: '';
        position: absolute;
        bottom: 0; left: 1.4rem; right: 1.4rem;
        height: 2px;
        background: transparent;
        transition: all 0.3s ease;
    }

    .studio-metric-item.metric-purple::after { background: linear-gradient(90deg, #7928ca, #ff0080); }
    .studio-metric-item.metric-cyan::after { background: linear-gradient(90deg, #0070f3, #00dfd8); }
    .studio-metric-item.metric-gold::after { background: linear-gradient(90deg, #f5a623, #ffd166); }
    .studio-metric-item.metric-green::after { background: linear-gradient(90deg, #0575e6, #00f260); }
    .studio-metric-item.metric-ruby::after { background: linear-gradient(90deg, #ff0844, #ffb199); }

    .studio-icon-bubble {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    /* SEGMENTED STUDIO TABS */
    .studio-tab-bar {
        background: rgba(8, 9, 16, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 50px;
        padding: 5px;
        display: inline-flex;
    }

    .studio-tab-btn {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 700;
        font-size: 0.88rem;
        padding: 10px 24px;
        border-radius: 50px;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .studio-tab-btn.active {
        background: linear-gradient(135deg, rgba(255, 19, 74, 0.3), rgba(255, 209, 102, 0.2));
        color: #ffffff !important;
        border: 1px solid rgba(255, 209, 102, 0.45);
        box-shadow: 0 0 20px rgba(255, 19, 74, 0.35);
    }

    .studio-tab-btn:hover:not(.active) {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.06);
    }

    /* GLASS PANEL & COLOR-CODED TRACK ROWS */
    .studio-glass-panel {
        background: rgba(14, 15, 26, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 26px;
        backdrop-filter: blur(35px);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6);
    }

    /* HỆ MÀU TRACK: SLOT (VÀNG) - NHÓM (ĐỎ) - LỌT (CYAN) */
    .studio-row-track {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        position: relative;
    }

    /* 1. MÀU VÀNG: CẤP SLOT VIP ĐỘC QUYỀN */
    .track-color-slot {
        border-left: 4px solid #ffd166 !important;
        background: linear-gradient(90deg, rgba(255, 209, 102, 0.08) 0%, rgba(255, 209, 102, 0.015) 35%, transparent 100%) !important;
    }
    .track-color-slot:hover {
        background: linear-gradient(90deg, rgba(255, 209, 102, 0.15) 0%, rgba(255, 209, 102, 0.04) 45%, transparent 100%) !important;
    }
    .track-color-slot .studio-thumb-wrapper {
        border: 2px solid #ffd166 !important;
        box-shadow: 0 0 12px rgba(255, 209, 102, 0.4) !important;
    }
    .track-color-slot .track-title-link:hover {
        color: #ffd166 !important;
    }

    /* 2. MÀU ĐỎ: CẤP NHÓM VIP HỘI VIÊN */
    .track-color-nhom {
        border-left: 4px solid #ff134a !important;
        background: linear-gradient(90deg, rgba(255, 19, 74, 0.08) 0%, rgba(255, 19, 74, 0.015) 35%, transparent 100%) !important;
    }
    .track-color-nhom:hover {
        background: linear-gradient(90deg, rgba(255, 19, 74, 0.15) 0%, rgba(255, 19, 74, 0.04) 45%, transparent 100%) !important;
    }
    .track-color-nhom .studio-thumb-wrapper {
        border: 2px solid #ff134a !important;
        box-shadow: 0 0 12px rgba(255, 19, 74, 0.4) !important;
    }
    .track-color-nhom .track-title-link:hover {
        color: #ff4d6d !important;
    }

    /* 3. MÀU XANH: CẤP LỌT PHỔ THÔNG FREE */
    .track-color-lot {
        border-left: 4px solid #00dfd8 !important;
        background: linear-gradient(90deg, rgba(0, 223, 216, 0.07) 0%, rgba(0, 223, 216, 0.015) 35%, transparent 100%) !important;
    }
    .track-color-lot:hover {
        background: linear-gradient(90deg, rgba(0, 223, 216, 0.14) 0%, rgba(0, 223, 216, 0.04) 45%, transparent 100%) !important;
    }
    .track-color-lot .studio-thumb-wrapper {
        border: 2px solid #00dfd8 !important;
        box-shadow: 0 0 10px rgba(0, 223, 216, 0.35) !important;
    }
    .track-color-lot .track-title-link:hover {
        color: #00dfd8 !important;
    }

    .studio-thumb-wrapper {
        position: relative;
        width: 52px;
        height: 52px;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
        transition: all 0.25s ease;
    }

    .studio-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .studio-row-track:hover .studio-thumb-img {
        transform: scale(1.08);
    }

    .studio-play-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s ease;
        backdrop-filter: blur(2px);
        cursor: pointer;
    }

    .studio-thumb-wrapper:hover .studio-play-overlay {
        opacity: 1;
    }

    .studio-pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 10px currentColor;
    }

    .dot-green {
        background-color: #00f260;
        color: #00f260;
        animation: pulseNeon 2s infinite;
    }

    .dot-gray {
        background-color: #8892b0;
        color: #8892b0;
    }

    @@keyframes pulseNeon {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.6; }
    }

    /* BADGES */
    .badge-camelot {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 8px;
        background: rgba(255, 209, 102, 0.12);
        color: #ffd166;
        border: 1px solid rgba(255, 209, 102, 0.35);
    }

    .badge-bpm {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 8px;
        background: rgba(0, 223, 216, 0.12);
        color: #00dfd8;
        border: 1px solid rgba(0, 223, 216, 0.35);
    }

    /* STUDIO FILTER TOOLBAR & CONTROLS */
    .studio-filter-toolbar {
        background: linear-gradient(135deg, rgba(20, 22, 38, 0.75), rgba(12, 14, 24, 0.88));
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        padding: 12px 16px;
        backdrop-filter: blur(25px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .studio-search-group {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .studio-search-group .search-icon {
        position: absolute;
        left: 15px;
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.95rem;
        pointer-events: none;
        transition: color 0.25s ease;
        z-index: 2;
    }

    .studio-filter-search {
        background: rgba(8, 9, 16, 0.75) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        color: #ffffff !important;
        border-radius: 12px !important;
        padding: 10px 16px 10px 42px !important;
        font-size: 0.88rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        width: 100%;
    }

    .studio-filter-search::placeholder {
        color: rgba(255, 255, 255, 0.35);
        font-size: 0.85rem;
    }

    .studio-filter-search:focus {
        background: rgba(13, 16, 28, 0.95) !important;
        border-color: #00dfd8 !important;
        box-shadow: 0 0 16px rgba(0, 223, 216, 0.28) !important;
        outline: none;
    }

    .studio-search-group:focus-within .search-icon {
        color: #00dfd8;
    }

    .studio-filter-select {
        background-color: rgba(8, 9, 16, 0.75) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        color: rgba(255, 255, 255, 0.92) !important;
        border-radius: 12px !important;
        font-size: 0.86rem;
        font-weight: 500;
        padding: 10px 36px 10px 14px !important;
        cursor: pointer;
        transition: all 0.25s ease;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%238892b0' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right 14px center !important;
        background-size: 13px 9px !important;
        width: 100%;
    }

    .studio-filter-select:hover {
        border-color: rgba(255, 255, 255, 0.25) !important;
        background-color: rgba(16, 18, 30, 0.85) !important;
        color: #ffffff !important;
    }

    .studio-filter-select:focus {
        border-color: #ffd166 !important;
        box-shadow: 0 0 16px rgba(255, 209, 102, 0.25) !important;
        outline: none;
    }

    .studio-filter-select option {
        background: #0f111e;
        color: #ffffff;
        padding: 8px 12px;
    }

    /* ACTION BUTTONS */
    .btn-studio-action {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.85);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        cursor: pointer;
    }

    .btn-studio-action:hover {
        transform: translateY(-2px);
        color: #ffffff;
    }

    .btn-studio-action.btn-act-edit:hover {
        background: rgba(255, 209, 102, 0.25);
        border-color: #ffd166;
        color: #ffd166;
        box-shadow: 0 0 12px rgba(255, 209, 102, 0.4);
    }

    .btn-studio-action.btn-act-toggle:hover {
        background: rgba(0, 223, 216, 0.25);
        border-color: #00dfd8;
        color: #00dfd8;
        box-shadow: 0 0 12px rgba(0, 223, 216, 0.4);
    }

    .btn-studio-action.btn-act-del:hover {
        background: rgba(255, 19, 74, 0.3);
        border-color: #ff134a;
        color: #ff134a;
        box-shadow: 0 0 12px rgba(255, 19, 74, 0.5);
    }
</style>

<div class="container-fluid px-3 px-xl-5 py-4 studio-dashboard-wrap" style="max-width: 1720px;">

    <!-- 1. STUDIO DJ COMMAND DECK (HEADER BANNER) -->
    <div class="studio-hero-deck p-4 p-md-5 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7 col-xl-8">
                <!-- Badges Status -->
                <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                    <span class="btn-producer-studio-rainbow text-white px-3 py-1 rounded-pill fw-bold text-uppercase d-inline-flex align-items-center gap-1.5 shadow" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                        <i class="fas fa-wand-magic-sparkles"></i> PRODUCER STUDIO
                    </span>
                    <span class="badge px-3 py-1.5 rounded-pill font-monospace" style="background: rgba(255, 209, 102, 0.15); color: #ffd166; border: 1px solid rgba(255, 209, 102, 0.4);" id="producerStageNameBadge">
                        <i class="fas fa-circle-check text-warning me-1"></i> Nghệ Sĩ Được Ủy Quyền
                    </span>
                    <span class="badge px-3 py-1.5 rounded-pill text-dim small" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <i class="fas fa-sliders-simple me-1 text-info"></i> Audio Engine v2.0
                    </span>
                </div>

                <h1 class="text-white fw-bold mb-2 display-6" style="letter-spacing: -0.5px;">
                    QUẢN LÝ KHO NHẠC & TÁC PHẨM
                </h1>
                <p class="text-dim mb-0" style="max-width: 820px; font-size: 0.95rem; line-height: 1.65;">
                    Trang trung tâm dành cho Producer: Quản lý chi tiết toàn bộ các bản thu <strong class="text-white">Track Lẻ</strong> và <strong class="text-white">Nonstop Mix</strong>, chỉnh sửa thông số phòng thu (BPM, Camelot Key, Thể loại), kiểm soát lượt nghe và trạng thái phát hành trực tiếp.
                </p>
            </div>

            <!-- Quick Action Buttons -->
            <div class="col-lg-5 col-xl-4 text-lg-end">
                <div class="d-flex flex-wrap justify-content-lg-end align-items-center gap-2.5">
                    <a href="/Producer/UploadTrack" class="btn btn-outline-info rounded-pill px-3.5 py-2.5 fw-bold d-inline-flex align-items-center gap-2 shadow-sm text-decoration-none" style="border-width: 1.5px;">
                        <i class="fas fa-compact-disc"></i> <span>+ Đăng Track Lẻ</span>
                    </a>
                    <a href="/Producer/UploadNonstop" class="btn btn-outline-warning rounded-pill px-3.5 py-2.5 fw-bold d-inline-flex align-items-center gap-2 shadow-sm text-decoration-none" style="border-width: 1.5px;">
                        <i class="fas fa-fire-flame-curved"></i> <span>+ Đăng Nonstop</span>
                    </a>
                    <button class="btn btn-glass-crystal rounded-pill px-3 py-2.5 text-white d-inline-flex align-items-center gap-1.5 shadow-sm" onclick="loadProducerMusicData()" title="Cập nhật dữ liệu mới">
                        <i class="fas fa-rotate" id="refreshProducerIcon"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. STUDIO METRIC STRIP (DẢI BĂNG ĐIỀU KHIỂN THỐNG KÊ LIỀN KHỐI - BỐ CỤC NGANG CÂN ĐỐI) -->
    <div class="studio-metric-strip mb-4">
        <div class="row g-0">
            <!-- Cột 1: Tổng bài -->
            <div class="col-12 col-sm-6 col-lg border-end border-secondary border-opacity-25">
                <div class="studio-metric-item metric-purple d-flex align-items-center gap-3">
                    <div class="studio-icon-bubble" style="background: rgba(121, 40, 202, 0.22); color: #d684ff; border: 1px solid rgba(121, 40, 202, 0.45);">
                        <i class="fas fa-music"></i>
                    </div>
                    <div>
                        <div class="text-dim small fw-bold text-uppercase" style="letter-spacing: 0.8px; font-size: 0.72rem;">TỔNG TÁC PHẨM</div>
                        <div class="text-white fw-bold font-monospace my-0.5" style="font-size: 1.85rem; line-height: 1;" id="statTotalTracks">0</div>
                        <div class="text-dim small" style="font-size: 0.72rem;">Toàn bộ kho nhạc</div>
                    </div>
                </div>
            </div>

            <!-- Cột 2: Track Lẻ -->
            <div class="col-12 col-sm-6 col-lg border-end border-secondary border-opacity-25">
                <div class="studio-metric-item metric-cyan d-flex align-items-center gap-3">
                    <div class="studio-icon-bubble" style="background: rgba(0, 223, 216, 0.22); color: #00dfd8; border: 1px solid rgba(0, 223, 216, 0.45);">
                        <i class="fas fa-compact-disc"></i>
                    </div>
                    <div>
                        <div class="small fw-bold text-uppercase" style="letter-spacing: 0.8px; font-size: 0.72rem; color: #00dfd8;">TRACK LẺ DJ</div>
                        <div class="text-info fw-bold font-monospace my-0.5" style="font-size: 1.85rem; line-height: 1;" id="statSingleTracks">0</div>
                        <div class="text-dim small" style="font-size: 0.72rem;">Bản phối đơn lẻ</div>
                    </div>
                </div>
            </div>

            <!-- Cột 3: Nonstop Mix -->
            <div class="col-12 col-sm-6 col-lg border-end border-secondary border-opacity-25">
                <div class="studio-metric-item metric-gold d-flex align-items-center gap-3">
                    <div class="studio-icon-bubble" style="background: rgba(255, 209, 102, 0.22); color: #ffd166; border: 1px solid rgba(255, 209, 102, 0.45);">
                        <i class="fas fa-fire-flame-curved"></i>
                    </div>
                    <div>
                        <div class="small fw-bold text-uppercase" style="letter-spacing: 0.8px; font-size: 0.72rem; color: #ffd166;">NONSTOP MIX</div>
                        <div class="text-warning fw-bold font-monospace my-0.5" style="font-size: 1.85rem; line-height: 1;" id="statNonstopTracks">0</div>
                        <div class="text-dim small" style="font-size: 0.72rem;">Set mix & mixtape</div>
                    </div>
                </div>
            </div>

            <!-- Cột 4: Tổng Lượt Nghe -->
            <div class="col-12 col-sm-6 col-lg border-end border-secondary border-opacity-25">
                <div class="studio-metric-item metric-green d-flex align-items-center gap-3">
                    <div class="studio-icon-bubble" style="background: rgba(0, 242, 96, 0.22); color: #00f260; border: 1px solid rgba(0, 242, 96, 0.45);">
                        <i class="fas fa-headphones"></i>
                    </div>
                    <div>
                        <div class="small fw-bold text-uppercase" style="letter-spacing: 0.8px; font-size: 0.72rem; color: #00f260;">TỔNG LƯỢT NGHE</div>
                        <div class="text-success fw-bold font-monospace my-0.5" style="font-size: 1.85rem; line-height: 1;" id="statTotalPlays">0</div>
                        <div class="text-dim small" style="font-size: 0.72rem;">Lượt phát tích lũy</div>
                    </div>
                </div>
            </div>

            <!-- Cột 5: Tổng Lượt Tải -->
            <div class="col-12 col-lg">
                <div class="studio-metric-item metric-ruby d-flex align-items-center gap-3">
                    <div class="studio-icon-bubble" style="background: rgba(255, 19, 74, 0.22); color: #ff134a; border: 1px solid rgba(255, 19, 74, 0.45);">
                        <i class="fas fa-download"></i>
                    </div>
                    <div>
                        <div class="small fw-bold text-uppercase" style="letter-spacing: 0.8px; font-size: 0.72rem; color: #ff134a;">TỔNG LƯỢT TẢI</div>
                        <div class="text-danger fw-bold font-monospace my-0.5" style="font-size: 1.85rem; line-height: 1;" id="statTotalDownloads">0</div>
                        <div class="text-dim small" style="font-size: 0.72rem;">File Master & 320k</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. MAIN STUDIO PANEL (CHIA 2 PHẦN: TRACK LẺ & NONSTOP) -->
    <div class="studio-glass-panel p-3 p-md-4 mb-5">

        <!-- HEADER SWITCH TABS -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
            <div>
                <div class="studio-tab-bar" role="tablist">
                    <button class="studio-tab-btn active" id="tab-tracks-btn" data-bs-toggle="pill" data-bs-target="#tab-tracks-pane" type="button" role="tab">
                        <i class="fas fa-compact-disc text-info"></i>
                        <span>QUẢN LÝ TRACK LẺ</span>
                        <span class="badge bg-dark border border-secondary text-info font-monospace ms-1" id="badgeTrackCount">0</span>
                    </button>
                    <button class="studio-tab-btn" id="tab-nonstop-btn" data-bs-toggle="pill" data-bs-target="#tab-nonstop-pane" type="button" role="tab">
                        <i class="fas fa-fire-flame-curved text-warning"></i>
                        <span>QUẢN LÝ NONSTOP</span>
                        <span class="badge bg-dark border border-secondary text-warning font-monospace ms-1" id="badgeNonstopCount">0</span>
                    </button>
                </div>
            </div>

            <!-- CHÚ THÍCH HỆ MÀU BẢN THU (COLOR LEGEND) -->
            <div class="d-flex align-items-center gap-3 flex-wrap px-3 py-1.5 rounded-pill" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1);">
                <span class="text-dim small fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    <i class="fas fa-palette me-1 text-warning"></i> NHẬN DIỆN MÀU:
                </span>

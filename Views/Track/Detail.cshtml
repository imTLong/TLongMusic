</style>

@section Scripts {
<script>
    // Dữ liệu bài hát hiện tại
    const currentDetailTrack = {
        id: "@Model.Music.Id",
        title: "@rawTitle",
        artist: "@rawArtist",
        coverUrl: "@Model.Music.CoverUrl",
        audioUrl: "@Model.Music.AudioUrl",
        bpm: @Model.Music.Bpm,
        key: "@Model.Music.MusicalKey",
        durationSeconds: @Model.Music.DurationSeconds,
        categoryCode: "@Model.Music.CategoryCode",
        trackType: "@(Model.IsNonstop ? "nonstop" : "track")",
        kind: "@(Model.IsNonstop ? "Nonstop" : "Track")",
        isDemo: @(Model.IsDemo.ToString().ToLower()),
        demoLimit: @Model.DemoLimit,
        quality: "@cleanQuality",
        tierRequired: "@Model.Music.TierRequiredToDownload"
    };

    let waveBars = [];
    const totalBars = 160;
    let lastCanvasWidth = 0;
    let lastCanvasHeight = 0;

    // Sinh biểu đồ sóng nhạc Studio DJ chính xác (Intro -> Build-up -> Drop 1 -> Breakdown -> Drop 2 -> Outro)
    // Tốc độ 0.01ms, không tốn băng thông, không làm khựng âm thanh khi click nút chức năng
    function generateDeterministicStudioWaveform() {
        waveBars = [];
        let seed = 42;
        const str = (currentDetailTrack.id || '') + (currentDetailTrack.title || '');
        for (let i = 0; i < str.length; i++) {
            seed = (seed * 31 + str.charCodeAt(i)) & 0xFFFFFF;
        }

        for (let i = 0; i < totalBars; i++) {
            const p = i / totalBars;
            let sectionMultiplier = 0.4;
            if (p < 0.15) {
                // Intro: nhịp đều đặn
                sectionMultiplier = 0.38 + 0.18 * ((i % 4 === 0) ? 1 : 0.4);
            } else if (p < 0.28) {
                // Build-up 1
                const t = (p - 0.15) / 0.13;
                sectionMultiplier = 0.35 + 0.42 * t;
            } else if (p < 0.50) {
                // Drop 1
                const kick = (i % 4 === 0) ? 0.3 : 0.05;
                sectionMultiplier = 0.68 + kick;
            } else if (p < 0.62) {
                // Breakdown & Melody
                sectionMultiplier = 0.32 + 0.15 * Math.sin(i * 0.4);
            } else if (p < 0.72) {
                // Build-up 2
                const t = (p - 0.62) / 0.10;
                sectionMultiplier = 0.40 + 0.48 * t;
            } else if (p < 0.92) {
                // Drop 2 Climax
                const kick = (i % 4 === 0) ? 0.32 : 0.08;
                sectionMultiplier = 0.72 + kick;
            } else {
                // Outro
                const t = (p - 0.92) / 0.08;
                sectionMultiplier = 0.60 * (1 - t * 0.65);
            }

            const pseudoNoise = (Math.sin((i + seed) * 1.7) * 43758.5453) % 1;
            const jitter = 0.85 + 0.3 * Math.abs(pseudoNoise);
            let barH = sectionMultiplier * jitter;
            barH = Math.max(0.12, Math.min(0.96, barH));
            waveBars.push(barH);
        }
    }

    // Khởi tạo waveform canvas
    function initWaveform() {
        const canvas = document.getElementById('detailWaveformCanvas');
        if (!canvas) return;

        generateDeterministicStudioWaveform();

        const audio = window.TLongPlayer?.audio;
        const isCurrent = window.TLongPlayer?.currentTrack?.id === currentDetailTrack.id;
        const cur = (isCurrent && audio) ? audio.currentTime : 0;
        const dur = (isCurrent && audio?.duration) ? audio.duration : (currentDetailTrack.durationSeconds || 1);
        renderWaveform(cur / dur);
    }

    let hoverPercent = -1;

    function handleWaveformHover(e) {
        const container = document.getElementById('soundcloudWaveformContainer');
        const hoverLine = document.getElementById('waveformHoverLine');
        if (!container || !hoverLine) return;

        const rect = container.getBoundingClientRect();
        const clientX = (e.touches && e.touches.length > 0) ? e.touches[0].clientX : (e.clientX !== undefined ? e.clientX : 0);
        const clickX = clientX - rect.left;
        hoverPercent = Math.max(0, Math.min(1, clickX / rect.width));

        hoverLine.style.display = 'block';
        hoverLine.style.left = (hoverPercent * 100) + '%';
    }

    function handleWaveformLeave() {
        hoverPercent = -1;
        const hoverLine = document.getElementById('waveformHoverLine');
        if (hoverLine) hoverLine.style.display = 'none';
    }

    // Vẽ Waveform Studio SoundCloud (Tối ưu hóa bộ nhớ GPU - không giật lag)
    function renderWaveform(progressPercent) {
        const canvas = document.getElementById('detailWaveformCanvas');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        const rect = canvas.getBoundingClientRect();
        const width = rect.width;
        const height = (rect.height && rect.height > 0) ? rect.height : 85;

        // CHỈ resize canvas khi kích thước thực tế thay đổi để không làm đơ/khựng trình phát nhạc
        const targetWidth = Math.round(width * dpr);
        const targetHeight = Math.round(height * dpr);
        if (canvas.width !== targetWidth || canvas.height !== targetHeight) {
            canvas.width = targetWidth;
            canvas.height = targetHeight;
            ctx.scale(dpr, dpr);
            lastCanvasWidth = width;
            lastCanvasHeight = height;
        }

        const centerY = Math.floor(height * 0.65);
        ctx.clearRect(0, 0, width, height);

        const step = width / totalBars;
        const barWidth = Math.max(2.0, Math.min(3.4, step * 0.74));
        const playedCount = Math.floor(progressPercent * totalBars);

        // Gradient âm thanh cho phần đã phát: Vàng kim đỉnh nhịp -> Đỏ ruby chân sóng
        const playedUpperGrad = ctx.createLinearGradient(0, 0, 0, centerY);
        playedUpperGrad.addColorStop(0, '#ffd166');
        playedUpperGrad.addColorStop(0.55, '#ff4757');
        playedUpperGrad.addColorStop(1, '#ff134a');

        // Phản chiếu gương phía dưới
        const playedLowerGrad = ctx.createLinearGradient(0, centerY, 0, height);
        playedLowerGrad.addColorStop(0, 'rgba(255, 19, 74, 0.72)');
        playedLowerGrad.addColorStop(1, 'rgba(255, 71, 87, 0.12)');

        const unplayedUpperColor = 'rgba(255, 255, 255, 0.28)';
        const unplayedLowerColor = 'rgba(255, 255, 255, 0.08)';

        for (let i = 0; i < totalBars; i++) {
            const x = i * step;
            const barH = Math.max(2, (waveBars[i] || 0.15) * (centerY - 3));
            const isPlayed = i <= playedCount;

            // Nửa trên (Upper bars)
            ctx.fillStyle = isPlayed ? playedUpperGrad : unplayedUpperColor;
            if (ctx.roundRect) {
                ctx.beginPath();
                ctx.roundRect(x, centerY - barH, barWidth, barH, [1.5, 1.5, 0, 0]);
                ctx.fill();
            } else {
                ctx.fillRect(x, centerY - barH, barWidth, barH);
            }

            // Nửa dưới phản chiếu (Mirrored reflection 55%)
            ctx.fillStyle = isPlayed ? playedLowerGrad : unplayedLowerColor;
            const lowerH = barH * 0.55;
            if (ctx.roundRect) {
                ctx.beginPath();
                ctx.roundRect(x, centerY + 1, barWidth, lowerH, [0, 0, 1.5, 1.5]);
                ctx.fill();
            } else {
                ctx.fillRect(x, centerY + 1, barWidth, lowerH);
            }
        }

        // Cập nhật vị trí playhead avatar & thanh chỉ báo tiến độ
        const playhead = document.getElementById('waveformPlayhead');
        const playheadLine = document.getElementById('waveformPlayheadLine');
        const percentStr = (progressPercent * 100) + '%';
        if (playhead) {
            playhead.style.left = percentStr;
        }
        if (playheadLine) {
            playheadLine.style.left = percentStr;
        }
    }

    // Tua bài hát khi click vào waveform
    function seekWaveform(e) {
        const container = document.getElementById('soundcloudWaveformContainer');
        if (!container) return;

        const rect = container.getBoundingClientRect();
        const clientX = (e.touches && e.touches.length > 0) ? e.touches[0].clientX : (e.clientX !== undefined ? e.clientX : 0);
        const clickX = clientX - rect.left;
        let percent = Math.max(0, Math.min(1, clickX / rect.width));

        const audio = window.TLongPlayer?.audio;
        const isCurrent = window.TLongPlayer?.currentTrack?.id === currentDetailTrack.id;

        if (!isCurrent) {
            playTrack(currentDetailTrack);
        }

        const duration = currentDetailTrack.durationSeconds || (audio?.duration || 0);
        if (duration > 0 && audio) {
            let targetTime = percent * duration;

            if (isDemoPlayback(currentDetailTrack)) {
                const limit = currentDetailTrack.demoLimit || 30;
                if (targetTime >= limit) {
                    window.TLongPlayer.currentTrack = currentDetailTrack;
                    audio.currentTime = 0;
                    pauseTrack();
                    renderWaveform(0);
                    const currentTimeElem = document.getElementById('playerCurrentTime');
                    if (currentTimeElem) currentTimeElem.textContent = '00:00';
                    const seekSlider = document.getElementById('playerSeekSlider');
                    if (seekSlider) {
                        seekSlider.value = 0;
                        updateSeekSliderProgress(seekSlider);
                    }
                    const detailCurrentTime = document.getElementById('detailCurrentTime');
                    if (detailCurrentTime) detailCurrentTime.textContent = '00:00';
                    showDemoLimitModal();
                    return;
                }
            }

            audio.currentTime = targetTime;
            renderWaveform(percent);
            const detailCurrentTime = document.getElementById('detailCurrentTime');
            if (detailCurrentTime) {
                detailCurrentTime.textContent = typeof formatTime === 'function' ? formatTime(targetTime) : '00:00';
            }
        }
    }

    // Nút Play / Pause to
    function toggleDetailPlayback() {
        const isCurrent = window.TLongPlayer?.currentTrack?.id === currentDetailTrack.id;
        if (!isCurrent) {
            playTrack(currentDetailTrack);
            updateHeroPlayButton(true);
        } else {
            togglePlayPause();
            updateHeroPlayButton(window.TLongPlayer?.isPlaying);
        }
    }

    function updateHeroPlayButton(isPlaying) {
        const icon = document.getElementById('heroPlayIcon');
        if (icon) {
            icon.className = isPlaying ? 'fas fa-pause' : 'fas fa-play';
        }
    }

    // Cập nhật waveform đồng bộ theo tiến độ bài đang phát
    function syncDetailWaveWithAudio() {
        const audio = window.TLongPlayer?.audio;
        if (!audio) return;

        audio.addEventListener('timeupdate', () => {
            const isCurrent = window.TLongPlayer?.currentTrack?.id === currentDetailTrack.id;
            if (!isCurrent) return;

            const cur = audio.currentTime || 0;
            const dur = (audio.duration && !isNaN(audio.duration) && audio.duration > 0) ? audio.duration : currentDetailTrack.durationSeconds;

            const timeElem = document.getElementById('detailCurrentTime');
            if (timeElem) timeElem.textContent = formatTime(cur);

            if (dur > 0) {
                renderWaveform(cur / dur);
            }
        });

        audio.addEventListener('play', () => {
            if (window.TLongPlayer?.currentTrack?.id === currentDetailTrack.id) {
                updateHeroPlayButton(true);
            }
        });

        audio.addEventListener('pause', () => {
            if (window.TLongPlayer?.currentTrack?.id === currentDetailTrack.id) {
                updateHeroPlayButton(false);
            }
        });
    }

    function copyCurrentTrackLink() {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(window.location.href)
                .then(() => showToastNotification('🔗 Đã sao chép liên kết bài hát!'))
                .catch(() => fallbackCopyLink());
        } else {
            fallbackCopyLink();
        }
    }

    function fallbackCopyLink() {
        const textArea = document.createElement("textarea");
        textArea.value = window.location.href;
        textArea.style.position = "fixed";
        textArea.style.left = "-9999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
            document.execCommand('copy');
            showToastNotification('🔗 Đã sao chép liên kết bài hát!');
        } catch (err) {
            showToastNotification('Liên kết: ' + window.location.href);
        }
        document.body.removeChild(textArea);
    }

    function shareCurrentTrack() {
        if (navigator.share) {
            navigator.share({
                title: currentDetailTrack.title,
                text: `Nghe bài hát ${currentDetailTrack.title} trên TLongMusic`,
                url: window.location.href
            }).catch(() => {});
        } else {
            copyCurrentTrackLink();
        }
    }

    function initTrackDetailPage() {
        initWaveform();
        syncDetailWaveWithAudio();

        const audio = window.TLongPlayer?.audio;
        const isCurrent = window.TLongPlayer?.currentTrack?.id === currentDetailTrack.id;

        if (isCurrent && window.TLongPlayer?.isPlaying) {
            updateHeroPlayButton(true);
        } else {
            updateHeroPlayButton(false);
        }

        const curTimeElem = document.getElementById('detailCurrentTime');
        const durTimeElem = document.getElementById('detailTotalDuration');

        if (curTimeElem) {
            const cur = (isCurrent && audio) ? (audio.currentTime || 0) : 0;
            curTimeElem.textContent = typeof formatTime === 'function' ? formatTime(cur) : '00:00';
        }

        if (durTimeElem && currentDetailTrack.durationSeconds) {
            durTimeElem.textContent = typeof formatTime === 'function' ? formatTime(currentDetailTrack.durationSeconds) : '@Model.Music.FormattedDuration';
        }
    }
    window.initTrackDetailPage = initTrackDetailPage;
    window.syncDetailWaveWithAudio = syncDetailWaveWithAudio;

    if (document.readyState === 'loading') {

@model TLongMusic.Models.SongDetailViewModel
@{
    ViewData["Title"] = Model.Music.Title + " - " + Model.Music.Artist;
    var rawTitle = Model.Music.Title.Replace("\"", "\\\"").Replace("'", "\\'");
    var rawArtist = Model.Music.Artist.Replace("\"", "\\\"").Replace("'", "\\'");
    var isWav = Model.IsWav;
    var cleanQuality = Model.CleanQuality;
}

<div class="container-fluid px-3 px-xl-5 py-4" style="max-width: 1480px;">
    <!-- ========================================================
         HERO SOUNDCLOUD-STYLE PLAYER BANNER (CHÍNH XÁC THEO HÌNH ẢNH)
         ======================================================== -->
    <div class="soundcloud-hero-card mb-4" id="songHeroPlayer">
        <div class="row g-4 align-items-center">
            <!-- CỘT TRÁI: THÔNG TIN, WAVEFORM VÀ THANH CÔNG CỤ -->
            <div class="col-12 col-lg-8 col-xl-9 d-flex flex-column justify-content-between" style="min-height: 295px;">
                <!-- 1. HEADER ROW: PLAY BUTTON + TITLE + METADATA -->
                <div class="d-flex align-items-start gap-3 mb-3">
                    <button id="heroPlayBtn" class="soundcloud-big-play-btn flex-shrink-0" onclick="toggleDetailPlayback()" title="Phát bài này">
                        <i id="heroPlayIcon" class="fas fa-play"></i>
                    </button>
                    <div style="min-width: 0; flex-grow: 1;">
                        <h1 class="text-white fw-bold mb-1 soundcloud-track-title">
                            @Model.Music.Title
                        </h1>
                        <div class="d-flex align-items-center gap-2 flex-wrap text-dim small" style="font-size: 0.85rem;">
                            <span class="text-white fw-semibold">@Model.Music.Artist</span>
                            <span class="opacity-50">•</span>
                            <span>@Model.Music.Genre</span>
                            <span class="opacity-50">•</span>
                            <span>@Model.TimeAgo</span>
                            <span class="opacity-50">•</span>
                            @if (isWav)
                            {
                                <span class="badge badge-premium-gold font-monospace fw-bold" style="font-size: 0.68rem; padding: 2px 7px;">WAV</span>
                            }
                            else
                            {
                                <span class="badge badge-standard-red font-monospace fw-bold" style="font-size: 0.68rem; padding: 2px 7px;">MP3 HD</span>
                            }
                            <span class="opacity-50">•</span>
                            <span class="badge bg-secondary bg-opacity-50 font-monospace">@Model.Music.Bpm BPM</span>
                            <span class="badge bg-secondary bg-opacity-50 font-monospace">Tone @Model.Music.MusicalKey</span>
                        </div>
                    </div>
                </div>

                <!-- 2. MIDDLE ROW: INTERACTIVE SOUNDCLOUD AUDIO WAVEFORM (85PX STUDIO POWER) -->
                <div class="position-relative my-3 w-100">
                    <div id="soundcloudWaveformContainer" class="soundcloud-waveform-wrapper position-relative"
                         onclick="seekWaveform(event)"
                         ontouchstart="seekWaveform(event)"
                         onmousemove="handleWaveformHover(event)"
                         onmouseleave="handleWaveformLeave()">
                        <canvas id="detailWaveformCanvas" height="85" style="width: 100%; height: 85px; display: block;"></canvas>
                        <!-- Scrub hover hairline -->
                        <div id="waveformHoverLine" class="waveform-hover-line"></div>
                        <!-- Playhead vertical line -->
                        <div id="waveformPlayheadLine" class="waveform-playhead-line" style="left: 0%;"></div>
                        <!-- Playhead Pin / Avatar -->
                        <div id="waveformPlayhead" class="waveform-playhead" style="left: 0%;">
                            <img src="@Model.CurrentUserAvatar" alt="Playhead" class="waveform-playhead-avatar" onerror="this.src='/images/logo.png'" />
                        </div>
                    </div>
                </div>

                <!-- 3. BOTTOM ACTION BAR: BỐ TRÍ KHOA HỌC, ĐỒNG BỘ & ĐẸP MẮT -->
                <div class="detail-action-bar d-flex align-items-center justify-content-between gap-3 mt-3 pt-3 border-top border-secondary border-opacity-15 flex-wrap">
                    <!-- Left: Cụm Tương tác (Yêu thích, Lưu playlist, Chia sẻ, Copy link) -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Yêu thích -->
                        <button class="btn-action-pill btn-like-pill @(Model.IsFavorite ? "active" : "")"
                                onclick="toggleFavorite('@Model.Music.Id', this)"
                                title="Yêu thích bài hát">
                            <i class="@(Model.IsFavorite ? "fas text-danger" : "far text-danger") fa-heart"></i>
                            <span>Yêu thích</span>
                            <span class="badge bg-white bg-opacity-10 text-white rounded-pill ms-1 font-monospace" id="detailLikeCount" style="font-size: 0.72rem;">@Model.FavoritesCount</span>
                        </button>

                        <!-- Chia sẻ -->
                        <button class="btn-action-pill"
                                onclick="shareCurrentTrack()"
                                title="Chia sẻ bài hát">
                            <i class="fas fa-share-nodes text-info"></i>
                            <span class="d-none d-md-inline">Chia sẻ</span>
                        </button>
                    </div>

                    <!-- Right: Cụm Thông tin thời gian & Nút tải nhạc chính -->
                    <div class="d-flex align-items-center gap-2.5 flex-wrap ms-auto">
                        <!-- Digital Studio Timer Capsule -->
                        <div class="detail-time-box" title="Thời gian đang phát / Tổng thời lượng">
                            <div class="time-dot"></div>
                            <span id="detailCurrentTime" class="font-monospace fw-bold text-warning" style="font-size: 0.86rem; letter-spacing: 0.5px;">00:00</span>
                            <span class="text-white-50 mx-1" style="font-size: 0.75rem;">/</span>
                            <span id="detailTotalDuration" class="font-monospace fw-semibold text-white" style="font-size: 0.86rem; letter-spacing: 0.5px;">@Model.Music.FormattedDuration</span>
                        </div>

                        <!-- Nút Tải Nhạc Chính -->
                        <button class="btn-action-download"
                                onclick="handleDownload('@Model.Music.Id', '@rawTitle', '@Model.Music.TierRequiredToDownload')"
                                title="Tải xuống bản thu gốc chuẩn phòng thu">
                            <i class="fas fa-cloud-arrow-down" style="font-size: 0.95rem;"></i>
                            <span>Tải</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: ẢNH BÌA LỚN (VUÔNG RỘNG ĐẸP CHUẨN) -->
            <div class="col-12 col-lg-4 col-xl-3 text-center text-lg-end">
                <div class="soundcloud-cover-wrapper d-inline-block">
                    <img src="@Model.Music.CoverUrl" alt="@Model.Music.Title" class="soundcloud-cover-img" onerror="this.src='/images/logo.png'" />
                    <div class="position-absolute top-0 end-0 p-2">
                        @if (Model.IsSlot)
                        {
                            <span class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i>SLOT VIP</span>
                        }
                        else if (Model.IsNhom)
                        {
                            <span class="badge badge-standard-red"><i class="fas fa-certificate me-1"></i>NHÓM VIP</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="fas fa-unlock me-1"></i>LỌT FREE</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================
         NỘI DUNG CHI TIẾT: THÔNG SỐ KỸ THUẬT STUDIO & THÔNG TIN PRODUCER TÁC GIẢ
         ======================================================== -->
    <div class="row g-4">
        <!-- Cột trái: Thông Số Kỹ Thuật Studio -->
        <div class="col-12 col-lg-7">
            <div class="crystal-card p-4 h-100">
                <h5 class="text-white fw-bold mb-3 pb-2 border-bottom border-secondary border-opacity-25 d-flex align-items-center gap-2">
                    <i class="fas fa-sliders text-info"></i> Thông Số Kỹ Thuật Studio
                </h5>

                <div class="d-flex flex-column gap-2.5">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                        <span class="text-dim small"><i class="fas fa-gauge-high text-danger me-2"></i>Tốc Độ Nhịp (BPM)</span>
                        <strong class="text-white font-monospace">@Model.Music.Bpm BPM</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                        <span class="text-dim small"><i class="fas fa-music text-info me-2"></i>Tone Camelot Key</span>
                        <span class="badge badge-shimmer-cyan font-monospace">@Model.Music.MusicalKey</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                        <span class="text-dim small"><i class="fas fa-clock text-warning me-2"></i>Thời Lượng Chuẩn</span>
                        <strong class="text-white font-monospace">@Model.Music.FormattedDuration</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                        <span class="text-dim small"><i class="fas fa-file-audio text-success me-2"></i>Định Dạng Âm Thanh</span>
                        <strong class="text-white font-monospace">@(isWav ? "Lossless Master 24-bit WAV" : "Stereo 320kbps MP3")</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                        <span class="text-dim small"><i class="fas fa-headphones text-primary me-2"></i>Lượt Nghe Trực Tuyến</span>
                        <strong class="text-white font-monospace">@Model.Music.PlaysCount.ToString("N0") lượt</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                        <span class="text-dim small"><i class="fas fa-download text-secondary me-2"></i>Lượt Tải Về</span>
                        <strong class="text-white font-monospace">@Model.Music.DownloadsCount.ToString("N0") lượt</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-dim small"><i class="fas fa-shield-halved text-warning me-2"></i>Quyền Hạn Tải File</span>
                        @if (Model.IsSlot)
                        {
                            <span class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i>Premium VIP</span>
                        }
                        else if (Model.IsNhom)
                        {
                            <span class="badge badge-standard-red"><i class="fas fa-certificate me-1"></i>Standard VIP</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Miễn Phí 100%</span>
                        }
                    </div>
                </div>

                <!-- Box quyền hạn hiện tại của user -->
                <div class="mt-3 p-3 rounded-3 border @(Model.IsUnlocked ? "border-success border-opacity-40" : "border-warning border-opacity-40")"
                     style="background: @(Model.IsUnlocked ? "rgba(46, 213, 115, 0.08)" : "rgba(255, 209, 102, 0.08)");">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fas @(Model.IsUnlocked ? "fa-circle-check text-success" : "fa-lock text-warning")"></i>
                        <strong class="text-white small">@(Model.IsUnlocked ? "Đặc Quyền Của Bạn: ĐÃ MỞ KHÓA" : "Chế Độ Nghe Thử Demo " + Model.DemoLimit + "s")</strong>
                    </div>
                    <p class="text-dim small mb-0" style="line-height: 1.45;">
                        @if (Model.IsUnlocked)
                        {
                            <span>Tài khoản của bạn đủ thẩm quyền để nghe full 100% không giới hạn và tải file gốc chuẩn phòng thu về thiết bị.</span>
                        }
                        else
                        {
                            if (Model.IsSlot)
                            {
                                <span>Tác phẩm thuộc kho <strong>Track Slot VIP độc quyền</strong> (dành riêng cho hội viên <strong>Premium VIP</strong>). Tài khoản hiện tại nghe thử giới hạn <strong>@Model.DemoLimit giây</strong>. Vui lòng nâng cấp Premium để tải Master WAV 24-Bit!</span>
                            }
                            else if (Model.IsNhom)
                            {
                                <span>Tác phẩm thuộc kho <strong>Track Nhóm VIP</strong> (hội viên <strong>Standard VIP</strong> và <strong>Premium VIP</strong> đều được sử dụng). Khi nghe sẽ dừng sau <strong>@Model.DemoLimit giây</strong>. Hãy nâng cấp Standard hoặc Premium để mở khóa!</span>
                            }
                            else
                            {
                                <span>Khi nghe sẽ dừng sau <strong>@Model.DemoLimit giây</strong>. Hãy đăng nhập tài khoản để nghe và tải trọn vẹn!</span>
                            }
                        }
                    </p>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông Tin Producer Tác Giả (Thiết kế Studio Master VIP) -->
        <div class="col-12 col-lg-5">
            <div class="producer-spotlight-card h-100 d-flex flex-column justify-content-between p-4">
                <div>
                    <!-- Header Bar -->
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-secondary border-opacity-25">
                        <div class="d-flex align-items-center gap-2">
                            <span class="producer-vinyl-badge">
                                <i class="fas fa-record-vinyl fa-spin-pulse" style="--fa-animation-duration: 8s;"></i>
                            </span>
                            <span class="text-white fw-bold text-uppercase" style="font-size: 0.82rem; letter-spacing: 0.8px;">
                                THÔNG TIN TÁC GIẢ & PRODUCER
                            </span>
                        </div>
                        <span class="badge rounded-pill px-2.5 py-1 text-success d-inline-flex align-items-center gap-1.5" style="background: rgba(0, 242, 96, 0.12); border: 1px solid rgba(0, 242, 96, 0.35); font-size: 0.68rem; font-weight: 700;">
                            <span class="producer-online-dot"></span> STUDIO VERIFIED
                        </span>
                    </div>

                    <!-- Main Artist Profile Banner -->
                    <div class="producer-profile-banner p-3 rounded-4 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="producer-avatar-wrap flex-shrink-0">
                                <img src="@(!string.IsNullOrEmpty(Model.Producer?.User?.AvatarUrl) ? Model.Producer.User.AvatarUrl : Model.Music.CoverUrl)"
                                     alt="@(Model.Producer?.StageName ?? Model.Music.Artist)"
                                     class="producer-avatar-img"
                                     onerror="this.src='/images/logo.png'" />
                                <span class="producer-verified-crown" title="Producer Đã Xác Thực"><i class="fas fa-check"></i></span>
                            </div>
                            <div style="min-width: 0; flex-grow: 1;">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <h5 class="text-white fw-bold mb-0 text-truncate" style="letter-spacing: -0.3px; font-size: 1.15rem;">
                                        @(Model.Producer?.StageName ?? Model.Music.Artist)
                                    </h5>
                                    <span class="badge bg-warning text-dark fw-bold rounded-pill" style="font-size: 0.68rem; padding: 2px 7px;">
                                        <i class="fas fa-star me-0.5"></i> PRO
                                    </span>
                                </div>
                                <div class="text-dim small mb-2 d-flex align-items-center gap-1.5" style="font-size: 0.78rem;">
                                    <i class="fas fa-music text-info"></i>
                                    <span>Hòa âm & Phối khí chính thức</span>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="producer-tag-chip">
                                        <i class="fas fa-compact-disc text-primary"></i> @Model.Music.Genre
                                    </span>
                                    <span class="producer-tag-chip">
                                        <i class="fas fa-gauge-high text-danger"></i> @Model.Music.Bpm BPM
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Musical Statement / Bio -->
                    <div class="producer-bio-box p-3 rounded-3 mb-3">
                        <div class="d-flex align-items-center gap-1.5 text-warning small fw-bold mb-1.5" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="fas fa-quote-left opacity-75"></i> PHONG CÁCH ÂM NHẠC & TIỂU SỬ
                        </div>
                        <p class="text-light small mb-0 fst-italic" style="font-size: 0.82rem; line-height: 1.6; opacity: 0.9;">
                            "@(string.IsNullOrEmpty(Model.Producer?.Bio) 
                                ? "Nhà sản xuất âm nhạc chuyên nghiệp tại hệ thống TLongMusic Record Pool, chuyên dòng Vinahouse Club, Bar & Festival với chất lượng âm thanh Master tiêu chuẩn cao." 
                                : Model.Producer.Bio)"
                        </p>
                    </div>

                    <!-- Highlights & Quality Matrix -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="producer-feature-tile p-2.5 rounded-3">
                                <div class="text-dim small" style="font-size: 0.68rem;"><i class="fas fa-certificate text-warning me-1"></i>Bản Quyền Master</div>
                                <strong class="text-white small d-block mt-0.5" style="font-size: 0.78rem;">100% Studio Sound</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="producer-feature-tile p-2.5 rounded-3">
                                <div class="text-dim small" style="font-size: 0.68rem;"><i class="fas fa-shield-halved text-success me-1"></i>Kiểm Duyệt Studio</div>
                                <strong class="text-success small d-block mt-0.5" style="font-size: 0.78rem;">Đạt Tiêu Chuẩn Club</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Social / Booking channels if available or general contact -->
                    <div class="producer-contact-row d-flex align-items-center gap-2 mb-2">
                        @if (!string.IsNullOrEmpty(Model.Producer?.FacebookUrl))
                        {
                            <a href="@Model.Producer.FacebookUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm producer-social-btn btn-fb flex-grow-1 text-decoration-none">
                                <i class="fab fa-facebook-f me-1.5"></i> Facebook
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.Producer?.ZaloContact))
                        {
                            <a href="https://zalo.me/@Model.Producer.ZaloContact" target="_blank" rel="noopener noreferrer" class="btn btn-sm producer-social-btn btn-zalo flex-grow-1 text-decoration-none">
                                <i class="fas fa-comment-dots me-1.5"></i> Zalo: @Model.Producer.ZaloContact
                            </a>
                        }
                        @if (string.IsNullOrEmpty(Model.Producer?.FacebookUrl) && string.IsNullOrEmpty(Model.Producer?.ZaloContact))
                        {
                            <div class="producer-exclusive-booking w-100 p-2 text-center rounded-3">
                                <small class="text-dim" style="font-size: 0.74rem;">
                                    <i class="fas fa-sparkles text-warning me-1"></i> Nhận phối nhạc theo yêu cầu & Exclusive Mix
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Footer Call-To-Action -->
                @if (!Model.IsUnlocked)
                {
                    <div class="pt-3 border-top border-secondary border-opacity-20 mt-3">
                        <a href="/Payment/Checkout?package=Standard" class="btn btn-producer-unlock w-100 py-2.5 fw-bold text-center text-decoration-none d-flex align-items-center justify-content-center gap-2 shadow">
                            <i class="fas fa-crown text-warning"></i>
                            <span>NÂNG CẤP VIP ĐỂ TẢI BẢN THU GỐC</span>
                            <i class="fas fa-arrow-right small ms-1"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="pt-3 border-top border-secondary border-opacity-20 mt-3">
                        <div class="p-2.5 rounded-3 text-center" style="background: rgba(0, 242, 96, 0.1); border: 1px solid rgba(0, 242, 96, 0.35); color: #00f260; font-size: 0.82rem; font-weight: 600;">
                            <i class="fas fa-circle-check me-1.5"></i> Đã mở khóa quyền tải File Master của Producer này
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
/* ========================================================
   PRODUCER / ARTIST SPOTLIGHT CARD STYLES
   ======================================================== */
.producer-spotlight-card {
    background: radial-gradient(circle at 90% 10%, rgba(255, 19, 74, 0.12), transparent 45%),
                radial-gradient(circle at 10% 90%, rgba(0, 223, 216, 0.1), transparent 45%),
                linear-gradient(145deg, rgba(20, 22, 38, 0.95), rgba(12, 13, 24, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(30px);
    position: relative;
    overflow: hidden;
}

.producer-spotlight-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, #ff134a, #ffd166, #00dfd8);
    opacity: 0.85;
}

.producer-vinyl-badge {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 209, 102, 0.15);
    color: #ffd166;
    border: 1px solid rgba(255, 209, 102, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
}

.producer-online-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00f260;
    box-shadow: 0 0 8px #00f260;
    display: inline-block;
    animation: pulseNeon 2s infinite;
}

.producer-profile-banner {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}

.producer-avatar-wrap {
    position: relative;
    width: 64px;
    height: 64px;
}

.producer-avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ffd166;
    box-shadow: 0 0 18px rgba(255, 209, 102, 0.4);
    transition: transform 0.3s ease;
}

.producer-avatar-img:hover {
    transform: scale(1.05);
}

.producer-verified-crown {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #00dfd8;
    color: #0c0d18;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 900;
    border: 2px solid #141626;
    box-shadow: 0 0 8px rgba(0, 223, 216, 0.6);
}

.producer-tag-chip {
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 500;
}

.producer-bio-box {
    background: rgba(0, 0, 0, 0.35);

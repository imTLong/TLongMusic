@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân & Tài Khoản Ngân Hàng - TLongMusic";
}

<div class="container py-4" style="position: relative; z-index: 2;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="background: transparent;">
            <li class="breadcrumb-item"><a href="/" class="text-dim text-decoration-none"><i class="fas fa-house me-1"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">Hồ Sơ & Tài Khoản Ngân Hàng</li>
        </ol>
    </nav>

    <!-- Page Header Banner -->
    <div class="p-4 p-md-5 rounded-4 mb-4 border border-secondary border-opacity-25" 
         style="background: linear-gradient(135deg, rgba(255, 19, 74, 0.15), rgba(18, 19, 32, 0.9) 60%), rgba(18, 19, 32, 0.85); backdrop-filter: blur(25px); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="badge badge-shimmer-ruby mb-2"><i class="fas fa-id-card me-1"></i> TRANG QUẢN TRỊ TÀI KHOẢN CÁ NHÂN</span>
                <h2 class="text-white fw-bold mb-1">Hồ Sơ & Tài Khoản Ngân Hàng</h2>
                <p class="text-dim mb-0" style="max-width: 650px;">
                    Cập nhật đầy đủ thông tin cá nhân và tài khoản ngân hàng để nhận thù lao phát hành âm nhạc, thanh toán doanh thu hoặc quản trị phân quyền hệ thống.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-outline-light rounded-pill px-4 py-2">
                    <i class="fas fa-arrow-left me-1"></i> Về Trang Chủ
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4" id="profilePageContent">
        <!-- Left Column: User Summary Card -->
        <div class="col-lg-4">
            <div class="p-4 rounded-4 border border-secondary border-opacity-25 text-center mb-4 sticky-top" 
                 style="top: 90px; background: rgba(18, 19, 32, 0.9); backdrop-filter: blur(20px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);">
                
                <!-- Avatar with Glowing Border -->
                <div class="position-relative d-inline-block mb-3">
                    <img id="pageProfileAvatar" src="/images/logo.png" alt="Avatar" 
                         class="rounded-circle shadow-lg" 
                         style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #ff134a; box-shadow: 0 0 25px rgba(255, 19, 74, 0.5);"
                         onerror="this.src='/images/logo.png'" />
                    <span id="pageProfileOnlineDot" class="position-absolute bottom-0 end-0 p-2 bg-success border border-dark rounded-circle" style="transform: translate(-10px, -10px);"></span>
                </div>

                <h4 class="text-white fw-bold mb-1" id="pageProfileFullName">Đang tải...</h4>
                <div class="font-monospace small text-dim mb-2">@@<span id="pageProfileUsername">username</span></div>
                
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-secondary" id="pageProfileRoleBadge">Member</span>
                    <span class="badge bg-dark border border-secondary" id="pageProfileTierBadge">Gói Free</span>
                </div>

                <hr class="border-secondary border-opacity-25 my-3" />

                <!-- Quick Stats / Meta -->
                <div class="text-start small d-flex flex-column gap-2 mb-3">
                    <div class="d-flex justify-content-between text-dim">
                        <span><i class="fas fa-envelope text-danger me-2"></i> Email:</span>
                        <strong class="text-white" id="pageProfileEmailSummary">--</strong>
                    </div>
                    <div class="d-flex justify-content-between text-dim">
                        <span><i class="fas fa-phone text-warning me-2"></i> Số điện thoại:</span>
                        <strong class="text-white" id="pageProfilePhoneSummary">--</strong>
                    </div>
                    <div class="d-flex justify-content-between text-dim">
                        <span><i class="fas fa-building-columns text-info me-2"></i> Ngân hàng:</span>
                        <strong class="text-info" id="pageProfileBankSummary">--</strong>
                    </div>
                </div>

                <!-- Navigation Shortcuts for Roles -->
                <div class="d-grid gap-2 pt-2" id="pageProfileRoleActions">
                    <!-- Injected via JS based on role -->
                </div>
            </div>
        </div>

        <!-- Right Column: Edit Form & ATM Card Preview -->
        <div class="col-lg-8">
            <form id="profileFullForm" onsubmit="event.preventDefault(); submitFullProfileForm(this);">
                
                <!-- ATM / BANK CARD MOCKUP PREVIEW -->
                <div class="mb-4">
                    <div class="p-4 rounded-4 position-relative overflow-hidden text-white shadow-lg" 
                         style="background: linear-gradient(135deg, #1f1c2c 0%, #928DAB 100%); border: 1px solid rgba(255, 255, 255, 0.2); min-height: 200px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);">
                        <!-- Glass reflection -->
                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 60%); pointer-events: none;"></div>
                        
                        <div class="d-flex justify-content-between align-items-center mb-4 position-relative">
                            <div>
                                <small class="text-uppercase tracking-wider text-warning fw-bold font-monospace" style="letter-spacing: 2px;">
                                    <i class="fas fa-building-columns me-1"></i> TLONGMUSIC VIETNAM REVENUE
                                </small>
                                <h5 class="fw-bold mb-0 text-white mt-1" id="cardBankNamePreview">NGÂN HÀNG (CHƯA CHỌN)</h5>
                            </div>
                            <i class="fas fa-wifi fa-rotate-90 text-white opacity-75 fa-lg"></i>
                        </div>

                        <div class="mb-4 position-relative">
                            <small class="text-white-50 d-block mb-1" style="font-size: 0.75rem;">SỐ TÀI KHOẢN NHẬN TIỀN</small>
                            <div class="fs-4 font-monospace fw-bold tracking-widest text-warning" id="cardAccountNumberPreview" style="letter-spacing: 3px;">
                                •••• •••• •••• ••••
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-end position-relative">
                            <div>
                                <small class="text-white-50 d-block" style="font-size: 0.75rem;">CHỦ TÀI KHOẢN</small>
                                <span class="fw-bold text-uppercase font-monospace fs-6" id="cardAccountHolderPreview">CHƯA CẬP NHẬT</span>
                            </div>
                            <div>
                                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill shadow-sm">
                                    <i class="fas fa-shield-check me-1"></i> ĐÃ XÁC THỰC
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 1: THÔNG TIN CÁ NHÂN -->
                <div class="p-4 rounded-4 border border-secondary border-opacity-25 mb-4" 
                     style="background: rgba(18, 19, 32, 0.85); backdrop-filter: blur(20px);">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <i class="fas fa-user-circle text-info fa-lg"></i>
                        <h5 class="text-white fw-bold mb-0">1. Thông Tin Cá Nhân Cơ Bản</h5>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-dim small">Tên đăng nhập (Username cố định):</label>
                            <input type="text" id="editUsername" class="form-control bg-dark text-dim border-secondary" readonly disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small">Họ và tên hiển thị: <span class="text-danger">*</span></label>
                            <input type="text" id="editFullName" name="fullName" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small">Địa chỉ Email: <span class="text-danger">*</span></label>
                            <input type="email" id="editEmail" name="email" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small">Số điện thoại / Zalo liên hệ:</label>
                            <input type="text" id="editPhone" name="phoneNumber" class="form-control bg-dark text-white border-secondary" placeholder="09xxxxxxxx" />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white small d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-camera text-info me-1"></i> Thay đổi ảnh đại diện (Tải file từ máy tính/điện thoại):</span>
                                <span class="badge bg-secondary text-light fw-normal" style="font-size: 0.75rem;">Không bắt buộc</span>
                            </label>
                            <div class="p-3 rounded-3 border border-secondary border-opacity-50" style="background: rgba(255, 255, 255, 0.02);">
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <!-- Mini preview -->
                                    <div class="position-relative">
                                        <img id="avatarFilePreviewThumbnail" src="/images/logo.png" alt="Preview" 
                                             class="rounded-circle border border-info" 
                                             style="width: 56px; height: 56px; object-fit: cover; box-shadow: 0 0 10px rgba(0, 200, 255, 0.3);"
                                             onerror="this.src='/images/logo.png'" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <input type="file" id="editAvatarFile" name="avatarFile" accept="image/*,.jpg,.jpeg,.png,.webp,.gif" 
                                               class="form-control bg-dark text-white border-secondary" 
                                               onchange="handleAvatarFileSelect(this)" />
                                        <small class="text-dim d-block mt-1">
                                            <i class="fas fa-circle-info me-1"></i> Chọn ảnh từ thiết bị (.JPG, .PNG, .WEBP, .GIF). Bỏ trống nếu không muốn đổi ảnh.
                                        </small>
                                    </div>
                                    <button type="button" id="clearAvatarFileBtn" class="btn btn-sm btn-outline-danger d-none" onclick="clearSelectedAvatarFile()">
                                        <i class="fas fa-times me-1"></i> Bỏ chọn
                                    </button>
                                </div>
                            </div>
                            <input type="hidden" id="editAvatarUrl" name="avatarUrl" />
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: TÀI KHOẢN NGÂN HÀNG -->
                <div class="p-4 rounded-4 border border-warning border-opacity-50 mb-4" 
                     style="background: rgba(255, 209, 102, 0.04); backdrop-filter: blur(20px);">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <i class="fas fa-building-columns text-warning fa-lg"></i>
                        <div>
                            <h5 class="text-warning fw-bold mb-0">2. Thông Tin Tài Khoản Ngân Hàng</h5>
                            <small class="text-dim">Dùng để nhận tiền thanh toán doanh thu hoặc thù lao phát hành âm nhạc</small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white small">Chọn hoặc nhập Ngân hàng: <span class="text-danger">*</span></label>
                            <input list="vietnamBanksFull" type="text" id="editBankName" name="bankName" 
                                   class="form-control bg-dark text-white border-warning border-opacity-50" 
                                   placeholder="Ví dụ: MB Bank, Vietcombank, Techcombank..." 
                                   oninput="updateCardPreview()" />
                            <datalist id="vietnamBanksFull">
                                <option value="MB Bank (Quân Đội)"></option>
                                <option value="Vietcombank"></option>
                                <option value="Techcombank"></option>
                                <option value="ACB (Á Châu)"></option>
                                <option value="VPBank (Việt Nam Thịnh Vượng)"></option>
                                <option value="TPBank (Tiên Phong)"></option>
                                <option value="BIDV"></option>
                                <option value="Agribank"></option>
                                <option value="VietinBank"></option>
                                <option value="Sacombank"></option>
                                <option value="HDBank"></option>
                                <option value="OCB"></option>
                                <option value="SHB"></option>
                                <option value="VIB"></option>
                                <option value="SeABank"></option>
                                <option value="MSB (Hàng Hải)"></option>
                                <option value="LPBank (Bưu Điện Liên Việt)"></option>
                                <option value="Nam A Bank"></option>
                                <option value="Bac A Bank"></option>
                                <option value="BaoViet Bank"></option>
                                <option value="Kienlongbank"></option>
                                <option value="Saigonbank"></option>
                                <option value="PGBank"></option>
                                <option value="BVBank (Bản Việt)"></option>
                                <option value="VietBank"></option>
                                <option value="ABBank (An Bình)"></option>
                                <option value="Shinhan Bank"></option>
                                <option value="Woori Bank"></option>
                                <option value="Public Bank"></option>
                                <option value="HSBC Vietnam"></option>
                                <option value="Standard Chartered"></option>
                            </datalist>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small">Số tài khoản ngân hàng: <span class="text-danger">*</span></label>
                            <input type="text" id="editBankAccountNumber" name="bankAccountNumber" 
                                   class="form-control bg-dark text-warning fw-bold border-warning border-opacity-50 font-monospace fs-5" 
                                   placeholder="0912345678" oninput="updateCardPreview()" />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white small">Tên chủ tài khoản (In hoa không dấu): <span class="text-danger">*</span></label>
                            <input type="text" id="editBankAccountHolder" name="bankAccountHolder" 
                                   class="form-control bg-dark text-white fw-bold border-warning border-opacity-50 text-uppercase" 
                                   placeholder="NGUYEN VAN A" oninput="this.value = this.value.toUpperCase(); updateCardPreview();" />
                            <small class="text-dim">Lưu ý: Tên chủ tài khoản phải khớp chính xác với tên đăng ký tại ngân hàng để tránh sai sót khi chuyển tiền.</small>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: ĐỔI MẬT KHẨU -->
                <div class="p-4 rounded-4 border border-secondary border-opacity-25 mb-4" 
                     style="background: rgba(18, 19, 32, 0.85); backdrop-filter: blur(20px);">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <i class="fas fa-lock text-secondary fa-lg"></i>
                        <div>
                            <h5 class="text-white fw-bold mb-0">3. Bảo Mật & Đổi Mật Khẩu (Tùy chọn)</h5>
                            <small class="text-dim">Bỏ trống các ô bên dưới nếu bạn không muốn đổi mật khẩu</small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-dim small">Mật khẩu hiện tại:</label>
                            <input type="password" id="editOldPassword" name="oldPassword" class="form-control bg-dark text-white border-secondary" placeholder="Nhập để xác nhận..." autocomplete="current-password" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-dim small">Mật khẩu mới (tối thiểu 6 ký tự):</label>
                            <input type="password" id="editNewPassword" name="newPassword" class="form-control bg-dark text-white border-secondary" placeholder="Nhập mật khẩu mới..." autocomplete="new-password" />
                        </div>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-4 rounded-4 border border-secondary border-opacity-25" 
                     style="background: rgba(18, 19, 32, 0.95); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);">
                    <a href="/" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        <i class="fas fa-arrow-left me-2"></i> Quay Về Trang Chủ
                    </a>
                    <button type="submit" id="saveProfileBtn" class="btn btn-shimmer-ruby rounded-pill px-5 py-3 fw-bold fs-6 shadow">
                        <i class="fas fa-floppy-disk me-2"></i> LƯU TẤT CẢ THAY ĐỔI
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        initProfilePage();
    });

    async function initProfilePage() {
        // Ensure user is loaded
        let user = window.TLongPlayer ? window.TLongPlayer.currentUser : null;
        if (!user) {
            try {
                const res = await fetch('/Auth/CurrentUser');
                const data = await res.json();
                if (data.isAuthenticated && data.user) {
                    user = data.user;
                    if (window.TLongPlayer) {
                        window.TLongPlayer.currentUser = data.user;
                    }
                }
            } catch (e) {
                console.error("Could not fetch user:", e);
            }
        }

        if (!user) {
            document.getElementById('profilePageContent').innerHTML = `
                <div class="col-12 py-5 text-center">
                    <div class="p-5 rounded-4 border border-secondary border-opacity-25" style="background: rgba(18, 19, 32, 0.9);">
                        <i class="fas fa-lock text-danger fa-3x mb-3"></i>
                        <h4 class="text-white fw-bold mb-2">Bạn Chưa Đăng Nhập</h4>
                        <p class="text-dim mb-4">Vui lòng đăng nhập để xem và quản lý hồ sơ cá nhân cũng như tài khoản ngân hàng của bạn.</p>
                        <button class="btn btn-shimmer-ruby px-4 py-2 rounded-pill" data-bs-toggle="modal" data-bs-target="#loginModal">
                            <i class="fas fa-arrow-right-to-bracket me-2"></i> Đăng Nhập Ngay
                        </button>
                    </div>
                </div>
            `;
            return;
        }

        populateProfileData(user);
    }

    function populateProfileData(user) {
        // Left Column Card
        const avatarEl = document.getElementById('pageProfileAvatar');
        const fullNameEl = document.getElementById('pageProfileFullName');
        const usernameEl = document.getElementById('pageProfileUsername');
        const roleBadgeEl = document.getElementById('pageProfileRoleBadge');
        const tierBadgeEl = document.getElementById('pageProfileTierBadge');
        const emailSummaryEl = document.getElementById('pageProfileEmailSummary');
        const phoneSummaryEl = document.getElementById('pageProfilePhoneSummary');
        const bankSummaryEl = document.getElementById('pageProfileBankSummary');
        const roleActionsEl = document.getElementById('pageProfileRoleActions');

        const primaryRole = user.primaryRole || user.role || (user.roles && user.roles.includes('Admin') ? 'Admin' : user.roles && user.roles.includes('Producer') ? 'Producer' : 'Member');

        if (avatarEl) avatarEl.src = user.avatarUrl || '/images/logo.png';
        if (fullNameEl) fullNameEl.textContent = user.fullName || user.username;
        if (usernameEl) usernameEl.textContent = user.username;
        if (emailSummaryEl) emailSummaryEl.textContent = user.email;
        if (phoneSummaryEl) phoneSummaryEl.textContent = user.phoneNumber || 'Chưa cập nhật';
        if (bankSummaryEl) bankSummaryEl.textContent = user.bankName ? `${user.bankName}` : 'Chưa cập nhật';

        if (roleBadgeEl) {
            if (primaryRole === 'Admin') {
                roleBadgeEl.className = 'badge bg-danger';
                roleBadgeEl.innerHTML = '<i class="fas fa-shield-halved me-1"></i> Admin';
            } else if (primaryRole === 'Producer') {
                roleBadgeEl.className = 'badge badge-premium-gold';
                roleBadgeEl.innerHTML = '<i class="fas fa-headphones me-1"></i> Producer';
            } else {
                roleBadgeEl.className = 'badge bg-secondary';
                roleBadgeEl.innerHTML = 'Thành Viên';
            }
        }

        if (tierBadgeEl) {
            const tier = (user.tier || 'free').toLowerCase();
            if (tier === 'premium') {
                tierBadgeEl.className = 'badge badge-premium-gold';
                tierBadgeEl.textContent = 'Gói Premium VIP';
            } else if (tier === 'standard') {
                tierBadgeEl.className = 'badge badge-standard-red';
                tierBadgeEl.textContent = 'Gói Standard VIP';
            } else {
                tierBadgeEl.className = 'badge bg-secondary';
                tierBadgeEl.textContent = 'Gói Free';
            }
        }

        // Role Action Buttons
        if (roleActionsEl) {
            let actionsHtml = '';
            if (primaryRole === 'Admin') {
                actionsHtml += `
                    <a href="/Admin" class="btn btn-outline-danger fw-bold rounded-pill py-2 text-decoration-none">
                        <i class="fas fa-shield-halved me-2"></i> Mở Trung Tâm Admin
                    </a>
                `;
            } else if (primaryRole === 'Producer') {
                actionsHtml += `
                    <a href="/Producer/Upload" class="btn btn-outline-warning fw-bold rounded-pill py-2 text-decoration-none">
                        <i class="fas fa-headphones me-2"></i> Mở Studio Producer
                    </a>
                `;
            } else {
                actionsHtml += `
                    <a href="/#pricingSection" class="btn btn-outline-light rounded-pill py-2">
                        <i class="fas fa-gem text-danger me-2"></i> Nâng Cấp Gói VIP
                    </a>
                `;
            }
            roleActionsEl.innerHTML = actionsHtml;
        }

        // Form Fields
        document.getElementById('editUsername').value = user.username || '';
        document.getElementById('editFullName').value = user.fullName || '';
        document.getElementById('editEmail').value = user.email || '';
        document.getElementById('editPhone').value = user.phoneNumber || '';
        document.getElementById('editAvatarUrl').value = user.avatarUrl || '';
        document.getElementById('editBankName').value = user.bankName || '';
        document.getElementById('editBankAccountNumber').value = user.bankAccountNumber || '';
        document.getElementById('editBankAccountHolder').value = user.bankAccountHolder || '';
        document.getElementById('editOldPassword').value = '';
        document.getElementById('editNewPassword').value = '';

        const thumb = document.getElementById('avatarFilePreviewThumbnail');
        if (thumb) thumb.src = user.avatarUrl || '/images/logo.png';
        const clearBtn = document.getElementById('clearAvatarFileBtn');
        if (clearBtn) clearBtn.classList.add('d-none');
        const fileInput = document.getElementById('editAvatarFile');
        if (fileInput) fileInput.value = '';

        updateCardPreview();
    }

    function updateCardPreview() {
        const bankName = document.getElementById('editBankName').value.trim();
        const accNumber = document.getElementById('editBankAccountNumber').value.trim();
        const accHolder = document.getElementById('editBankAccountHolder').value.trim();

        const bankNamePreview = document.getElementById('cardBankNamePreview');
        const accNumberPreview = document.getElementById('cardAccountNumberPreview');
        const accHolderPreview = document.getElementById('cardAccountHolderPreview');

        if (bankNamePreview) {
            bankNamePreview.textContent = bankName || 'NGÂN HÀNG (CHƯA CHỌN)';
        }
        if (accNumberPreview) {
            accNumberPreview.textContent = accNumber || '•••• •••• •••• ••••';
        }
        if (accHolderPreview) {
            accHolderPreview.textContent = accHolder || 'CHƯA CẬP NHẬT';
        }
    }

    function handleAvatarFileSelect(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = function(e) {
                const result = e.target.result;
                const leftAvatar = document.getElementById('pageProfileAvatar');
                if (leftAvatar) leftAvatar.src = result;
                const thumb = document.getElementById('avatarFilePreviewThumbnail');
                if (thumb) thumb.src = result;
                const clearBtn = document.getElementById('clearAvatarFileBtn');
                if (clearBtn) clearBtn.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        }
    }

    function clearSelectedAvatarFile() {
        const input = document.getElementById('editAvatarFile');
        if (input) input.value = '';
        const user = window.TLongPlayer ? window.TLongPlayer.currentUser : null;
        const currentAvatar = (user && user.avatarUrl) ? user.avatarUrl : '/images/logo.png';
        const leftAvatar = document.getElementById('pageProfileAvatar');
        if (leftAvatar) leftAvatar.src = currentAvatar;
        const thumb = document.getElementById('avatarFilePreviewThumbnail');
        if (thumb) thumb.src = currentAvatar;
        const clearBtn = document.getElementById('clearAvatarFileBtn');
        if (clearBtn) clearBtn.classList.add('d-none');
    }

    async function submitFullProfileForm(form) {
        const submitBtn = document.getElementById('saveProfileBtn');
        const originalText = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Đang Lưu Thay Đổi...';
        }

        const newPass = form.newPassword && form.newPassword.value ? form.newPassword.value : null;
        if (newPass && newPass.length < 6) {
            showToastNotification("⚠️ Mật khẩu mới phải có ít nhất 6 ký tự!");
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
            return;
        }

        const formData = new FormData();
        formData.append('fullName', form.fullName.value.trim());
        formData.append('email', form.email.value.trim());
        if (form.phoneNumber && form.phoneNumber.value) {
            formData.append('phoneNumber', form.phoneNumber.value.trim());
        }
        if (form.bankName && form.bankName.value) {
            formData.append('bankName', form.bankName.value.trim());
        }
        if (form.bankAccountNumber && form.bankAccountNumber.value) {
            formData.append('bankAccountNumber', form.bankAccountNumber.value.trim());
        }
        if (form.bankAccountHolder && form.bankAccountHolder.value) {
            formData.append('bankAccountHolder', form.bankAccountHolder.value.trim().toUpperCase());
        }
        if (form.oldPassword && form.oldPassword.value) {
            formData.append('oldPassword', form.oldPassword.value);
        }
        if (newPass) {
            formData.append('newPassword', newPass);
        }

        // Optional Avatar File
        if (form.avatarFile && form.avatarFile.files && form.avatarFile.files[0]) {
            formData.append('avatarFile', form.avatarFile.files[0]);
        }

        try {
            const res = await fetch('/Auth/UpdateProfile', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            if (res.ok && data.success) {
                if (window.TLongPlayer) {
                    window.TLongPlayer.currentUser = data.user;
                }
                localStorage.setItem('tlong_current_user', JSON.stringify(data.user));
                populateProfileData(data.user);
                if (typeof updateAuthUI === 'function') {
                    updateAuthUI();
                }

                showToastNotification(`🎉 ${data.message}`);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                showToastNotification(`❌ ${data.message || 'Cập nhật thất bại!'}`);
            }
        } catch (e) {
            console.error(e);
            showToastNotification("❌ Lỗi kết nối khi cập nhật hồ sơ!");
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }
    }
</script>
}

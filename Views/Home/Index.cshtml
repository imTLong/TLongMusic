                                    <div class="text-white fw-bold font-monospace" id="modalTrackBpm" style="font-size: 1.05rem;">140 BPM</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded-3 border border-secondary border-opacity-25" style="background: rgba(255,255,255,0.03);">
                                    <div class="text-dim" style="font-size: 0.72rem;"><i class="fas fa-music text-info me-1"></i> Camelot Key</div>
                                    <div class="text-white fw-bold font-monospace" id="modalTrackKey" style="font-size: 1.05rem;">8A / Am</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded-3 border border-secondary border-opacity-25" style="background: rgba(255,255,255,0.03);">
                                    <div class="text-dim" style="font-size: 0.72rem;"><i class="fas fa-clock text-warning me-1"></i> Thời lượng</div>
                                    <div class="text-white fw-bold font-monospace" id="modalTrackDuration" style="font-size: 1.05rem;">04:30</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded-3 border border-secondary border-opacity-25" style="background: rgba(255,255,255,0.03);">
                                    <div class="text-dim" style="font-size: 0.72rem;"><i class="fas fa-calendar-days text-secondary me-1"></i> Phát hành</div>
                                    <div class="text-white fw-bold font-monospace" id="modalTrackRelease" style="font-size: 1.05rem;">24/09/2026</div>
                                </div>
                            </div>
                        </div>

                        <!-- Trạng thái quyền hạn bài hát với người dùng hiện tại -->
                        <div class="p-2.5 rounded-3 border mb-3" id="modalAccessBox" style="background: rgba(255, 209, 102, 0.08); border-color: rgba(255, 209, 102, 0.3);">
                            <div class="d-flex align-items-center gap-2">
                                <div style="font-size: 0.85rem;" id="modalAccessText" class="text-white">
                                    Quyền truy cập bài hát
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap gap-2 pt-2 border-top border-secondary border-opacity-25">
                            <button type="button" class="btn btn-shimmer-ruby px-4 py-2 fw-bold d-flex align-items-center gap-2 flex-grow-1 justify-content-center" id="modalPlayBtn">
                                <i class="fas fa-play"></i> Phát Nhạc
                            </button>
                            <button type="button" class="btn btn-glass-crystal px-4 py-2 fw-bold d-flex align-items-center gap-2 flex-grow-1 justify-content-center" id="modalDownloadBtn">
                                <i class="fas fa-arrow-down-to-bracket"></i> Tải Về
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentNonstopTierFilter = 'all';

    function filterNonstopTier(tier, btnElem) {
        currentNonstopTierFilter = tier;
        if (btnElem) {
            document.querySelectorAll('#nonstopFilterPills button').forEach(b => b.classList.remove('active'));
            btnElem.classList.add('active');
        }
        filterNonstops();
    }

    function filterNonstops() {
        const query = (document.getElementById('nonstopSearchInput')?.value || '').toLowerCase().trim();
        const genre = (document.getElementById('nonstopGenreFilterSelect')?.value || '').toLowerCase().trim();
        const selectedTier = currentNonstopTierFilter;

        const sections = document.querySelectorAll('.nonstop-tier-section');

        sections.forEach(section => {
            const sectionTier = section.getAttribute('data-tier-section');
            let sectionHasVisibleCards = false;

            const sectionCards = section.querySelectorAll('.nonstop-item-card');
            sectionCards.forEach(card => {
                const cardTitle = card.getAttribute('data-title') || '';
                const cardArtist = card.getAttribute('data-artist') || '';
                const cardGenre = card.getAttribute('data-genre') || '';
                const cardTier = card.getAttribute('data-tier') || '';

                const matchesQuery = !query || cardTitle.includes(query) || cardArtist.includes(query);
                const matchesGenre = !genre || cardGenre.includes(genre);
                const matchesTier = (selectedTier === 'all') || (cardTier === selectedTier);

                if (matchesQuery && matchesGenre && matchesTier) {
                    card.style.display = '';
                    sectionHasVisibleCards = true;
                } else {
                    card.style.display = 'none';
                }
            });

            if (selectedTier !== 'all' && sectionTier !== selectedTier) {
                section.style.display = 'none';
            } else if (sectionHasVisibleCards) {
                section.style.display = '';
            } else {
                section.style.display = 'none';
            }
        });
    }

    // Hiển thị modal thông tin chi tiết bài hát khi bấm vào tên bài
    window.showMusicInfoModal = function(data) {
        if (!data) return;

        const modalElem = document.getElementById('musicInfoModal');
        if (!modalElem) return;

        // Cover Art
        const coverElem = document.getElementById('modalTrackCover');
        if (coverElem) coverElem.src = data.coverUrl || '/images/logo.png';

        // Title & Artist
        const titleElem = document.getElementById('modalTrackTitle');
        if (titleElem) titleElem.textContent = data.title || 'Không có tiêu đề';

        const artistElem = document.getElementById('modalTrackArtist');
        if (artistElem) artistElem.innerHTML = `<i class="fas fa-headphones-simple text-danger me-1"></i> <span>${data.artist || 'Nghệ sĩ chưa rõ'}</span>`;

        // Subtitle
        const kindSubtitle = document.getElementById('modalKindSubtitle');
        if (kindSubtitle) kindSubtitle.textContent = `${data.kind === 'Nonstop' ? 'Bản Nonstop Set Mix' : 'Bản Track Lẻ'} • TLongMusic Record Pool`;

        // Quality Badge
        const qualityBadge = document.getElementById('modalTrackQualityBadge');
        if (qualityBadge) {
            qualityBadge.textContent = data.quality || 'MP3';
            if ((data.quality || '').toUpperCase().includes('WAV')) {
                qualityBadge.className = 'badge badge-premium-gold font-monospace fw-bold';
            } else {
                qualityBadge.className = 'badge badge-standard-red font-monospace fw-bold';
            }
        }

        // Kind Badge
        const kindBadge = document.getElementById('modalTrackKindBadge');
        if (kindBadge) kindBadge.textContent = (data.kind || 'Track').toUpperCase();

        // Genre
        const genreBadge = document.getElementById('modalGenreBadge');
        if (genreBadge) genreBadge.textContent = data.genre || 'Vinahouse';

        // Tier Badge
        const tierBadge = document.getElementById('modalTierBadge');
        if (tierBadge) {
            if (data.isSlot) {
                tierBadge.className = 'badge badge-premium-gold';
                tierBadge.innerHTML = '<i class="fas fa-crown me-1"></i>SLOT VIP';
            } else if (data.isNhom) {
                tierBadge.className = 'badge badge-standard-red';
                tierBadge.innerHTML = '<i class="fas fa-certificate me-1"></i>NHÓM VIP';
            } else {
                tierBadge.className = 'badge bg-secondary';
                tierBadge.innerHTML = '<i class="fas fa-unlock me-1"></i>LỌT FREE';
            }
        }

        // Metadata
        const bpmElem = document.getElementById('modalTrackBpm');
        if (bpmElem) bpmElem.textContent = (data.bpm && data.bpm > 0) ? `${data.bpm} BPM` : 'Đang cập nhật';

        const keyElem = document.getElementById('modalTrackKey');
        if (keyElem) keyElem.textContent = (data.key && data.key !== '--') ? data.key : 'Chưa định Tone';

        const durElem = document.getElementById('modalTrackDuration');
        if (durElem) durElem.textContent = data.formattedDuration || '0:00';

        const relElem = document.getElementById('modalTrackRelease');
        if (relElem) relElem.textContent = data.releaseDate || 'Mới cập nhật';

        // Check user privilege
        const user = window.TLongPlayer?.currentUser;
        const tier = (window.TLongPlayer?.userTier || 'free').toLowerCase();
        const isAdminOrProd = user && (user.role === 'Admin' || user.primaryRole === 'Admin' || user.role === 'Producer' || user.primaryRole === 'Producer' || (user.roles && (user.roles.includes('Admin') || user.roles.includes('Producer'))));
        const isPremium = isAdminOrProd || tier === 'premium';
        const isStandard = isPremium || tier === 'standard';

        let hasUnlockedAccess = false;
        let accessStatusHtml = '';

        if (data.isSlot) {
            if (isPremium) {
                hasUnlockedAccess = true;
                accessStatusHtml = `<span class="text-warning fw-bold"><i class="fas fa-circle-check text-warning me-1"></i> Đặc quyền Slot VIP đã kích hoạt (Nghe Full & Tải Lossless không giới hạn).</span>`;
            } else {
                accessStatusHtml = `<span class="text-dim"><i class="fas fa-lock text-warning me-1"></i> Kho Slot VIP giới hạn Demo 30s. Nâng cấp <strong>Premium VIP</strong> để mở khóa Full Master!</span>`;
            }
        } else if (data.isNhom) {
            if (isStandard) {
                hasUnlockedAccess = true;
                accessStatusHtml = `<span class="text-danger fw-bold"><i class="fas fa-circle-check text-danger me-1"></i> Nhóm VIP đã mở khóa (Nghe trọn vẹn và tải MP3 320kbps).</span>`;
            } else {
                accessStatusHtml = `<span class="text-dim"><i class="fas fa-lock text-danger me-1"></i> Kho Nhóm VIP yêu cầu gói <strong>Standard VIP</strong> trở lên để tải bài.</span>`;
            }
        } else {
            hasUnlockedAccess = true;
            accessStatusHtml = `<span class="text-success fw-bold"><i class="fas fa-circle-check text-success me-1"></i> Bản Lọt miễn phí 100% cho toàn bộ thành viên.</span>`;
        }

        const accessBox = document.getElementById('modalAccessBox');
        const accessText = document.getElementById('modalAccessText');
        if (accessBox && accessText) {
            accessText.innerHTML = accessStatusHtml;
            if (hasUnlockedAccess) {
                accessBox.style.background = 'rgba(46, 213, 115, 0.1)';
                accessBox.style.borderColor = 'rgba(46, 213, 115, 0.35)';
            } else {
                accessBox.style.background = 'rgba(255, 19, 74, 0.1)';
                accessBox.style.borderColor = 'rgba(255, 19, 74, 0.35)';
            }
        }

        // Play button
        const playBtn = document.getElementById('modalPlayBtn');
        if (playBtn) {
            playBtn.onclick = function() {
                playTrack({
                    id: data.id,
                    title: data.title,
                    artist: data.artist,
                    coverUrl: data.coverUrl,
                    audioUrl: data.audioUrl,
                    bpm: data.bpm,
                    key: data.key,
                    durationSeconds: data.durationSeconds,
                    categoryCode: data.categoryCode,
                    trackType: data.isSlot ? 'slot' : (data.isNhom ? 'nhom' : 'lot'),
                    isDemo: !hasUnlockedAccess && (data.isSlot || (data.isNhom && !isStandard)),
                    quality: data.quality,
                    tierRequired: data.tierRequired
                });
                const modalInstance = bootstrap.Modal.getInstance(modalElem);
                if (modalInstance) modalInstance.hide();
            };
        }

        // Download button
        const dlBtn = document.getElementById('modalDownloadBtn');
        if (dlBtn) {
            dlBtn.onclick = function() {
                handleDownload(data.id, data.title, data.tierRequired);
            };
        }

        const bsModal = bootstrap.Modal.getOrCreateInstance(modalElem);
        bsModal.show();
    };

    // Đồng bộ mở khóa đặc quyền tài khoản trên Homepage (DOM)
    window.syncUserHomepagePrivileges = function() {
        const user = window.TLongPlayer?.currentUser;
        const tier = (window.TLongPlayer?.userTier || 'free').toLowerCase();
        const isAdminOrProd = user && (user.role === 'Admin' || user.primaryRole === 'Admin' || user.role === 'Producer' || user.primaryRole === 'Producer' || (user.roles && (user.roles.includes('Admin') || user.roles.includes('Producer'))));
        const isPremium = isAdminOrProd || tier === 'premium';
        const isStandard = isPremium || tier === 'standard';

        if (isPremium) {
            // Mở khóa toàn bộ Slot Track
            document.querySelectorAll('.track-row-slot').forEach(row => {
                const tierCell = row.children[6];
                if (tierCell) {
                    tierCell.innerHTML = '<span class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i> Premium (Đã Mở)</span>';
                }
            });

            // Mở khóa toàn bộ Slot Nonstop
            const nonstopSlotSection = document.getElementById('homeNonstopSlotSection');
            if (nonstopSlotSection) {
                nonstopSlotSection.querySelectorAll('.nonstop-item-card').forEach(card => {
                    const bottomBadge = card.querySelector('.crystal-card-img-wrapper .position-absolute.bottom-0.start-0 span');
                    if (bottomBadge) {
                        bottomBadge.className = 'badge bg-dark bg-opacity-75 text-warning small border border-warning border-opacity-50';
                        bottomBadge.innerHTML = '<i class="fas fa-crown me-1"></i> Full Lossless VIP (Không Giới Hạn)';
                    }
                    const bodyTierSpan = card.querySelector('.crystal-card-body .d-flex.align-items-center.gap-2.mb-3 span:last-child');
                    if (bodyTierSpan) {
                        bodyTierSpan.className = 'text-warning small';
                        bodyTierSpan.innerHTML = '<i class="fas fa-circle-check text-warning me-1"></i> Đã mở khóa Premium';
                    }
                });
            }
        }

        if (isStandard) {
            // Mở khóa toàn bộ Nhóm Track
            document.querySelectorAll('.track-row-nhom').forEach(row => {
                const tierCell = row.children[6];
                if (tierCell) {
                    tierCell.innerHTML = '<span class="badge badge-standard-red"><i class="fas fa-certificate me-1"></i> Standard (Đã Mở)</span>';
                }
            });

            // Mở khóa toàn bộ Nhóm Nonstop
            const nonstopNhomSection = document.getElementById('homeNonstopNhomSection');
            if (nonstopNhomSection) {
                nonstopNhomSection.querySelectorAll('.nonstop-item-card').forEach(card => {
                    const bodyTierSpan = card.querySelector('.crystal-card-body .d-flex.align-items-center.gap-2.mb-3 span:last-child');
                    if (bodyTierSpan) {
                        bodyTierSpan.className = 'text-danger small';
                        bodyTierSpan.innerHTML = '<i class="fas fa-circle-check text-danger me-1"></i> Đã mở khóa Standard';
                    }
                });
            }
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        if (typeof window.syncUserHomepagePrivileges === 'function') {
            window.syncUserHomepagePrivileges();
        }
    });
</script>
}

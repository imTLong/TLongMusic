@model TLongMusic.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Cung Cấp Track Nhóm & Track Slot Chất Lượng Cao";
}

<div class="container px-lg-4">
    <!-- ==========================================
         HERO SECTION: SÂN KHẤU PHA LÊ CỰC QUANG (CRYSTAL STAGE)
         ========================================== -->
    <div class="crystal-hero-stage">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hero-pill-badge mb-3">
                    <i class="fas fa-sparkles text-danger"></i>
                    <span>LUXURY AUDIO LOUNGE & PRO RECORD POOL</span>
                </div>

                <h1 class="crystal-hero-title">
                    TLONG MUSIC <br />
                    <span class="text-gradient-shimmer">CUNG CẤP TRACK NHÓM</span> & TRACK SLOT CHẤT LƯỢNG CAO
                </h1>

                <p class="crystal-hero-desc">
                    Trải nghiệm không gian âm nhạc điện tử đẳng cấp với các <strong>Track nhạc</strong>, <strong>Nonstop đặt độc quyền</strong>, kho <strong>Track DJ ỉm</strong> và <strong>nhạc nhóm tháng</strong>. Hỗ trợ Producer upload chuẩn BPM / Key với chất lượng âm thanh Master chuẩn nhất. Mang lại trải nghiệm tốt nhất cho người sử dụng!
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <button type="button" onclick="switchMusicSectionView('track'); document.getElementById('masterTrackContainer')?.scrollIntoView({behavior:'smooth'});" class="btn btn-shimmer-ruby">
                        <i class="fas fa-compact-disc me-2"></i> 🎵 Khám Phá Kho Track
                    </button>
                    <button type="button" onclick="switchMusicSectionView('nonstop'); document.getElementById('masterNonstopContainer')?.scrollIntoView({behavior:'smooth'});" class="btn btn-shimmer-gold">
                        <i class="fas fa-fire-flame-curved me-2"></i> 🔥 Khám Phá Kho Nonstop
                    </button>
                    <a href="/Goi-Hoi-Vien" id="heroUpgradeVipBtn" class="btn btn-glass-crystal">
                        <i class="fas fa-gem me-2"></i> Nâng Cấp Gói VIP
                    </a>
                </div>

                <!-- Glass Stat Pills -->
                <div class="row g-3 mt-4 pt-2">
                    <div class="col-4">
                        <div class="glass-stat-pill text-center">
                            <h4 class="text-white font-weight-bold mb-0">15,000+</h4>
                            <span class="text-dim small">Track Master</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="glass-stat-pill text-center">
                            <h4 class="text-white font-weight-bold mb-0">2,800+</h4>
                            <span class="text-dim small">Nonstop Tuyển Chọn</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="glass-stat-pill text-center">
                            <h4 class="text-danger font-weight-bold mb-0">100%</h4>
                            <span class="text-dim small">Chuẩn Key & BPM</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Graphic with Shimmering Ring -->
            <div class="col-lg-4 d-none d-lg-flex justify-content-center">
                <div class="position-relative">
                    <div class="tlong-logo-container" style="width: 220px; height: 220px;">
                        <img src="~/images/logo.png" alt="TLong Crystal" class="tlong-logo-img" style="width: 200px; height: 200px; border-width: 3px;" />
                    </div>
                    <div class="text-center mt-3">
                        <span class="badge badge-shimmer-ruby px-3 py-2 text-uppercase">
                            <i class="fas fa-certificate me-1"></i> MASTER SOUND 24-BIT
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
         MASTER SELECTOR: PHÂN BIỆT RÕ RÀNG 2 PHẦN TRACK VÀ NONSTOP
         ========================================== -->
    <div class="master-type-selector mb-5 p-3 rounded-4" style="background: rgba(18, 19, 32, 0.85); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(20px); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <div class="row align-items-center g-3">
            <div class="col-lg-5">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 rounded-circle bg-danger bg-opacity-25 text-danger">
                        <i class="fas fa-sliders fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="text-white fw-bold mb-0">CHỌN CHUYÊN MỤC ÂM NHẠC</h5>
                        <small class="text-dim">Phân biệt 2 kho nhạc: <strong>Track Đơn DJ</strong> & <strong>Nonstop Dài</strong></small>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="nav nav-pills justify-content-lg-end gap-2" id="mainTypeTabs" role="tablist">
                    <button class="nav-link active px-3 px-md-4 py-2 fw-bold rounded-pill" id="tab-all-sections" onclick="switchMusicSectionView('all', this)">
                        <i class="fas fa-layer-group me-1"></i> Tất Cả (@(Model.LatestTracks.Count + Model.AllNonstops.Count))
                    </button>
                    <button class="nav-link px-3 px-md-4 py-2 fw-bold rounded-pill text-info border border-info border-opacity-25" id="tab-track-section" onclick="switchMusicSectionView('track', this)">
                        <i class="fas fa-compact-disc me-1 text-info"></i> 🎵 PHẦN 1: KHO TRACK DJ (@Model.LatestTracks.Count)
                    </button>
                    <button class="nav-link px-3 px-md-4 py-2 fw-bold rounded-pill text-warning border border-warning border-opacity-25" id="tab-nonstop-section" onclick="switchMusicSectionView('nonstop', this)">
                        <i class="fas fa-fire-flame-curved me-1 text-warning"></i> 🔥 PHẦN 2: KHO NONSTOP (@Model.AllNonstops.Count)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
         PHẦN 1: KHO TRACK DJ (RECORD POOL)
         ========================================== -->
    <div id="masterTrackContainer" class="master-category-container mb-5">
        <div class="p-3 mb-4 rounded-4 d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3" 
             style="background: linear-gradient(90deg, rgba(0, 180, 216, 0.15), rgba(18, 19, 32, 0.95)); border-left: 5px solid #00b4d8; border: 1px solid rgba(0, 180, 216, 0.35); box-shadow: 0 10px 30px rgba(0, 180, 216, 0.1);">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-circle" style="background: rgba(0, 180, 216, 0.2); color: #00b4d8;">
                    <i class="fas fa-compact-disc fa-2x"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-info text-dark fw-bold px-2 py-1" style="font-size: 0.75rem;">PHẦN 1</span>
                        <h2 class="h4 text-white font-weight-bold mb-0">KHO TRACK NHẠC DJ (BẢN THU ĐƠN 3 - 6 PHÚT)</h2>
                    </div>
                    <span class="text-dim small">Track lẻ, Intro, Extended Mix chuẩn bị sẵn thông số Key Camelot & BPM (MP3 / WAV)</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Track" class="btn btn-sm btn-glass-crystal"><i class="fas fa-calendar-day me-1 text-info"></i> Xem Theo Ngày</a>
                <span class="badge badge-shimmer-cyan px-3 py-2 fw-bold">@Model.LatestTracks.Count Bản Track Sẵn Sàng</span>
            </div>
        </div>

        <section id="trackPoolSection" class="mb-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-2 border-bottom border-secondary border-opacity-25">
                <div>
                    <h3 class="h5 text-white font-weight-bold mb-1 d-flex align-items-center gap-2">
                        <i class="fas fa-list-music text-info"></i> DANH SÁCH BẢN TRACK RECORD POOL
                    </h3>
                    <span class="text-dim small">Tra cứu nhanh theo thể loại, BPM hoặc từ khóa</span>
                </div>

                <!-- Modern Filters -->
                <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
                    <input type="text" id="trackSearchInput" class="form-control form-control-sm text-white" 
                           placeholder="Tìm track, ca sĩ, remixer..." onkeyup="filterTracks()" 
                           style="max-width: 180px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px;" />

                    <select id="genreFilterSelect" class="form-select form-select-sm text-white" onchange="filterTracks()" 
                            style="max-width: 140px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px;">
                        <option value="">Tất cả thể loại</option>
                        <option value="Vinahouse">Vinahouse</option>
                        <option value="Electro">Electro</option>
                        <option value="Bounce">Bounce</option>
                        <option value="Dubplate">Dubplate</option>
                    </select>

                    <select id="bpmFilterSelect" class="form-select form-select-sm text-white" onchange="filterTracks()" 
                            style="max-width: 130px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px;">
                        <option value="">Tất cả BPM</option>
                        <option value="130-138">130 - 138 BPM</option>
                        <option value="139-142">139 - 142 BPM</option>
                        <option value="143+">143+ BPM</option>
                    </select>
                </div>
            </div>

            <!-- Thanh Phân Loại Theo Gói Hội Viên Chuẩn SRS (Package Categorization Tabs) -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 mb-3 rounded-pill border border-secondary border-opacity-25" 
                 style="background: rgba(18, 19, 32, 0.7); backdrop-filter: blur(15px);">
                <div class="d-flex flex-wrap gap-2" id="packageFilterPills">
                    <button class="btn btn-sm btn-dark text-white rounded-pill px-3 py-1.5 fw-bold active border-secondary pill-all" id="btnTabTrackAll" onclick="filterByTier('all', this)">
                        <i class="fas fa-layer-group me-1 text-info"></i> Tất Cả Kho Nhạc
                    </button>
                    <!-- TAB TRACK NHÓM (ẤN VÀO SẼ RA MÀU ĐỎ RỰC RỠ) -->
                    <button class="btn btn-sm btn-dark rounded-pill px-3 py-1.5 fw-bold pill-nhom" id="btnTabTrackNhom" onclick="filterByTier('Standard', this)" title="Kho Track Nhóm (Standard VIP)">
                        <i class="fas fa-certificate text-danger me-1"></i> 💎 <span id="homeTabTrackNhomText">Demo track Nhóm</span>
                    </button>
                    <!-- TAB DEMO TRACK SLOT (MÀU VÀNG) -->
                    <button class="btn btn-sm btn-dark rounded-pill px-3 py-1.5 fw-bold pill-slot" id="btnDemoTrackSlot" onclick="filterByTier('demo_slot', this)" title="Chỉ hiển thị các bản Track Slot">
                        <i class="fas fa-crown text-warning me-1"></i> 👑 <span id="homeTabTrackSlotText">Demo track Slot</span>
                    </button>
                    <!-- TAB RIÊNG: TRACK LỌT (MIỄN PHÍ) -->
                    <button class="btn btn-sm btn-dark rounded-pill px-3 py-1.5 fw-bold pill-lot" id="btnTabTrackLot" onclick="filterByTier('Free', this)" title="Kho Track Lọt nghe và tải miễn phí 100%">
                        <i class="fas fa-music text-info me-1"></i> 🎵 Track Lọt (Free)
                    </button>
                    <!-- GÓI CỦA BẠN (DÀNH CHO USER ĐÃ ĐĂNG NHẬP) -->
                    <button class="btn btn-sm btn-dark text-warning rounded-pill px-3 py-1.5 fw-bold border-secondary" onclick="filterByTier('my_tier', this)">
                        <i class="fas fa-unlock-keyhole me-1 text-success"></i> Gói Của Bạn
                    </button>
                </div>
                <div class="text-dim small px-3 d-none d-md-inline-block" id="packageFilterSummary">
                    Hiển thị toàn bộ kho nhạc
                </div>
            </div>

            <!-- Crystal Glass Table -->
            <div class="crystal-table-wrapper table-responsive">
                <table class="crystal-table">
                    <thead>
                        <tr>
                            <th style="width: 45px;"></th>
                            <th>Tên Track / Tiêu Đề</th>
                            <th class="d-none d-md-table-cell">Thể Loại</th>
                            <th>BPM</th>
                            <th class="d-none d-sm-table-cell">Camelot Key</th>
                            <th class="d-none d-lg-table-cell">Thời Lượng</th>
                            <th class="d-none d-md-table-cell">Yêu Cầu Tải</th>
                            <th class="text-end" style="width: 120px;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody id="trackTableBody">
                        @foreach (var track in Model.LatestTracks)
                        {
                            var isTrackSlot = (track.CategoryCode != null && track.CategoryCode.Contains("Slot", StringComparison.OrdinalIgnoreCase))
                                           || track.TierRequiredToDownload == TLongMusic.Models.RequiredTier.Premium
                                           || track.Type == TLongMusic.Models.AudioType.TrackDat;
                            var isTrackNhom = !isTrackSlot && ((track.CategoryCode != null && track.CategoryCode.Contains("Nhom", StringComparison.OrdinalIgnoreCase))
                                           || track.TierRequiredToDownload == TLongMusic.Models.RequiredTier.Standard);
                            var trackKind = isTrackSlot ? "slot" : (isTrackNhom ? "nhom" : "lot");

                            var isTrackUnlocked = (isTrackSlot && Model.IsPremiumUser) || (isTrackNhom && Model.IsStandardUser) || (!isTrackSlot && !isTrackNhom);
                            var shouldTrackDemo = isTrackSlot ? !Model.IsPremiumUser : (track.IsDemoOnlyForFree && !Model.IsStandardUser);

                            var rowClass = "crystal-table-row track-row-" + trackKind;
                            var coverImgClass = "rounded-3 track-table-cover-img " + (isTrackSlot ? "track-cover-slot" : (isTrackNhom ? "track-cover-nhom" : ""));
                            var coverImgStyle = "width: 44px; height: 44px; object-fit: cover; box-shadow: 0 4px 14px rgba(0,0,0,0.5);" + (!isTrackSlot && !isTrackNhom ? " border: 1px solid rgba(255, 255, 255, 0.15);" : "");
                            var isWav = isTrackSlot || (track.QualityAvailable != null && track.QualityAvailable.ToUpperInvariant().Contains("WAV"));
                            var cleanQuality = isWav ? "WAV" : "MP3";

                            <tr class="@rowClass"
                                data-track-id="@track.Id"
                                data-track-type="@trackKind"
                                data-title="@track.Title"
                                data-artist="@track.Artist"
                                data-genre="@track.Genre"
                                data-bpm="@track.Bpm"
                                data-tier="@track.TierRequiredToDownload">
                                <td>
                                    <button class="track-play-inline-btn"
                                            onclick='playTrack({
                                                id: "@track.Id",
                                                title: "@track.Title.Replace("\"", "\\\"")",
                                                artist: "@track.Artist.Replace("\"", "\\\"")",
                                                coverUrl: "@track.CoverUrl",
                                                audioUrl: "@track.AudioUrl",
                                                bpm: @track.Bpm,
                                                key: "@track.MusicalKey",
                                                durationSeconds: @track.DurationSeconds,
                                                categoryCode: "@track.CategoryCode",
                                                trackType: "@trackKind",
                                                isDemo: @(shouldTrackDemo.ToString().ToLower()),
                                                demoLimit: @(track.DemoLimitSeconds > 0 ? track.DemoLimitSeconds : 30),
                                                quality: "@cleanQuality",
                                                tierRequired: "@track.TierRequiredToDownload"
                                            })'
                                            title="Phát bài này">
                                        <i class="fas fa-play"></i>
                                    </button>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@track.CoverUrl" alt="@track.Title" class="@coverImgClass" style="@coverImgStyle" />
                                        <div>
                                            <div class="track-title-wrapper d-inline-flex align-items-center flex-wrap">
                                                <a href="/Track/Detail/@track.Id" class="text-white font-weight-bold track-title-link" style="font-size: 0.95rem; text-decoration: none;" title="Bấm để xem trang chi tiết tác phẩm">
                                                    @track.Title
                                                </a>
                                                @if (isTrackSlot)
                                                {
                                                    <span class="badge badge-premium-gold ms-2 fw-bold" style="font-size: 0.65rem; border: 1px solid #ffd166;" title="Track Slot (Viền Vàng)"><i class="fas fa-crown me-1"></i>SLOT</span>
                                                }
                                                else if (isTrackNhom)
                                                {
                                                    <span class="badge badge-standard-red ms-2 fw-bold" style="font-size: 0.65rem; border: 1px solid #ff134a;" title="Track Nhóm (Viền Đỏ)"><i class="fas fa-certificate me-1"></i>NHÓM</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary ms-2" style="font-size: 0.65rem;" title="Track Lọt Miễn Phí">LỌT</span>
                                                }
                                            </div>
                                            <div class="text-dim small">@track.Artist</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    <span class="badge" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--text-silver); font-size: 0.72rem;">@track.Genre</span>
                                </td>
                                <td>
                                    <span class="badge-shimmer-ruby">@track.Bpm</span>
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    <span class="badge-shimmer-cyan">@track.MusicalKey</span>
                                </td>
                                <td class="d-none d-lg-table-cell text-dim small font-monospace">
                                    @track.FormattedDuration
                                </td>
                                <td class="d-none d-md-table-cell">
                                    @if (isTrackSlot)
                                    {
                                        if (Model.IsPremiumUser)
                                        {
                                            <span class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i> Premium (Đã Mở)</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i> Cần Premium</span>
                                        }
                                    }
                                    else if (isTrackNhom)
                                    {
                                        if (Model.IsStandardUser)
                                        {
                                            <span class="badge badge-standard-red"><i class="fas fa-certificate me-1"></i> Standard (Đã Mở)</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-standard-red"><i class="fas fa-certificate me-1"></i> Cần Standard</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-circle-check text-success me-1"></i> Miễn Phí</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-dim p-0 me-3" onclick="toggleFavorite('@track.Id', this)" title="Yêu thích">
                                        <i class="far fa-heart"></i>
                                    </button>
                                    @if (isTrackSlot)
                                    {
                                        <button class="btn btn-sm btn-download-premium px-3 py-1"
                                                onclick="handleDownload('@track.Id', '@track.Title.Replace("'", "\\'")', '@track.TierRequiredToDownload')">
                                            <i class="fas fa-crown me-1"></i> Tải
                                        </button>
                                    }
                                    else if (isTrackNhom)
                                    {
                                        <button class="btn btn-sm btn-download-standard px-3 py-1"
                                                onclick="handleDownload('@track.Id', '@track.Title.Replace("'", "\\'")', '@track.TierRequiredToDownload')">
                                            <i class="fas fa-arrow-down-to-bracket me-1"></i> Tải
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-glass-crystal px-3 py-1"
                                                onclick="handleDownload('@track.Id', '@track.Title.Replace("'", "\\'")', '@track.TierRequiredToDownload')">
                                            <i class="fas fa-arrow-down-to-bracket me-1"></i> Tải
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- ==========================================
         PHẦN 2: KHO NONSTOP (BẢN MIX DÀI)
         ========================================== -->
    <!-- ==========================================
         PHẦN 2: KHO NONSTOP (BẢN MIX DÀI)
         ========================================== -->
    <div id="masterNonstopContainer" class="master-category-container mb-5">
        <div class="p-2.5 p-sm-3 mb-4 rounded-4 d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3 position-relative overflow-hidden" 
             style="background: linear-gradient(135deg, rgba(255, 107, 139, 0.16) 0%, rgba(18, 19, 32, 0.96) 65%); border-left: 5px solid #ff6b8b; border: 1px solid rgba(255, 107, 139, 0.35); box-shadow: 0 10px 30px rgba(255, 107, 139, 0.12);">
            
            <!-- Cụm thông tin & tiêu đề -->
            <div class="d-flex align-items-center gap-2.5 gap-sm-3 w-100 w-lg-auto">
                <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" 
                     style="width: 46px; height: 46px; background: rgba(255, 107, 139, 0.2); color: #ff6b8b; border: 1px solid rgba(255, 107, 139, 0.4); box-shadow: 0 0 15px rgba(255, 107, 139, 0.25);">
                    <i class="fas fa-fire-flame-curved fa-lg"></i>
                </div>
                <div class="flex-grow-1" style="min-width: 0;">
                    <div class="d-flex align-items-center gap-1.5 gap-sm-2 flex-wrap mb-1">
                        <span class="badge bg-danger text-white fw-bold px-2 py-0.5 rounded-pill" style="font-size: 0.7rem; letter-spacing: 0.5px;">PHẦN 2</span>
                        <h2 class="text-white font-weight-bold mb-0 text-truncate" style="font-size: clamp(0.95rem, 3.2vw, 1.25rem); letter-spacing: -0.2px;">
                            KHO NONSTOP <span class="fw-normal text-dim" style="font-size: 0.8em;">(BẢN MIX DÀI 30 – 90 PHÚT)</span>
                        </h2>
                    </div>
                    <!-- Legend 3 cấp độ dạng mini badges logic & dễ nhìn trên mobile -->
                    <div class="d-flex align-items-center gap-1.5 flex-wrap" style="font-size: 0.72rem;">
                        <span class="text-dim d-none d-sm-inline">Phân loại:</span>
                        <span class="badge px-2 py-0.5 rounded-pill font-monospace" style="background: rgba(255, 209, 102, 0.15); color: #ffd166; border: 1px solid rgba(255, 209, 102, 0.35);">
                            <i class="fas fa-crown me-1"></i>Slot VIP (Vàng)
                        </span>
                        <span class="badge px-2 py-0.5 rounded-pill font-monospace" style="background: rgba(255, 19, 74, 0.15); color: #ff134a; border: 1px solid rgba(255, 19, 74, 0.35);">
                            <i class="fas fa-gem me-1"></i>Nhóm VIP (Đỏ)
                        </span>
                        <span class="badge px-2 py-0.5 rounded-pill font-monospace" style="background: rgba(255, 255, 255, 0.08); color: #8e9aaf; border: 1px solid rgba(255, 255, 255, 0.18);">
                            <i class="fas fa-music me-1"></i>Lọt (Free)
                        </span>
                    </div>
                </div>
            </div>

            <!-- Cụm nút hành động bên phải: Mobile chia đều 2 bên, desktop căn phải -->
            <div class="d-flex align-items-center gap-2 w-100 w-lg-auto justify-content-between justify-content-lg-end pt-2 pt-lg-0 border-top border-lg-0 border-secondary border-opacity-25">
                <a href="/Nonstop" class="btn btn-sm btn-glass-crystal flex-grow-1 flex-lg-grow-0 d-flex align-items-center justify-content-center gap-1.5 py-1.5 px-3 rounded-pill text-nowrap" style="font-size: 0.8rem;">
                    <i class="fas fa-calendar-day text-warning"></i>
                    <span>Xem Theo Ngày</span>
                </a>
                <span class="badge badge-shimmer-ruby flex-grow-1 flex-lg-grow-0 d-flex align-items-center justify-content-center py-2 px-3 fw-bold rounded-pill text-nowrap" style="font-size: 0.78rem;">
                    <i class="fas fa-layer-group me-1.5 d-none d-sm-inline"></i> @Model.AllNonstops.Count Bản Sẵn Sàng
                </span>
            </div>
        </div>

        <!-- NONSTOP TOOLBAR & SUB-FILTERS -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-2 border-bottom border-secondary border-opacity-25">
            <div class="d-flex flex-wrap gap-2" id="nonstopFilterPills">
                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1.5 fw-bold active" onclick="filterNonstopTier('all', this)">
                    <i class="fas fa-layer-group me-1"></i> Tất Cả (@Model.AllNonstops.Count)
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1.5 fw-bold" onclick="filterNonstopTier('slot', this)">
                    <i class="fas fa-crown me-1 text-warning"></i> Nonstop Slot (@Model.SlotNonstops.Count)
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 fw-bold" onclick="filterNonstopTier('nhom', this)">
                    <i class="fas fa-certificate me-1 text-danger"></i> Nonstop Nhóm (@Model.NhomNonstops.Count)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold text-white" onclick="filterNonstopTier('lot', this)">
                    <i class="fas fa-music me-1 text-info"></i> Nonstop Lọt (@Model.LotNonstops.Count)
                </button>
            </div>

            <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
                <input type="text" id="nonstopSearchInput" class="form-control form-control-sm text-white" 
                       placeholder="Tìm nonstop, DJ..." onkeyup="filterNonstops()" 
                       style="max-width: 200px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px;" />

                <select id="nonstopGenreFilterSelect" class="form-select form-select-sm text-white" onchange="filterNonstops()" 
                        style="max-width: 150px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px;">
                    <option value="">Tất cả thể loại</option>
                    <option value="Vinahouse">Vinahouse</option>
                    <option value="Electro">Electro</option>
                    <option value="Bounce">Bounce</option>
                    <option value="Dubplate">Dubplate</option>
                </select>
            </div>
        </div>

        @if (!Model.AllNonstops.Any())
        {
            <div class="p-5 text-center rounded-4 border border-secondary border-opacity-25 my-4" style="background: rgba(18, 19, 32, 0.6);">
                <i class="fas fa-music-slash fa-3x text-dim mb-3"></i>
                <h4 class="text-white fw-bold">Chưa có bản Nonstop nào được phát hành</h4>
                <p class="text-dim small mb-0">Các bản Nonstop đang được Producer tải lên và cập nhật liên tục.</p>
            </div>
        }
        else
        {
            <!-- SUB-SECTION A: NONSTOP SLOT (BẢN ĐẶT PHÒNG THU VIP - VIỀN VÀNG) -->
            @if (Model.SlotNonstops.Any())
            {
                <section id="homeNonstopSlotSection" class="nonstop-tier-section mb-5" data-tier-section="slot">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-warning border-opacity-25">
                        <div>
                            <h3 class="h5 text-white font-weight-bold mb-1 d-flex align-items-center gap-2">
                                <i class="fas fa-crown" style="color: #ffd166; filter: drop-shadow(0 0 8px rgba(255, 209, 102, 0.8));"></i>
                                <span class="text-accent-premium">NONSTOP ĐẶT PHÒNG THU (SLOT EXCLUSIVE)</span>
                                <span class="badge badge-premium-gold ms-2" style="font-size: 0.7rem;"><i class="fas fa-crown me-1"></i> VIP EXCLUSIVE</span>
                            </h3>
                            <span class="text-dim small">Bản Master Lossless phòng thu độc quyền (Dành riêng cho thành viên VIP Premium & Studio Producer)</span>
                        </div>
                        @if (Model.IsPremiumUser)
                        {
                            <span class="badge badge-premium-gold px-3.5 py-2 fw-bold rounded-pill shadow-sm">
                                <i class="fas fa-crown me-1"></i> ĐẶC QUYỀN PREMIUM ACTIVE
                            </span>
                        }
                        else
                        {
                            <a href="/Goi-Hoi-Vien" class="btn btn-sm btn-shimmer-gold"><i class="fas fa-unlock me-1"></i> Mở Khóa Master WAV</a>
                        }
                    </div>

                    <div class="row g-4">
                        @foreach (var track in Model.SlotNonstops)
                        {
                            var cleanQuality = (track.QualityAvailable != null && track.QualityAvailable.ToUpperInvariant().Contains("WAV")) ? "WAV" : "WAV";
                            var isSlotDemo = !Model.IsPremiumUser;

                            <div class="col-12 col-sm-6 col-lg-4 nonstop-item-card" data-title="@track.Title.ToLower()" data-artist="@track.Artist.ToLower()" data-genre="@track.Genre.ToLower()" data-tier="slot">
                                <div class="crystal-card border-slot-gold">
                                    <div class="crystal-card-img-wrapper">
                                        <img src="@track.CoverUrl" alt="@track.Title" class="crystal-card-img" />

                                        <div class="position-absolute top-0 start-0 p-2 d-flex gap-1 flex-wrap">
                                            <span class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i>SLOT</span>
                                            <span class="badge badge-premium-gold font-monospace fw-bold">@cleanQuality</span>
                                            <span class="badge bg-dark bg-opacity-75 text-warning font-monospace fw-bold" style="font-size: 0.7rem;"><i class="fas fa-layer-group me-1"></i>NONSTOP</span>
                                        </div>
                                        <div class="position-absolute top-0 end-0 p-2">
                                            <span class="badge-shimmer-gold">VIP SET</span>
                                        </div>

                                        <button class="crystal-play-btn btn-play-trigger"
                                                style="background: linear-gradient(135deg, #ffd166, #ff9f1c); color: #000; border-color: #fff; box-shadow: 0 0 20px rgba(255, 209, 102, 0.8);"
                                                onclick='playTrack({
                                                    id: "@track.Id",
                                                    title: "@track.Title.Replace("\"", "\\\"")",
                                                    artist: "@track.Artist.Replace("\"", "\\\"")",
                                                    coverUrl: "@track.CoverUrl",
                                                    audioUrl: "@track.AudioUrl",
                                                    bpm: @track.Bpm,
                                                    key: "@track.MusicalKey",
                                                    durationSeconds: @track.DurationSeconds,
                                                    categoryCode: "@track.CategoryCode",
                                                    trackType: "slot",
                                                    kind: "Nonstop",
                                                    isDemo: @(isSlotDemo.ToString().ToLower()),
                                                    demoLimit: 30,
                                                    quality: "@cleanQuality",
                                                    tierRequired: "Premium"
                                                })'>
                                            <i class="fas fa-play"></i>
                                        </button>

                                        <div class="position-absolute bottom-0 start-0 p-2">
                                            @if (Model.IsPremiumUser)
                                            {
                                                <span class="badge bg-dark bg-opacity-75 text-warning small border border-warning border-opacity-50">
                                                    <i class="fas fa-crown me-1"></i> Full Lossless VIP (Không Giới Hạn)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-dark bg-opacity-75 text-warning small border border-warning border-opacity-50">
                                                    <i class="fas fa-shield-halved me-1"></i> Demo 30s (Full Premium)
                                                </span>
                                            }
                                        </div>

                                        <div class="position-absolute bottom-0 end-0 p-2">
                                            <span class="badge bg-dark bg-opacity-75 text-white font-monospace small">
                                                @track.FormattedDuration
                                            </span>
                                        </div>
                                    </div>

                                    <div class="crystal-card-body">
                                        <h3 class="crystal-card-title text-accent-premium font-weight-bold">
                                            <a href="/Track/Detail/@track.Id" class="text-accent-premium track-title-link text-decoration-none" title="Bấm để xem trang chi tiết tác phẩm">
                                                @track.Title
                                            </a>
                                        </h3>
                                        <div class="crystal-card-artist"><i class="fas fa-gem text-warning me-1"></i> @track.Artist</div>

                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <span class="badge-premium-gold font-monospace fw-bold" style="font-size: 0.72rem; padding: 2px 8px;">@cleanQuality</span>
                                            @if (Model.IsPremiumUser)
                                            {
                                                <span class="text-warning small"><i class="fas fa-circle-check text-warning me-1"></i> Đã mở khóa Premium</span>
                                            }
                                            else
                                            {
                                                <span class="text-dim small"><i class="fas fa-lock text-warning me-1"></i> Cần Premium VIP</span>
                                            }
                                        </div>

                                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                                            <div class="d-flex align-items-center gap-2">
                                                <button class="btn btn-sm btn-link text-warning p-0" onclick="toggleFavorite('@track.Id', this)" title="Yêu thích">
                                                    <i class="far fa-heart"></i>
                                                </button>
                                                <span class="text-dim small font-italic">Bảo mật phòng thu</span>
                                            </div>
                                            <button class="btn btn-sm btn-download-premium px-3 py-1" onclick="handleDownload('@track.Id', '@track.Title.Replace("'", "\\'")', '@track.TierRequiredToDownload')">
                                                <i class="fas fa-crown me-1"></i> Tải
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- SUB-SECTION B: NONSTOP NHÓM (TIÊU CHUẨN STANDARD & PREMIUM - VIỀN ĐỎ) -->
            @if (Model.NhomNonstops.Any())
            {
                <section id="homeNonstopNhomSection" class="nonstop-tier-section mb-5" data-tier-section="nhom">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-danger border-opacity-25">
                        <div>
                            <h3 class="h5 text-white font-weight-bold mb-1 d-flex align-items-center gap-2">
                                <i class="fas fa-certificate text-danger"></i>
                                <span class="text-accent-standard">NONSTOP NHÓM VIP (STANDARD & PREMIUM)</span>
                                <span class="badge badge-standard-red ms-2" style="font-size: 0.7rem;"><i class="fas fa-certificate me-1"></i> NHÓM VIP</span>
                            </h3>
                            <span class="text-dim small">Các bản Nonstop chất lượng cao MP3 320kbps dành riêng cho thành viên gói Standard & Premium VIP (Nghe Full)</span>
                        </div>
                        @if (Model.IsStandardUser)
                        {
                            <span class="badge badge-standard-red px-3.5 py-2 fw-bold rounded-pill shadow-sm">
                                <i class="fas fa-certificate me-1"></i> ĐÃ MỞ KHÓA NHÓM VIP
                            </span>
                        }
                        else
                        {
                            <a href="/Goi-Hoi-Vien" class="btn btn-sm btn-shimmer-ruby"><i class="fas fa-gem me-1"></i> Nâng Cấp Standard</a>
                        }
                    </div>

                    <div class="row g-4">
                        @foreach (var track in Model.NhomNonstops)
                        {
                            var cleanQuality = (track.QualityAvailable != null && track.QualityAvailable.ToUpperInvariant().Contains("WAV")) ? "WAV" : "MP3";

                            <div class="col-12 col-sm-6 col-lg-4 nonstop-item-card" data-title="@track.Title.ToLower()" data-artist="@track.Artist.ToLower()" data-genre="@track.Genre.ToLower()" data-tier="nhom">
                                <div class="crystal-card border-nhom-red">
                                    <div class="crystal-card-img-wrapper">
                                        <img src="@track.CoverUrl" alt="@track.Title" class="crystal-card-img" />

                                        <div class="position-absolute top-0 start-0 p-2 d-flex gap-1 flex-wrap">
                                            <span class="badge badge-standard-red"><i class="fas fa-certificate me-1"></i>NHÓM</span>
                                            <span class="badge badge-standard-red font-monospace fw-bold">@cleanQuality</span>
                                            <span class="badge bg-dark bg-opacity-75 text-danger font-monospace fw-bold" style="font-size: 0.7rem;"><i class="fas fa-layer-group me-1"></i>NONSTOP</span>
                                        </div>
                                        <div class="position-absolute top-0 end-0 p-2">
                                            <span class="badge-shimmer-ruby">NHÓM SET</span>
                                        </div>

                                        <button class="crystal-play-btn btn-play-trigger"
                                                onclick='playTrack({
                                                    id: "@track.Id",
                                                    title: "@track.Title.Replace("\"", "\\\"")",
                                                    artist: "@track.Artist.Replace("\"", "\\\"")",
                                                    coverUrl: "@track.CoverUrl",
                                                    audioUrl: "@track.AudioUrl",
                                                    bpm: @track.Bpm,
                                                    key: "@track.MusicalKey",
                                                    durationSeconds: @track.DurationSeconds,
                                                    categoryCode: "@track.CategoryCode",
                                                    trackType: "nhom",
                                                    kind: "Nonstop",
                                                    isDemo: @((!Model.IsStandardUser).ToString().ToLower()),
                                                    demoLimit: 30,
                                                    quality: "@cleanQuality",
                                                    tierRequired: "Standard"
                                                })'>
                                            <i class="fas fa-play"></i>
                                        </button>

                                        <div class="position-absolute bottom-0 start-0 p-2">
                                            <span class="badge bg-dark bg-opacity-75 text-danger small border border-danger border-opacity-50">
                                                <i class="fas fa-gem me-1"></i> VIP Standard & Premium
                                            </span>
                                        </div>

                                        <div class="position-absolute bottom-0 end-0 p-2">
                                            <span class="badge bg-dark bg-opacity-75 text-white font-monospace small">
                                                @track.FormattedDuration
                                            </span>
                                        </div>
                                    </div>

                                    <div class="crystal-card-body">
                                        <h3 class="crystal-card-title text-accent-standard font-weight-bold">
                                            <a href="/Track/Detail/@track.Id" class="text-accent-standard track-title-link text-decoration-none" title="Bấm để xem trang chi tiết tác phẩm">
                                                @track.Title
                                            </a>
                                        </h3>
                                        <div class="crystal-card-artist"><i class="fas fa-headphones text-danger me-1"></i> @track.Artist</div>

                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <span class="badge-standard-red font-monospace fw-bold" style="font-size: 0.72rem; padding: 2px 8px;">@cleanQuality</span>
                                            @if (Model.IsStandardUser)
                                            {
                                                <span class="text-danger small"><i class="fas fa-circle-check text-danger me-1"></i> Đã mở khóa Standard</span>
                                            }
                                            else
                                            {
                                                <span class="text-dim small"><i class="fas fa-certificate text-danger me-1"></i> Cần Standard VIP</span>
                                            }
                                        </div>

                                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                                            <div class="d-flex align-items-center gap-2">
                                                <button class="btn btn-sm btn-link text-dim p-0" onclick="toggleFavorite('@track.Id', this)" title="Yêu thích">
                                                    <i class="far fa-heart"></i>
                                                </button>
                                                <span class="text-dim small"><i class="fas fa-headphones-simple me-1"></i> @track.PlaysCount.ToString("N0")</span>
                                            </div>
                                            <button class="btn btn-sm btn-download-standard px-3 py-1" onclick="handleDownload('@track.Id', '@track.Title.Replace("'", "\\'")', '@track.TierRequiredToDownload')">
                                                <i class="fas fa-arrow-down-to-bracket me-1"></i> Tải
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- SUB-SECTION C: NONSTOP LỌT HOT NHẤT (NGHE FULL MIỄN PHÍ 100%) -->
            @if (Model.LotNonstops.Any())
            {
                <section id="homeNonstopLotSection" class="nonstop-tier-section mb-5" data-tier-section="lot">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <div>
                            <h3 class="h5 text-white font-weight-bold mb-1 d-flex align-items-center gap-2">
                                <i class="fas fa-fire-flame-curved text-danger"></i>
                                <span class="text-white">NONSTOP LỌT HOT NHẤT (NGHE FULL 100%)</span>
                                <span class="badge bg-secondary ms-2" style="font-size: 0.7rem;">MIỄN PHÍ</span>
                            </h3>
                            <span class="text-dim small">Các bản mix thịnh hành lọt từ phòng thu, nghe và tải miễn phí 100%</span>
                        </div>
                        <a href="#masterTrackContainer" onclick="switchMusicSectionView('track')" class="btn btn-sm btn-glass-crystal">Xem Kho Track <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>

                    <div class="row g-4">
                        @foreach (var track in Model.LotNonstops)
                        {
                            var cleanQuality = (track.QualityAvailable != null && track.QualityAvailable.ToUpperInvariant().Contains("WAV")) ? "WAV" : "MP3";

                            <div class="col-12 col-sm-6 col-lg-4 nonstop-item-card" data-title="@track.Title.ToLower()" data-artist="@track.Artist.ToLower()" data-genre="@track.Genre.ToLower()" data-tier="lot">
                                <div class="crystal-card">
                                    <div class="crystal-card-img-wrapper">
                                        <img src="@track.CoverUrl" alt="@track.Title" class="crystal-card-img" />

                                        <div class="position-absolute top-0 start-0 p-2 d-flex gap-1 flex-wrap">
                                            <span class="badge bg-secondary">LỌT</span>
                                            <span class="badge badge-standard-red font-monospace fw-bold">@cleanQuality</span>
                                            <span class="badge bg-dark bg-opacity-75 text-white font-monospace fw-bold" style="font-size: 0.7rem;"><i class="fas fa-layer-group me-1"></i>NONSTOP</span>
                                        </div>
                                        <div class="position-absolute top-0 end-0 p-2">
                                            <span class="badge-shimmer-cyan">SET MIX</span>
                                        </div>

                                        <button class="crystal-play-btn btn-play-trigger"
                                                onclick='playTrack({
                                                    id: "@track.Id",
                                                    title: "@track.Title.Replace("\"", "\\\"")",
                                                    artist: "@track.Artist.Replace("\"", "\\\"")",
                                                    coverUrl: "@track.CoverUrl",
                                                    audioUrl: "@track.AudioUrl",
                                                    bpm: @track.Bpm,
                                                    key: "@track.MusicalKey",
                                                    durationSeconds: @track.DurationSeconds,
                                                    categoryCode: "@track.CategoryCode",
                                                    trackType: "lot",
                                                    kind: "Nonstop",
                                                    isDemo: false,
                                                    demoLimit: 0,
                                                    quality: "@cleanQuality",
                                                    tierRequired: "@track.TierRequiredToDownload"
                                                })'>
                                            <i class="fas fa-play"></i>
                                        </button>

                                        <div class="position-absolute bottom-0 start-0 p-2">
                                            <span class="badge bg-dark bg-opacity-75 text-success small border border-success border-opacity-50">
                                                <i class="fas fa-circle-check me-1"></i> Nghe Full 100% Free
                                            </span>
                                        </div>

                                        <div class="position-absolute bottom-0 end-0 p-2">
                                            <span class="badge bg-dark bg-opacity-75 text-white font-monospace small">
                                                @track.FormattedDuration
                                            </span>
                                        </div>
                                    </div>

                                    <div class="crystal-card-body">
                                        <h3 class="crystal-card-title font-weight-bold">
                                            <a href="/Track/Detail/@track.Id" class="text-white track-title-link text-decoration-none" title="Bấm để xem trang chi tiết tác phẩm">
                                                @track.Title
                                            </a>
                                        </h3>
                                        <div class="crystal-card-artist"><i class="fas fa-headphones text-danger me-1"></i> @track.Artist</div>

                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <span class="badge bg-secondary font-monospace fw-bold" style="font-size: 0.72rem; padding: 2px 8px;">@cleanQuality</span>
                                            <span class="text-dim small text-success"><i class="fas fa-unlock me-1"></i> Miễn Phí</span>
                                        </div>

                                        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                                            <div class="d-flex align-items-center gap-2">
                                                <button class="btn btn-sm btn-link text-dim p-0" onclick="toggleFavorite('@track.Id', this)" title="Yêu thích">
                                                    <i class="far fa-heart"></i>
                                                </button>
                                                <span class="text-dim small"><i class="fas fa-headphones-simple me-1"></i> @track.PlaysCount.ToString("N0")</span>
                                            </div>
                                            <button class="btn btn-sm btn-glass-crystal px-3 py-1" onclick="handleDownload('@track.Id', '@track.Title.Replace("'", "\\'")', '@track.TierRequiredToDownload')">
                                                <i class="fas fa-arrow-down-to-bracket me-1"></i> Tải
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    </div>

    <!-- ==========================================
         SECTION 4: BẢNG GÓI HỘI VIÊN (DIAMOND MEMBERSHIP)
         PHÂN CẤP: STANDARD (ĐỎ) vs PREMIUM (VÀNG)
         ========================================== -->
    <section id="pricingSection" class="mb-5 py-4">
        <div class="text-center mb-5">
            <span class="hero-pill-badge mb-2">💎 MEMBERSHIP PRIVILEGES</span>
            <h2 class="crystal-hero-title" style="font-size: 2.2rem;">
                CHỌN GÓI ĐỂ <span class="text-gradient-shimmer">TẢI NHẠC KHÔNG GIỚI HẠN</span>
            </h2>
            <p class="text-dim small">Nâng cấp tài khoản nhận ngay đặc quyền tải nhạc Master WAV 24-bit và kho Nonstop đặt</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var plan in Model.Plans)
            {
                var cardTierClass = "crystal-pricing-card";
                if (plan.TierCode == "standard") { cardTierClass += " card-tier-standard"; }
                else if (plan.TierCode == "premium") { cardTierClass += " card-tier-premium"; }

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="@cardTierClass" data-plan-tier="@plan.TierCode" id="pricingCard-@plan.TierCode">
                        @if (!string.IsNullOrEmpty(plan.BadgeText))
                        {
                            <div class="position-absolute top-0 end-0 mt-3 me-3">
                                @if (plan.TierCode == "standard")
                                {
                                    <span class="badge badge-standard-red px-3 py-1">
                                        <i class="fas fa-fire me-1"></i> @plan.BadgeText
                                    </span>
                                }
                                else if (plan.TierCode == "premium")
                                {
                                    <span class="badge badge-premium-gold px-3 py-1">
                                        <i class="fas fa-crown me-1"></i> @plan.BadgeText
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-1">
                                        @plan.BadgeText
                                    </span>
                                }
                            </div>
                        }

                        @if (plan.TierCode == "premium")
                        {
                            <h3 class="text-accent-premium font-weight-bold mb-1" style="font-size: 1.35rem;">
                                <i class="fas fa-crown me-2"></i>@plan.Name
                            </h3>
                        }
                        else if (plan.TierCode == "standard")
                        {
                            <h3 class="text-accent-standard font-weight-bold mb-1" style="font-size: 1.35rem;">
                                <i class="fas fa-certificate me-2"></i>@plan.Name
                            </h3>
                        }
                        else
                        {
                            <h3 class="text-white font-weight-bold mb-1" style="font-size: 1.25rem;">
                                @plan.Name
                            </h3>
                        }

                        <!-- Active Subscription Indicator Badge (Populated dynamically) -->
                        <div class="plan-active-indicator d-none mt-2 mb-1 p-2 rounded-3 text-center fw-bold" id="planActiveBadge-@plan.TierCode"></div>

                        <div class="d-flex align-items-baseline gap-1 my-3">
                            <span class="crystal-price">@plan.Price.ToString("N0")đ</span>
                            <span class="text-dim small">@plan.BillingPeriod</span>
                        </div>

                        <p class="text-dim small mb-0">
                            @(plan.TierCode == "free" ? "Dành cho người nghe trải nghiệm các bản lọt thông thường." :
                              plan.TierCode == "standard" ? "Điểm nhấn ĐỎ: Dành cho DJ tải kho Track Nhóm & MP3 320kbps hàng ngày." :
                              "Điểm nhấn VÀNG: Dành cho DJ Bar Club & Pro tải Full Master WAV 24-Bit và Track Slot độc quyền.")
                        </p>

                        <hr style="border-color: rgba(255, 255, 255, 0.08);" />

                        <ul class="crystal-features-list">
                            @foreach (var feature in plan.Features)
                            {
                                <li>
                                    @if (plan.TierCode == "premium")
                                    {
                                        <i class="fas fa-crown" style="color: #ffd166; filter: drop-shadow(0 0 6px rgba(255, 209, 102, 0.8));"></i>
                                    }
                                    else if (plan.TierCode == "standard")
                                    {
                                        <i class="fas fa-check-circle" style="color: #ff134a; filter: drop-shadow(0 0 6px rgba(255, 19, 74, 0.8));"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-gem text-secondary"></i>
                                    }
                                    <span>@feature</span>
                                </li>
                            }
                        </ul>

                        @if (plan.TierCode == "free")
                        {
                            <button class="btn btn-glass-crystal w-100 py-3 mt-auto font-weight-bold" onclick="switchUserTier('free');">
                                <i class="fas fa-user me-2"></i> @plan.ButtonText
                            </button>
                        }
                        else if (plan.TierCode == "standard")
                        {
                            <button class="btn btn-shimmer-ruby w-100 py-3 mt-auto font-weight-bold"
                                    onclick="openCheckoutModal('@plan.Name', @((int)plan.Price));">
                                <i class="fas fa-qrcode me-2"></i> @plan.ButtonText
                            </button>
                        }
                        else if (plan.TierCode == "premium")
                        {
                            <button class="btn btn-shimmer-gold w-100 py-3 mt-auto font-weight-bold"
                                    onclick="openCheckoutModal('@plan.Name', @((int)plan.Price));">
                                <i class="fas fa-crown me-2"></i> @plan.ButtonText
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<!-- ==========================================
     MODAL THÔNG TIN TÁC PHẨM ÂM NHẠC (MUSIC INFO MODAL)
     ========================================== -->
<div class="modal fade" id="musicInfoModal" tabindex="-1" aria-labelledby="musicInfoModalLabel" aria-hidden="true" style="z-index: 1075;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="background: rgba(14, 15, 26, 0.96); backdrop-filter: blur(28px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 24px; box-shadow: 0 0 60px rgba(0, 0, 0, 0.9), 0 0 30px rgba(255, 19, 74, 0.25);">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge p-2 fs-6 rounded-circle" id="modalHeaderBadgeIcon" style="background: rgba(255, 19, 74, 0.2); color: #ff134a; border: 1px solid rgba(255, 19, 74, 0.4);">
                        <i class="fas fa-compact-disc"></i>
                    </span>
                    <div>
                        <h5 class="modal-title text-white fw-bold mb-0" id="musicInfoModalLabel" style="letter-spacing: 0.5px;">THÔNG TIN TÁC PHẨM</h5>

                        <div class="position-relative d-inline-block shadow-lg rounded-4 overflow-hidden" style="border: 2px solid rgba(255, 255, 255, 0.15);">
                            <img id="modalTrackCover" src="/images/logo.png" alt="Cover" class="img-fluid rounded-4" style="width: 250px; height: 250px; object-fit: cover; display: block;" onerror="this.src='/images/logo.png'" />
                            <div class="position-absolute top-0 start-0 p-2">
                                <span id="modalTrackQualityBadge" class="badge badge-premium-gold font-monospace fw-bold">WAV</span>
                            </div>
                            <div class="position-absolute top-0 end-0 p-2">
                                <span id="modalTrackKindBadge" class="badge bg-dark bg-opacity-75 text-white font-monospace">TRACK</span>
                            </div>
                        </div>
                    </div>
                    <!-- Thông tin chi tiết -->
                    <div class="col-12 col-md-7">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span id="modalTierBadge" class="badge badge-premium-gold"><i class="fas fa-crown me-1"></i>SLOT VIP</span>
                            <span id="modalGenreBadge" class="badge" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #e0e0e0;">Vinahouse</span>
                        </div>
                        <h4 class="text-white fw-bold mb-1" id="modalTrackTitle" style="word-break: break-word;">Tên Bài Hát</h4>
                        <div class="text-dim mb-3" id="modalTrackArtist" style="font-size: 0.95rem;">
                            <i class="fas fa-headphones-simple text-danger me-1"></i> <span>Nghệ Sĩ</span>
                        </div>

                        <!-- Lưới Metadata BPM, Key, Thời lượng, Phát hành -->
                        <div class="row g-2 mb-3">

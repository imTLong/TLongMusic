        background: linear-gradient(135deg, #ffd166, #ff9f1c) !important;
        color: #121320 !important;
        box-shadow: 0 0 20px rgba(255, 209, 102, 0.5) !important;
        border-color: rgba(255, 209, 102, 0.8) !important;
    }
    .music-subtab-btn#subtab-nonstop-btn.active .badge {
        background: #121320 !important;
        color: #ffd166 !important;
    }
    .music-subtab-btn#subtab-nonstop-btn:not(.active) .badge {
        background: rgba(255, 209, 102, 0.2) !important;
        color: #ffd166 !important;
    }
</style>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Tự động di chuyển các modal ra ngoài <body> để thoát khỏi stacking context của <main>
        ['adminExtendModal', 'adminCreateProducerModal', 'adminMusicDeleteModal', 'adminBulkDeleteModal'].forEach(function(id) {
            const el = document.getElementById(id);
            if (el && el.parentElement !== document.body) {
                document.body.appendChild(el);
            }
            if (el) {
                el.addEventListener('hidden.bs.modal', function() {
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                });
            }
        });

        // 1. Phân quyền chặt chẽ: Kiểm tra nếu không phải Admin thì chặn ngay
        setTimeout(function() {
            const user = window.TLongPlayer ? window.TLongPlayer.currentUser : null;
            if (!user) {
                // Kiểm tra từ server
                fetch('/Auth/Me').then(r => r.json()).then(data => {
                    if (!data.success || (data.user?.primaryRole !== 'Admin' && data.user?.role !== 'Admin')) {
                        alert("⚠️ CẢNH BÁO BẢO MẬT:\nTrang này chỉ dành riêng cho Quản Trị Viên (Admin)!\nBạn sẽ được chuyển hướng về trang chủ.");
                        window.location.href = '/';
                    } else {
                        initAdminPage(data.user);
                    }
                }).catch(() => {
                    window.location.href = '/';
                });
            } else if (user.primaryRole !== 'Admin' && user.role !== 'Admin') {
                alert("⚠️ CẢNH BÁO BẢO MẬT:\nTrang này chỉ dành riêng cho Quản Trị Viên (Admin)!\nBạn sẽ được chuyển hướng về trang chủ.");
                window.location.href = '/';
            } else {
                initAdminPage(user);
            }
        }, 150);
    });

    function initAdminPage(adminUser) {
        // Nạp thông tin ngân hàng hiển thị ở Tab 4
        if (adminUser) {
            document.getElementById('adminDisplayBankName').textContent = adminUser.bankName || 'MB Bank (Quân Đội)';
            document.getElementById('adminDisplayBankAccount').textContent = adminUser.bankAccountNumber || '0988.888.888';
            document.getElementById('adminDisplayAccountHolder').textContent = adminUser.bankAccountHolder || adminUser.fullName || 'NGUYEN THANH LONG';
        }

        // Tự động load dữ liệu
        loadAdminStats();
        loadAdminProducers();
        loadAdminMusics();
        loadAdminUsers();
        initAdminQrGenerator(adminUser);
    }

    function refreshAdminData() {
        showToastNotification("🔄 Đang làm mới toàn bộ dữ liệu quản trị...");
        loadAdminStats();
        loadAdminProducers(true);
        loadAdminMusics(true);
        loadAdminUsers(true);
    }

    /* ========================================================
       CÔNG CỤ TẠO MÃ VIETQR TÙY CHỈNH THEO SỐ TIỀN & NỘI DUNG
       ======================================================== */
    let currentAdminBankData = {
        bank: 'MB',
        account: '0988888888',
        holder: 'NGUYEN THANH LONG'
    };

    function initAdminQrGenerator(adminUser) {
        if (adminUser) {
            if (adminUser.bankAccountNumber) {
                currentAdminBankData.account = adminUser.bankAccountNumber.trim();
            }
            if (adminUser.bankAccountHolder || adminUser.fullName) {
                currentAdminBankData.holder = (adminUser.bankAccountHolder || adminUser.fullName).trim().toUpperCase();
            }
            if (adminUser.bankName) {
                const b = adminUser.bankName.toUpperCase();
                if (b.includes('VIETCOM') || b.includes('VCB')) currentAdminBankData.bank = 'VCB';
                else if (b.includes('TECHCOM') || b.includes('TCB')) currentAdminBankData.bank = 'TCB';
                else if (b.includes('VIETIN') || b.includes('ICB') || b.includes('CTG')) currentAdminBankData.bank = 'ICB';
                else if (b.includes('BIDV')) currentAdminBankData.bank = 'BIDV';
                else if (b.includes('ACB')) currentAdminBankData.bank = 'ACB';
                else if (b.includes('VPB') || b.includes('VPBANK')) currentAdminBankData.bank = 'VPB';
                else if (b.includes('TPB') || b.includes('TPBANK')) currentAdminBankData.bank = 'TPB';
                else if (b.includes('AGRI') || b.includes('VBA')) currentAdminBankData.bank = 'VBA';
                else if (b.includes('SACOM') || b.includes('STB')) currentAdminBankData.bank = 'STB';
                else if (b.includes('HDB')) currentAdminBankData.bank = 'HDB';
                else if (b.includes('VIB')) currentAdminBankData.bank = 'VIB';
                else if (b.includes('SHB')) currentAdminBankData.bank = 'SHB';
                else if (b.includes('MSB')) currentAdminBankData.bank = 'MSB';
                else if (b.includes('LPB') || b.includes('LIENVIET')) currentAdminBankData.bank = 'LPB';
                else if (b.includes('OCB')) currentAdminBankData.bank = 'OCB';
                else if (b.includes('SEAB')) currentAdminBankData.bank = 'SEAB';
                else currentAdminBankData.bank = 'MB';
            }
        }

        resetQrForm();
    }

    function resetQrForm() {
        const bankSelect = document.getElementById('qrGenBank');
        const accInput = document.getElementById('qrGenAccount');
        const holderInput = document.getElementById('qrGenAccountHolder');
        const amtInput = document.getElementById('qrGenAmount');
        const contentInput = document.getElementById('qrGenContent');

        if (bankSelect) bankSelect.value = currentAdminBankData.bank;
        if (accInput) accInput.value = currentAdminBankData.account;
        if (holderInput) holderInput.value = currentAdminBankData.holder;
        if (amtInput) amtInput.value = 100000;
        if (contentInput) {
            const randCode = Math.floor(100000 + Math.random() * 900000);
            contentInput.value = `TLONG VIP ${randCode}`;
        }

        updateQrAmountFormatted();
        generateCustomQr();
    }

    function setQuickAmount(amount) {
        const amtInput = document.getElementById('qrGenAmount');
        if (amtInput) {
            amtInput.value = amount;
            updateQrAmountFormatted();
            generateCustomQr();
        }
    }

    function updateQrAmountFormatted() {
        const amtInput = document.getElementById('qrGenAmount');
        const display = document.getElementById('qrFormattedAmount');
        const val = parseInt(amtInput?.value) || 0;
        if (display) {
            display.textContent = new Intl.NumberFormat('vi-VN').format(val) + ' VNĐ';
        }
    }

    function generateCustomQr() {
        const bank = document.getElementById('qrGenBank')?.value || 'MB';
        const rawAccount = (document.getElementById('qrGenAccount')?.value || '').trim();
        const cleanAccount = rawAccount.replace(/[.\s-]/g, '');
        const holder = (document.getElementById('qrGenAccountHolder')?.value || '').trim().toUpperCase();
        const amount = parseInt(document.getElementById('qrGenAmount')?.value) || 0;
        const content = (document.getElementById('qrGenContent')?.value || '').trim();
        const template = document.querySelector('input[name="qrTemplate"]:checked')?.value || 'compact2';

        const bankSelect = document.getElementById('qrGenBank');
        const bankText = bankSelect ? bankSelect.options[bankSelect.selectedIndex].text : bank;

        if (!cleanAccount) {
            return;
        }

        // Link chuẩn VietQR API quốc gia
        // https://img.vietqr.io/image/<BANK_ID>-<ACCOUNT_NO>-<TEMPLATE>.png?amount=<AMOUNT>&addInfo=<DESCRIPTION>&accountName=<ACCOUNT_NAME>
        let qrUrl = `https://img.vietqr.io/image/${bank}-${cleanAccount}-${template}.png?amount=${amount}&addInfo=${encodeURIComponent(content)}&accountName=${encodeURIComponent(holder)}`;

        const imgElem = document.getElementById('qrGeneratedImage');
        if (imgElem) {
            imgElem.src = qrUrl;
        }

        // Cập nhật bảng tóm tắt
        const sumBank = document.getElementById('qrSummaryBank');
        const sumAcc = document.getElementById('qrSummaryAccount');
        const sumHolder = document.getElementById('qrSummaryHolder');
        const sumAmt = document.getElementById('qrSummaryAmount');
        const sumContent = document.getElementById('qrSummaryContent');

        if (sumBank) sumBank.textContent = bankText;
        if (sumAcc) sumAcc.textContent = rawAccount;
        if (sumHolder) sumHolder.textContent = holder || '(Chưa điền)';
        if (sumAmt) sumAmt.textContent = new Intl.NumberFormat('vi-VN').format(amount) + ' VNĐ';
        if (sumContent) sumContent.textContent = content || '(Để trống)';
    }

    function copyQrLink() {
        const imgElem = document.getElementById('qrGeneratedImage');
        if (imgElem && imgElem.src) {
            navigator.clipboard.writeText(imgElem.src).then(() => {
                alert('✅ ĐÃ SAO CHÉP LINK ẢNH VIETQR!\nBạn có thể dán (Paste) để gửi cho khách hàng qua Zalo/Facebook.');
            }).catch(() => {
                prompt('Link ảnh mã QR của bạn:', imgElem.src);
            });
        }
    }

    function downloadQrImage() {
        const imgElem = document.getElementById('qrGeneratedImage');
        if (!imgElem || !imgElem.src) return;
        const link = document.createElement('a');
        link.href = imgElem.src;
        link.target = '_blank';
        link.download = `VietQR_${Date.now()}.png`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function openQrFullScreen() {
        const imgElem = document.getElementById('qrGeneratedImage');
        if (imgElem && imgElem.src) {
            window.open(imgElem.src, '_blank');
        }
    }
</script>
}

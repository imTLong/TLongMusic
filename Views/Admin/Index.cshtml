@{
    ViewData["Title"] = "Trung Tâm Điều Hành Admin - TLongMusic";
}

<div class="container-fluid px-3 px-xl-5 py-4" style="max-width: 1720px;">
    <!-- HEADER HERO COMMAND CENTER -->
    <div class="admin-hero-banner p-4 p-md-5 mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4 position-relative" style="z-index: 2;">
            <div>
                <!-- System Status Bar -->
                <div class="d-flex align-items-center mb-2.5">
                    <span class="badge bg-danger text-white px-3 py-1.5 rounded-pill fw-bold text-uppercase d-flex align-items-center gap-2 shadow-sm" style="letter-spacing: 0.8px; font-size: 0.75rem;">
                        <i class="fas fa-shield-halved"></i> SUPER ADMIN CONTROL PANEL
                    </span>
                </div>
                <h2 class="text-white fw-bold mb-2 display-6">TRUNG TÂM ĐIỀU HÀNH HỆ THỐNG</h2>
                <p class="text-dim mb-0" style="max-width: 820px; font-size: 0.95rem; line-height: 1.6;">
                    Trang điều khiển trung tâm dành riêng cho <strong>Quản Trị Viên (Admin)</strong>: Quản lý kho Track & Nonstop, kiểm duyệt phân quyền Producer, theo dõi biến động doanh thu VietQR và cấu hình thanh toán VIP.
                </p>
            </div>

            <!-- Quick Action Toolbar -->
            <div class="d-flex flex-wrap align-items-center gap-2.5">
                <button class="btn btn-outline-light rounded-pill px-3.5 py-2 fw-bold d-flex align-items-center gap-2 shadow-sm" onclick="refreshAdminData()">
                    <i class="fas fa-rotate"></i> <span>Làm Mới</span>
                </button>
                <button class="btn btn-outline-warning rounded-pill px-3.5 py-2 fw-bold d-flex align-items-center gap-2 shadow-sm" onclick="document.getElementById('adm-settings-tab').click()">
                    <i class="fas fa-building-columns"></i> <span>STK Nhận Tiền VIP</span>
                </button>
                <a href="/" class="btn btn-glass-crystal rounded-pill px-3.5 py-2 text-white d-flex align-items-center gap-2">
                    <i class="fas fa-house"></i> <span>Về Trang Chủ</span>
                </a>
            </div>
        </div>
    </div>

    <!-- MAIN TABS CONTAINER -->
    <div class="p-3 p-md-4 rounded-4 border border-secondary border-opacity-25 mb-5"
         style="background: rgba(15, 16, 28, 0.95); backdrop-filter: blur(30px); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">

        <!-- NAVIGATION TABS -->
        <ul class="nav admin-nav-tabs mb-4" id="adminDedicatedTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="adm-stats-tab" data-bs-toggle="pill" data-bs-target="#adm-stats-pane" type="button" role="tab">
                    <i class="fas fa-chart-line text-success"></i>
                    <span>1. Thống Kê & Doanh Thu</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="adm-producers-tab" data-bs-toggle="pill" data-bs-target="#adm-producers-pane" type="button" role="tab">
                    <i class="fas fa-headphones text-warning"></i>
                    <span>2. Quản Lý Producers</span>
                    <span class="badge bg-dark border border-secondary text-warning font-monospace" id="badgeAdmProducerCount">...</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="adm-musics-tab" data-bs-toggle="pill" data-bs-target="#adm-musics-pane" type="button" role="tab">
                    <i class="fas fa-music text-danger"></i>
                    <span>3. Quản Lý Nhạc</span>
                    <span class="badge bg-dark border border-secondary text-danger font-monospace" id="badgeAdmMusicCount">...</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="adm-users-tab" data-bs-toggle="pill" data-bs-target="#adm-users-pane" type="button" role="tab">
                    <i class="fas fa-users-gear text-info"></i>
                    <span>4. Thành Viên & Gói VIP</span>
                    <span class="badge bg-dark border border-secondary text-info font-monospace" id="badgeAdmUserCount">...</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="adm-settings-tab" data-bs-toggle="pill" data-bs-target="#adm-settings-pane" type="button" role="tab">
                    <i class="fas fa-building-columns text-warning"></i>
                    <span>5. Cài Đặt STK & Gói VIP</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="adm-vietqr-tab" data-bs-toggle="pill" data-bs-target="#adm-vietqr-pane" type="button" role="tab">
                    <i class="fas fa-qrcode text-warning"></i>
                    <span>6. Tạo Mã VietQR Tùy Chỉnh</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="adminDedicatedTabContent">
            <!-- TAB 1: THỐNG KÊ & DOANH THU -->
            <div class="tab-pane fade show active" id="adm-stats-pane" role="tabpanel">
                <!-- GRID STATS RENDERED DYNAMICALLY VIA JS -->
                <div class="row g-3 mb-4" id="adminStatsGrid">
                    <div class="col-12 text-center py-5 text-dim">
                        <i class="fas fa-spinner fa-spin fa-2x mb-2 text-danger"></i>
                        <br />Đang tổng hợp dữ liệu thống kê từ Kho dữ liệu...
                    </div>
                </div>

                <!-- OPERATIONS & SYSTEM HEALTH ROW -->
                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="p-4 rounded-4 border border-secondary border-opacity-25 h-100" style="background: rgba(255, 255, 255, 0.02);">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-danger p-1.5 rounded-circle"><i class="fas fa-info text-white"></i></span>
                                <h5 class="text-white fw-bold mb-0">Cơ Chế Phân Phối & Quyền Lợi Toàn Hệ Thống</h5>
                            </div>
                            <ul class="text-dim small mb-0 ps-3 mt-3" style="line-height: 1.9;">
                                <li><strong>Doanh thu VietQR:</strong> Tiền nâng cấp gói hội viên của tất cả khách hàng được tự động xác nhận và chuyển thẳng 100% vào số tài khoản ngân hàng của <strong>Admin</strong>.</li>
                                <li><strong>Kho Track Nhóm & Nonstop Nhóm:</strong> Dành cho hội viên <strong>Standard VIP (99k)</strong> và <strong>Premium VIP (199k)</strong> tải file chất lượng cao MP3 320kbps. Thành viên Free chỉ nghe thử Demo.</li>
                                <li><strong>Kho Track Slot Độc Quyền:</strong> Đặc quyền tối cao dành riêng cho <strong>Premium VIP</strong> tải Full Lossless & Master WAV 24-Bit.</li>
                                <li><strong>Phân quyền Producer:</strong> Producer có quyền tự do phát hành bản thu vào kho cá nhân. Admin có toàn quyền tạm khóa hoặc gỡ bỏ bản quyền bất cứ lúc nào.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="p-4 rounded-4 border border-secondary border-opacity-25 h-100" style="background: rgba(255, 255, 255, 0.02);">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="text-white fw-bold mb-0"><i class="fas fa-server text-success me-2"></i>Trạng Thái Dịch Vụ</h5>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">100% HOẠT ĐỘNG</span>
                            </div>
                            <div class="p-2.5 rounded-3 bg-dark border border-secondary border-opacity-25 mb-2 d-flex justify-content-between align-items-center small font-monospace">
                                <span class="text-dim"><i class="fas fa-database text-info me-2"></i>Kho dữ liệu:</span>
                                <span class="text-success fw-bold">ONLINE (v16.0)</span>
                            </div>
                            <div class="p-2.5 rounded-3 bg-dark border border-secondary border-opacity-25 mb-2 d-flex justify-content-between align-items-center small font-monospace">
                                <span class="text-dim"><i class="fas fa-qrcode text-warning me-2"></i>Cổng thanh toán VietQR:</span>
                                <span class="text-success fw-bold">READY (NAPAS247)</span>
                            </div>
                            <div class="p-2.5 rounded-3 bg-dark border border-secondary border-opacity-25 mb-2 d-flex justify-content-between align-items-center small font-monospace">
                                <span class="text-dim"><i class="fas fa-cloud-arrow-down text-danger me-2"></i>Hệ thống CDN Tải Nhạc:</span>
                                <span class="text-success fw-bold">TỐC ĐỘ CAO</span>
                            </div>
                            <div class="p-2.5 rounded-3 bg-dark border border-secondary border-opacity-25 d-flex justify-content-between align-items-center small font-monospace">
                                <span class="text-dim"><i class="fas fa-lock text-primary me-2"></i>Bảo mật Cookie & JWT:</span>
                                <span class="text-success fw-bold">SECURED</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: QUẢN LÝ PRODUCERS -->
            <div class="tab-pane fade" id="adm-producers-pane" role="tabpanel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <h5 class="text-white fw-bold mb-1"><i class="fas fa-headphones text-warning me-2"></i>Quản Lý Nhà Sản Xuất Âm Nhạc (Producers)</h5>
                        <p class="text-dim small mb-0">Theo dõi, cấp phép và phân quyền tài khoản đăng tải nhạc cho các Producer / DJ Studio.</p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Search Producer -->
                        <div class="input-group input-group-sm rounded-pill border border-secondary border-opacity-50 overflow-hidden" style="max-width: 250px; background: rgba(0,0,0,0.4);">
                            <span class="input-group-text bg-transparent border-0 text-dim"><i class="fas fa-search"></i></span>
                            <input type="text" id="adminProducerSearchInput" class="form-control bg-transparent border-0 text-white" placeholder="Tìm nghệ danh, tài khoản..." oninput="filterAdminProducersTable()" />
                        </div>
                        <!-- Status Filter -->
                        <select id="adminProducerStatusFilter" class="form-select form-select-sm rounded-pill bg-dark text-white border-secondary" style="max-width: 170px;" onchange="filterAdminProducersTable()">
                            <option value="all">Tất cả trạng thái</option>
                            <option value="active">🟢 Đang hoạt động</option>
                            <option value="locked">🔴 Đã khóa</option>
                        </select>
                        <button class="btn btn-outline-light btn-sm rounded-pill px-3" onclick="loadAdminProducers(true)" title="Tải lại danh sách">
                            <i class="fas fa-rotate"></i>
                        </button>
                        <button class="btn btn-shimmer-ruby btn-sm px-3.5 py-1.5 fw-bold rounded-pill" onclick="openAdminCreateProducerModal()">
                            <i class="fas fa-user-plus me-1.5"></i> + Cấp Producer Mới
                        </button>
                    </div>
                </div>

                <div class="table-responsive rounded-4 border border-secondary border-opacity-25" id="adminProducersTableContainer">
                    <div class="p-5 text-center text-dim">Đang tải danh sách Producer...</div>
                </div>
            </div>

            <!-- TAB 3: QUẢN LÝ NHẠC (GỒM 2 TAB CON: TRACK & NONSTOP) -->
            <div class="tab-pane fade" id="adm-musics-pane" role="tabpanel">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                    <div>
                        <h4 class="text-white fw-bold mb-1 d-flex align-items-center gap-2">
                            <i class="fas fa-sliders text-danger"></i>
                            <span>Trung Tâm Quản Lý Âm Nhạc Toàn Hệ Thống</span>
                        </h4>
                        <p class="text-dim small mb-0">
                            Kiểm duyệt, nghe thử, bật/tắt hiển thị hoặc xóa vĩnh viễn các bản nhạc đơn lẻ (Track) và các bản mix (Nonstop) từ tất cả Producers.
                        </p>
                    </div>

                    <!-- 2 TAB CON: TRACK (LỌT/NHÓM/SLOT) VÀ NONSTOP (LỌT/NHÓM/SLOT) -->
                    <ul class="nav nav-pills p-1.5 rounded-pill border border-secondary border-opacity-40 shadow-lg flex-shrink-0" style="background: rgba(0, 0, 0, 0.55);" id="adminMusicSubTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active music-subtab-btn rounded-pill fw-bold px-4 py-2 d-flex align-items-center gap-2" id="subtab-track-btn" data-bs-toggle="pill" data-bs-target="#subtab-track-pane" type="button" role="tab">
                                <i class="fas fa-compact-disc"></i>
                                <span>Track (Lọt/Nhóm/Slot)</span>
                                <span class="badge rounded-pill font-monospace" id="badgeAdmTrackCount">0</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link music-subtab-btn rounded-pill fw-bold px-4 py-2 d-flex align-items-center gap-2" id="subtab-nonstop-btn" data-bs-toggle="pill" data-bs-target="#subtab-nonstop-pane" type="button" role="tab">
                                <i class="fas fa-fire-flame-curved"></i>
                                <span>Nonstop (Lọt/Nhóm/Slot)</span>
                                <span class="badge rounded-pill font-monospace" id="badgeAdmNonstopCount">0</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <!-- NỘI DUNG 2 TAB CON -->
                <div class="tab-content" id="adminMusicSubTabContent">
                    <!-- TAB CON 1: TRACK (LỌT / NHÓM / SLOT) -->
                    <div class="tab-pane fade show active" id="subtab-track-pane" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                            <div>
                                <h6 class="text-white fw-bold mb-0 text-uppercase d-flex align-items-center gap-2">
                                    <i class="fas fa-compact-disc text-danger"></i>
                                    <span>Danh Sách Track (Nhạc Lẻ)</span>
                                </h6>
                                <small class="text-dim">Toàn bộ bản thu đơn lẻ được phân loại rõ ràng theo từng phân cấp truy cập.</small>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <!-- Bulk Delete Track Button -->
                                <button id="btnBulkDeleteTracks" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold d-none shadow" onclick="confirmBulkDelete('Track')">
                                    <i class="fas fa-trash-can me-1"></i> Xóa Track Đã Chọn (<span id="countSelectedTracks">0</span>)
                                </button>
                                <!-- Search Track -->
                                <div class="input-group input-group-sm rounded-pill border border-secondary border-opacity-50 overflow-hidden" style="max-width: 250px; background: rgba(0,0,0,0.4);">
                                    <span class="input-group-text bg-transparent border-0 text-dim"><i class="fas fa-search"></i></span>
                                    <input type="text" id="adminTrackSearchInput" class="form-control bg-transparent border-0 text-white" placeholder="Tìm tên track, nghệ sĩ..." oninput="filterAdminTracksTable()" />
                                </div>
                                <!-- Status Filter -->
                                <select id="adminTrackStatusFilter" class="form-select form-select-sm rounded-pill bg-dark text-white border-secondary" style="max-width: 155px;" onchange="filterAdminTracksTable()">
                                    <option value="all">Tất cả trạng thái</option>
                                    <option value="Published">🟢 Đang hiển thị</option>
                                    <option value="Hidden">🔴 Đang ẩn</option>
                                </select>
                                <button class="btn btn-outline-light btn-sm rounded-pill px-3" onclick="loadAdminMusics(true)" title="Tải lại danh sách Track">
                                    <i class="fas fa-rotate"></i>
                                </button>
                            </div>
                        </div>

                        <!-- SUB-CATEGORY FILTER PILLS: TRACK (LỌT / NHÓM / SLOT) -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-sm subfilter-btn active" id="btnFilterTrackAll" onclick="setTrackSubFilter('all')">
                                <i class="fas fa-list me-1"></i> Tất Cả Track <span class="badge bg-secondary ms-1 font-monospace" id="badgeTrackCountAll">0</span>
                            </button>
                            <button type="button" class="btn btn-sm subfilter-btn text-warning" id="btnFilterTrackSlot" onclick="setTrackSubFilter('Slot')">
                                <i class="fas fa-crown me-1"></i> 👑 Track Slot (VIP) <span class="badge bg-warning text-dark ms-1 font-monospace" id="badgeTrackCountSlot">0</span>
                            </button>
                            <button type="button" class="btn btn-sm subfilter-btn text-danger" id="btnFilterTrackNhom" onclick="setTrackSubFilter('Nhom')">
                                <i class="fas fa-certificate me-1"></i> 💎 Track Nhóm <span class="badge bg-danger ms-1 font-monospace" id="badgeTrackCountNhom">0</span>
                            </button>
                            <button type="button" class="btn btn-sm subfilter-btn text-info" id="btnFilterTrackLot" onclick="setTrackSubFilter('Lot')">
                                <i class="fas fa-compact-disc me-1"></i> 🎵 Track Lọt (Free) <span class="badge bg-info bg-opacity-25 text-info ms-1 font-monospace" id="badgeTrackCountLot">0</span>
                            </button>
                        </div>

                        <div class="table-responsive rounded-4 border border-secondary border-opacity-25" id="adminTracksTableContainer">
                            <div class="p-5 text-center text-dim">Đang tải toàn bộ kho Track...</div>
                        </div>
                    </div>

                    <!-- TAB CON 2: NONSTOP (LỌT / NHÓM / SLOT) -->
                    <div class="tab-pane fade" id="subtab-nonstop-pane" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                            <div>
                                <h6 class="text-white fw-bold mb-0 text-uppercase d-flex align-items-center gap-2">
                                    <i class="fas fa-fire-flame-curved text-warning"></i>
                                    <span>Danh Sách Nonstop (Bản Mix Dài)</span>
                                </h6>
                                <small class="text-dim">Toàn bộ các set nhạc Nonstop Mix thời lượng dài từ các DJ & Producer Studio.</small>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <!-- Bulk Delete Nonstop Button -->
                                <button id="btnBulkDeleteNonstops" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold d-none shadow" onclick="confirmBulkDelete('Nonstop')">
                                    <i class="fas fa-trash-can me-1"></i> Xóa Nonstop Đã Chọn (<span id="countSelectedNonstops">0</span>)
                                </button>
                                <!-- Search Nonstop -->
                                <div class="input-group input-group-sm rounded-pill border border-secondary border-opacity-50 overflow-hidden" style="max-width: 250px; background: rgba(0,0,0,0.4);">
                                    <span class="input-group-text bg-transparent border-0 text-dim"><i class="fas fa-search"></i></span>
                                    <input type="text" id="adminNonstopSearchInput" class="form-control bg-transparent border-0 text-white" placeholder="Tìm tên nonstop, DJ..." oninput="filterAdminNonstopsTable()" />
                                </div>
                                <!-- Status Filter -->
                                <select id="adminNonstopStatusFilter" class="form-select form-select-sm rounded-pill bg-dark text-white border-secondary" style="max-width: 155px;" onchange="filterAdminNonstopsTable()">
                                    <option value="all">Tất cả trạng thái</option>
                                    <option value="Published">🟢 Đang hiển thị</option>
                                    <option value="Hidden">🔴 Đang ẩn</option>
                                </select>
                                <button class="btn btn-outline-light btn-sm rounded-pill px-3" onclick="loadAdminMusics(true)" title="Tải lại danh sách Nonstop">
                                    <i class="fas fa-rotate"></i>
                                </button>
                            </div>
                        </div>

                        <!-- SUB-CATEGORY FILTER PILLS: NONSTOP (LỌT / NHÓM / SLOT) -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-sm subfilter-btn active" id="btnFilterNonstopAll" onclick="setNonstopSubFilter('all')">
                                <i class="fas fa-list me-1"></i> Tất Cả Nonstop <span class="badge bg-secondary ms-1 font-monospace" id="badgeNonstopCountAll">0</span>
                            </button>
                            <button type="button" class="btn btn-sm subfilter-btn text-warning" id="btnFilterNonstopSlot" onclick="setNonstopSubFilter('Slot')">
                                <i class="fas fa-crown me-1"></i> 👑 Nonstop Slot (VIP) <span class="badge bg-warning text-dark ms-1 font-monospace" id="badgeNonstopCountSlot">0</span>
                            </button>
                            <button type="button" class="btn btn-sm subfilter-btn text-danger" id="btnFilterNonstopNhom" onclick="setNonstopSubFilter('Nhom')">
                                <i class="fas fa-certificate me-1"></i> 💎 Nonstop Nhóm <span class="badge bg-danger ms-1 font-monospace" id="badgeNonstopCountNhom">0</span>
                            </button>
                            <button type="button" class="btn btn-sm subfilter-btn text-info" id="btnFilterNonstopLot" onclick="setNonstopSubFilter('Lot')">
                                <i class="fas fa-bolt me-1"></i> 🔥 Nonstop Lọt (Free) <span class="badge bg-info bg-opacity-25 text-info ms-1 font-monospace" id="badgeNonstopCountLot">0</span>
                            </button>
                        </div>

                        <div class="table-responsive rounded-4 border border-secondary border-opacity-25" id="adminNonstopsTableContainer">
                            <div class="p-5 text-center text-dim">Đang tải toàn bộ kho Nonstop...</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 4: QUẢN LÝ & GIA HẠN USERS -->
            <div class="tab-pane fade" id="adm-users-pane" role="tabpanel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <h5 class="text-white fw-bold mb-1"><i class="fas fa-users text-danger me-2"></i>Danh Sách Thành Viên & Quản Lý Gói VIP</h5>
                        <p class="text-dim small mb-0">Theo dõi toàn bộ tài khoản thành viên, thời hạn VIP và sử dụng công cụ tùy chỉnh gia hạn ngày/tuần/tháng.</p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="input-group input-group-sm rounded-pill border border-secondary border-opacity-50 overflow-hidden" style="max-width: 240px; background: rgba(0,0,0,0.4);">
                            <span class="input-group-text bg-transparent border-0 text-dim"><i class="fas fa-search"></i></span>
                            <input type="text" id="adminUserSearchInput" class="form-control bg-transparent border-0 text-white" placeholder="Tìm tên, username..." oninput="filterAdminUsersTable()" />
                        </div>
                        <select id="adminUserRoleFilter" class="form-select form-select-sm rounded-pill bg-dark text-white border-secondary" style="max-width: 170px;" onchange="filterAdminUsersTable()">

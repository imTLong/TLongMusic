<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TLongMusic | Ruby Crystal & Shimmering Music Pool</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/logo.png" />

    <!-- Google Fonts: Plus Jakarta Sans & Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & FontAwesome Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Ruby Crystal Shimmer Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- LỚP NỀN LUNG LINH: CỰC QUANG (AURORA) & TINH THỂ SAO -->
    <div class="shimmer-bg-backdrop">
        <div class="aurora-glow aurora-1"></div>
        <div class="aurora-glow aurora-2"></div>
        <div class="aurora-glow aurora-3"></div>
        <canvas id="stardustCanvas"></canvas>
    </div>

    <!-- Seamless SPA Top Progress Bar -->
    <div id="seamlessProgressBar" class="seamless-progress-bar"></div>

    <!-- Crystal Glass Navigation Bar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg tlong-navbar">
            <div class="container-fluid px-3 px-xl-4 px-xxl-5" style="max-width: 1720px;">
                <!-- Brand Logo With Prismatic Glowing Ring -->
                <a class="tlong-logo-wrapper flex-shrink-0 text-nowrap me-3" asp-controller="Home" asp-action="Index">
                    <div class="tlong-logo-container">
                        <img src="~/images/logo.png" alt="TLongMusic Logo" class="tlong-logo-img" />
                    </div>
                    <h1 class="tlong-brand-title text-nowrap">TLONG<span>MUSIC</span></h1>
                </a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#tlongNavCollapse">
                    <i class="fas fa-bars-staggered fa-lg text-danger"></i>
                </button>

                <div class="collapse navbar-collapse" id="tlongNavCollapse">
                    <!-- Nav Links -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1 gap-xl-2">
                        <li class="nav-item">
                            <a class="nav-link tlong-nav-link text-nowrap @(Context.Request.Path == "/" || Context.Request.Path == "/Home" || Context.Request.Path == "/Home/Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-sparkles text-danger"></i> Khám Phá
                            </a>
                        </li>
                        <li class="nav-item" id="navItemKhoTrack" style="@(User.Identity?.IsAuthenticated == true ? "" : "display: none !important;")">
                            <a class="nav-link tlong-nav-link text-nowrap @(Context.Request.Path.StartsWithSegments("/Track") ? "active" : "")" href="/Track" onclick="return navigateToTrackPool(event);">
                                <i class="fas fa-compact-disc text-info"></i> 🎵 Kho Track DJ
                            </a>
                        </li>
                        <li class="nav-item" id="navItemKhoNonstop" style="@(User.Identity?.IsAuthenticated == true ? "" : "display: none !important;")">
                            <a class="nav-link tlong-nav-link text-nowrap @(Context.Request.Path.StartsWithSegments("/Nonstop") ? "active" : "")" href="/Nonstop">
                                <i class="fas fa-fire-flame-curved text-warning"></i> 🔥 Kho Nonstop
                            </a>
                        </li>
                        <li class="nav-item" id="navMembershipItem" style="@(User.IsInRole("Admin") || User.IsInRole("Producer") ? "display: none !important;" : "")">
                            <a class="nav-link tlong-nav-link text-nowrap @(Context.Request.Path.StartsWithSegments("/Goi-Hoi-Vien") || Context.Request.Path.StartsWithSegments("/Membership") ? "active" : "")" href="/Goi-Hoi-Vien">
                                <i class="fas fa-gem text-danger"></i> Gói Hội Viên
                            </a>
                        </li>
                    </ul>

                    <!-- Auth Section & Actions -->
                    <div class="d-flex align-items-center gap-2 flex-wrap flex-lg-nowrap ms-lg-2 mt-2 mt-lg-0">
                        <!-- ROLE-SPECIFIC PROMINENT MANAGEMENT BUTTONS (ADMIN / PRODUCER) -->
                        <div id="roleActionButtons" class="d-flex align-items-center gap-2 flex-wrap flex-lg-nowrap"></div>

                        <!-- NÚT ĐĂNG NHẬP / PROFILE NGƯỜI DÙNG -->
                        <div id="navbarAuthSection" class="text-nowrap">
                            <!-- Populated dynamically via JS -->
                            <button class="btn btn-glass-crystal d-flex align-items-center gap-2 py-2 px-3 rounded-pill text-nowrap" data-bs-toggle="modal" data-bs-target="#loginModal">
                                <i class="fas fa-arrow-right-to-bracket text-danger"></i>
                                <span class="text-nowrap">Đăng Nhập</span>
                            </button>
                        </div>

                        <!-- CTA VIP Button -->
                        <a id="navUpgradeVipBtn" href="/Payment/Checkout?package=Standard" onclick="openCheckoutModal('Standard', 99000); return false;" class="btn btn-shimmer-ruby d-inline-flex align-items-center gap-2 text-nowrap" style="@(User.IsInRole("Admin") || User.IsInRole("Producer") ? "display: none !important;" : "")">
                            <i class="fas fa-sparkles"></i> Nâng Cấp VIP
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" id="mainContentApp" style="position: relative;">
        @RenderBody()
    </main>

    <!-- Crystal Footer -->
    <footer class="mt-5 py-5 border-top" style="background: rgba(8, 9, 15, 0.85); backdrop-filter: blur(20px); border-color: rgba(255, 255, 255, 0.1) !important; position: relative; z-index: 2;">
        <div class="container px-lg-4">
            <div class="row g-4 justify-content-between">
                <div class="col-lg-6 col-md-7">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="tlong-logo-container" style="width: 40px; height: 40px;">
                            <img src="~/images/logo.png" alt="Logo" class="tlong-logo-img" style="width: 38px; height: 38px;" />
                        </div>
                        <h4 class="tlong-brand-title mb-0">TLONG<span>MUSIC</span></h4>
                    </div>
                    <p class="text-dim small mb-0" style="line-height: 1.7;">
                        Trải nghiệm không gian âm nhạc điện tử đẳng cấp với các Track nhạc, Nonstop đặt độc quyền, kho Track DJ ỉm và nhạc nhóm tháng. Hỗ trợ Producer upload chuẩn BPM / Key với chất lượng âm thanh Master chuẩn nhất. Mang lại trải nghiệm tốt nhất cho người sử dụng!
                    </p>
                </div>

                <div class="col-lg-4 col-md-5">
                    <h6 class="text-white font-weight-bold mb-3" style="font-size: 0.95rem;">Hỗ Trợ & Đặt Nhạc</h6>
                    <p class="text-dim small mb-2"><i class="fas fa-phone-alt text-danger me-2"></i> Zalo / Hotline: <strong class="text-white">0388862876</strong></p>
                    <p class="text-dim small mb-2"><i class="fas fa-envelope text-danger me-2"></i> Email: <strong class="text-white">tranphongbat8686@gmail.com</strong></p>
                    <p class="text-dim small mb-0"><i class="fas fa-shield-halved text-danger me-2"></i> Máy chủ tốc độ cao Cloudflare R2</p>
                </div>
            </div>

            <hr class="my-4" style="border-color: rgba(255, 255, 255, 0.08);" />

            <div class="text-center text-dim small">
                &copy; 2026 <strong>TLongMusic</strong>. Toàn bộ bản quyền thuộc về TLongMusic Studio.
            </div>
        </div>
    </footer>

    <!-- ==========================================
         STICKY BOTTOM PLAYER: THIẾT KẾ KHOA HỌC CHUẨN STUDIO DJ
         ========================================== -->
    <div class="tlong-player-bar">
        <div class="container-fluid px-3 px-xl-4" style="max-width: 1760px;">
            <div class="row align-items-center g-2 g-lg-3">
                <!-- VÙNG 1: THÔNG TIN BÀI HÁT & THÔNG SỐ STUDIO (LEFT) -->
                <div class="col-7 col-md-4 col-xl-3 d-flex align-items-center gap-2 gap-sm-2.5">
                    <a id="playerTrackCoverLink" href="javascript:void(0)" onclick="navigateToCurrentTrackDetail(event)" title="Xem trang chi tiết bài hát" class="player-cover-anchor">
                        <img id="playerTrackCover" src="~/images/logo.png" alt="Cover" class="player-track-cover" />
                        <div class="player-cover-glow"></div>
                    </a>
                    <div class="player-track-meta d-flex flex-column justify-content-center" style="min-width: 0; flex-grow: 1; overflow: hidden;">
                        <div class="d-flex align-items-center gap-1.5" style="overflow: hidden; max-width: 100%;">
                            <!-- Container Chữ Chạy Vòng Tròn Chậm -->
                            <div id="playerTitleMarqueeContainer" class="marquee-track-container" style="overflow: hidden; white-space: nowrap; flex-grow: 1; min-width: 0;">
                                <div id="playerMarqueeTrack" class="marquee-circular-track">
                                    <a id="playerTrackTitleLink" href="javascript:void(0)" onclick="navigateToCurrentTrackDetail(event)" title="Xem chi tiết bài hát" class="text-white text-decoration-none hover-gold d-inline-block">
                                        <h6 id="playerTrackTitle" class="text-white mb-0 fw-bold marquee-primary-text" style="font-size: 0.88rem; line-height: 1.25; display: inline-block; white-space: nowrap;">
                                            Chọn bài để phát
                                        </h6>
                                    </a>
                                    <span id="playerTrackTitleDuplicate" class="marquee-duplicate-text text-white fw-bold d-none" style="font-size: 0.88rem; line-height: 1.25; white-space: nowrap;"></span>
                                </div>
                            </div>
                            <span id="playerDemoBadge" class="badge-shimmer-ruby d-none flex-shrink-0" style="font-size: 0.58rem; padding: 1px 5px;">DEMO 30S</span>
                        </div>
                        <div class="d-flex align-items-center gap-1.5 mt-0.5 mt-sm-1 flex-wrap">
                            <span id="playerTrackArtist" class="text-dim text-truncate" style="max-width: 110px; font-size: 0.74rem;">TLong Studio</span>
                            <span id="playerTrackBpm" class="badge-bpm font-monospace flex-shrink-0" style="font-size: 0.62rem; padding: 1px 6px;">-- BPM</span>
                            <span id="playerTrackKey" class="badge-camelot font-monospace d-none d-sm-inline-block flex-shrink-0" style="font-size: 0.62rem; padding: 1px 6px;">--</span>
                        </div>
                    </div>
                    <!-- Quick Favorite Heart Button -->
                    <button id="playerBarFavBtn" class="player-btn-ctrl btn-quick-fav d-none d-sm-inline-flex ms-1" onclick="toggleCurrentTrackFavorite(this)" title="Yêu thích bài đang phát">
                        <i class="far fa-heart text-danger"></i>
                    </button>
                </div>

                <!-- VÙNG 2: BỘ ĐIỀU KHIỂN TRUNG TÂM & TIẾN TRÌNH THỜI GIAN (CENTER) -->
                <div class="col-12 col-md-5 col-xl-6 order-3 order-md-2 text-center py-0 d-flex flex-column justify-content-center align-items-center my-auto">
                    <div class="d-flex justify-content-center align-items-center gap-2 gap-sm-3 player-ctrl-row mb-1">
                        <!-- Shuffle Button -->
                        <button id="playerShuffleBtn" class="player-btn-ctrl d-none d-sm-inline-flex" onclick="toggleShuffle()" title="Phát ngẫu nhiên (Shuffle)">
                            <i class="fas fa-shuffle"></i>
                        </button>
                        <!-- Prev Track -->
                        <button id="playerPrevBtn" class="player-btn-step" onclick="playPrevTrack()" title="Bài trước (Prev)">
                            <i class="fas fa-backward-step"></i>
                        </button>
                        <!-- Skip -10s -->
                        <button class="player-btn-skip d-none d-md-inline-flex" onclick="skipTime(-10)" title="Lùi lại 10 giây">
                            <i class="fas fa-rotate-left"></i>
                        </button>
                        <!-- Main Master Play/Pause -->
                        <button id="playerPlayPauseBtn" class="player-btn-main mx-1" onclick="togglePlayPause()" title="Phát / Tạm dừng">
                            <i class="fas fa-play" style="margin-left: 2px;"></i>
                        </button>
                        <!-- Skip +10s (Tua tới đằng trước nút Next) -->
                        <button class="player-btn-skip d-none d-md-inline-flex" onclick="skipTime(10)" title="Tua tới 10 giây">
                            <i class="fas fa-rotate-right"></i>
                        </button>
                        <!-- Next Track -->
                        <button id="playerNextBtn" class="player-btn-step" onclick="playNextTrack()" title="Bài kế tiếp (Next)">
                            <i class="fas fa-forward-step"></i>
                        </button>
                        <!-- Repeat Button -->
                        <button id="playerRepeatBtn" class="player-btn-ctrl d-none d-sm-inline-flex" onclick="toggleRepeat()" title="Lặp lại (Off / All / One)">
                            <i class="fas fa-repeat"></i>
                        </button>
                    </div>

                    <!-- Digital Precision Seek Timeline -->
                    <div class="d-flex align-items-center gap-2 px-1 w-100 player-seek-row" style="margin-top: 4px;">
                        <span id="playerCurrentTime" class="font-monospace text-warning fw-bold digital-time-display" style="min-width: 44px; font-size: 0.78rem; letter-spacing: 0.5px;">00:00</span>
                        <div class="seek-slider-container flex-grow-1 position-relative">
                            <input type="range" id="playerSeekSlider" class="seek-slider w-100" min="0" max="100" value="0" />
                        </div>
                        <span id="playerDuration" class="font-monospace text-light fw-semibold digital-time-display" style="min-width: 44px; font-size: 0.78rem; letter-spacing: 0.5px; opacity: 0.85;">00:00</span>
                    </div>
                </div>

                <!-- VÙNG 3: ĐỊNH DẠNG ÂM THANH, ÂM LƯỢNG & NÚT TẢI NHẠC (RIGHT) -->
                <div class="col-5 col-md-3 col-xl-3 order-2 order-md-3 d-flex justify-content-end align-items-center gap-2 gap-lg-3">
                    <!-- Format Badge (hidden để giữ id cho JS) -->
                    <span id="playerTrackQuality" class="d-none"></span>

                    <!-- Volume Control with Click-to-Mute (Desktop only) -->
                    <div class="d-none d-md-flex align-items-center gap-2 player-volume-box">
                        <button class="player-btn-ctrl p-0" onclick="toggleMute()" title="Bật/Tắt tiếng (Mute)">
                            <i id="volumeIcon" class="fas fa-volume-up text-dim hover-white" style="font-size: 0.88rem; width: 18px; text-align: center;"></i>
                        </button>
                        <input type="range" id="playerVolumeSlider" class="seek-slider player-vol-slider" min="0" max="100" value="85" style="width: 75px;" title="Âm lượng" />
                    </div>

                    <!-- Jump to Detail Page (Desktop) -->
                    <button class="player-btn-ctrl d-none d-lg-inline-flex" onclick="navigateToCurrentTrackDetail(event)" title="Xem trang chi tiết bài hát">
                        <i class="fas fa-arrow-up-right-from-square" style="font-size: 0.85rem;"></i>
                    </button>

                    <!-- Nút Tải Đẹp Chuẩn Form Viên Thuốc Ruby Căng Mịn -->
                    <button id="playerDownloadBtn" class="player-download-pill-btn" onclick="if(window.TLongPlayer.currentTrack) handleDownload(window.TLongPlayer.currentTrack.id, window.TLongPlayer.currentTrack.title, window.TLongPlayer.currentTrack.tierRequired); else showToastNotification('Vui lòng chọn bài để tải!');" title="Tải bài hát này">
                        <i class="fas fa-cloud-arrow-down"></i>
                        <span class="d-none d-sm-inline">Tải Nhạc</span>
                        <span class="d-inline d-sm-none">Tải</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
         MODAL ĐĂNG NHẬP KÍNH PHA LÊ (LOGIN MODAL)
         ========================================== -->
    <div class="modal fade login-studio-modal" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="row g-0">
                    <!-- CỘT TRÁI: SHOWCASE STAGE VINYL DJ & EQUALIZER (Hiển thị trên màn hình >= lg) -->
                    <div class="col-lg-5 d-none d-lg-flex vinyl-stage">
                        <div class="text-center w-100 position-relative">
                            <!-- Live Online DJ Members Indicator -->
                            <div class="mb-3 d-flex justify-content-center">
                                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-40 px-3 py-1.5 rounded-pill font-monospace d-inline-flex align-items-center justify-content-center" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    <span class="live-dot-pulse me-1.5"></span> 1,200+ DJ & PRODUCER ONLINE
                                </span>
                            </div>

                            <!-- Vinyl Disc 3D Rotating with pulsating sound rings (Centered with fixed box) -->
                            <div class="vinyl-disc-container mx-auto" style="width: 170px; height: 170px; position: relative;">
                                <div class="sound-ring ring-1"></div>
                                <div class="sound-ring ring-2"></div>
                                <div class="vinyl-disc">
                                    <div class="vinyl-center-label">
                                        <div class="vinyl-center-hole"></div>
                                    </div>
                                </div>
                                <!-- Needle -->
                                <svg class="vinyl-needle" viewBox="0 0 50 70" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M45 5 L20 45 L15 65" stroke="#ffd166" stroke-width="3" stroke-linecap="round"/>
                                    <circle cx="45" cy="5" r="4" fill="#ff134a"/>
                                    <rect x="10" y="60" width="8" height="6" rx="2" fill="#fff"/>
                                </svg>
                            </div>

                            <h5 class="text-white fw-bold mb-1" style="letter-spacing: 1.5px;">TLONG<span class="text-danger">MUSIC</span></h5>
                            <div class="text-accent-premium font-monospace mb-2" style="font-size: 0.74rem;">RECORD POOL STUDIO • MASTER 24-BIT</div>

                            <!-- Equalizer Visualizer Waves -->
                            <div class="equalizer-wave justify-content-center">
                                <span class="equalizer-bar"></span>
                                <span class="equalizer-bar"></span>
                                <span class="equalizer-bar"></span>
                                <span class="equalizer-bar"></span>
                                <span class="equalizer-bar"></span>
                                <span class="equalizer-bar"></span>
                                <span class="equalizer-bar"></span>
                                <span class="equalizer-bar"></span>
                            </div>

                            <!-- 3 Perks with glowing badges -->
                            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-start w-100 px-2">
                                <div class="d-flex align-items-center gap-2.5 mb-2.5 text-light small">
                                    <div class="p-1 rounded-circle bg-danger bg-opacity-20 text-danger" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 0.72rem;">
                                        <i class="fas fa-compact-disc"></i>
                                    </div>
                                    <span>Track Nhóm MP3 320k & Lossless WAV</span>
                                </div>
                                <div class="d-flex align-items-center gap-2.5 mb-2.5 text-light small">
                                    <div class="p-1 rounded-circle bg-warning bg-opacity-20 text-warning" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 0.72rem;">
                                        <i class="fas fa-crown"></i>
                                    </div>
                                    <span>Track Slot VIP Master Bản Đặt Độc Quyền</span>
                                </div>
                                <div class="d-flex align-items-center gap-2.5 text-light small">
                                    <div class="p-1 rounded-circle bg-info bg-opacity-20 text-info" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 0.72rem;">
                                        <i class="fas fa-bolt"></i>
                                    </div>
                                    <span>Tải Tốc Độ Cao CDN Lossless 10Gbps</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CỘT PHẢI: FORM ĐĂNG NHẬP / ĐĂNG KÝ -->
                    <div class="col-12 col-lg-7 p-4 p-md-5 position-relative">
                        <!-- Nút đóng Modal -->
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

                        <!-- Header chuyển Tab Đăng Nhập & Đăng Ký -->
                        <div class="mb-4">
                            <ul class="nav nav-pills p-1 rounded-pill" id="authTabs" role="tablist" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                                <li class="nav-item flex-fill text-center" role="presentation">
                                    <button class="nav-link active w-100 fw-bold py-2 rounded-pill" id="tab-login-btn" data-bs-toggle="pill" data-bs-target="#tab-login-content" type="button" role="tab">
                                        <i class="fas fa-key me-1.5 text-danger"></i> Đăng Nhập
                                    </button>
                                </li>
                                <li class="nav-item flex-fill text-center" role="presentation">
                                    <button class="nav-link w-100 fw-bold py-2 rounded-pill text-white" id="tab-register-btn" data-bs-toggle="pill" data-bs-target="#tab-register-content" type="button" role="tab">
                                        <i class="fas fa-sparkles me-1.5 text-warning"></i> Đăng Ký Mới
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="tab-content" id="authTabContent">
                            <!-- TAB 1: ĐĂNG NHẬP -->
                            <div class="tab-pane fade show active" id="tab-login-content" role="tabpanel">
                                <form onsubmit="event.preventDefault(); handleLogin(document.getElementById('loginUsername').value, document.getElementById('loginPassword').value);">
                                    <!-- Alert lỗi đăng nhập sai -->
                                    <div id="loginErrorMessage" class="alert alert-danger py-2 px-3 small rounded-3 d-none mb-3 border-0 d-flex align-items-center gap-2" style="background: rgba(255, 19, 74, 0.2); color: #ff4d6d; border: 1px solid rgba(255, 19, 74, 0.4) !important;">
                                        <i class="fas fa-triangle-exclamation"></i>
                                        <span>Sai tài khoản hoặc mật khẩu</span>
                                    </div>

                                    <!-- Username -->
                                    <div class="mb-3">
                                        <label class="form-label text-dim small fw-bold mb-1 d-flex align-items-center gap-1.5">
                                            <i class="fas fa-user-circle text-info"></i> TÊN ĐĂNG NHẬP HOẶC EMAIL:
                                        </label>
                                        <div class="studio-input-group">
                                            <span class="input-group-text"><i class="fas fa-user-ninja"></i></span>
                                            <input type="text" id="loginUsername" class="form-control" placeholder="Nhập tên tài khoản hoặc email của bạn..." required autocomplete="username" />
                                        </div>
                                    </div>

                                    <!-- Password -->
                                    <div class="mb-3">
                                        <label class="form-label text-dim small fw-bold mb-1 d-flex align-items-center gap-1.5">
                                            <i class="fas fa-lock text-warning"></i> MẬT KHẨU BẢO MẬT:
                                        </label>
                                        <div class="studio-input-group">
                                            <span class="input-group-text"><i class="fas fa-shield-halved"></i></span>
